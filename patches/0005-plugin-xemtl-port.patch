-                                sysctlbyname("debug.nmxaccel_headless", &nx, &nn, NULL, 0) == 0 && nx == 0;
-      if (!strcmp(me, "WindowServer") && !xe_owns_panel && (nvmtl_vk_vendor() != 0x10de ||
-                                          (sysctlbyname("debug.nvaccel_headless", &hv, &hn, NULL, 0) == 0 && hv))) {
