-    if (!(opt && !strcmp(opt, "1")) && !nvmtl_angle_chrome_family()) return;
-    const char *key = "ANGLE_FEATURE_OVERRIDES_DISABLED", *rule = "disableMetalOnNvidia";
-    const char *cur = getenv(key);
-    if (cur && strstr(cur, rule)) return;
