+    NSError *e = nil;
+    id apple = ((id (*)(struct objc_super *, SEL, dispatch_data_t, NSError **))objc_msgSendSuper)(
+                   &sup, @selector(newLibraryWithData:error:), dd, &e);
+    if (!apple) {
+        nvlog("apple twin: super refused the %lu B container: %s", (unsigned long)raw.length,
