+    id<MTLLibrary> mine = [self newLibraryWithData:dd error:err];
+    nvlog("%s: Apple's %s (%lu B container) -> %s", what, object_getClassName(apple), (unsigned long)mtlb.length, mine ? "ours" : "FAILED to translate");
+    return mine;
+}
