 {
-	u_int old = vm_page_drop(m, 1);
+	u_int old;
 
+	/*
+	 * Shim X5 user pages drop their wiring and retire their run inside xg_vm_user_unwire(); they must never be
+	 * handed to vm_page_free() (that was the "freeing wired page ... (ref 0x1)" panic).
+	 */
+	if (xg_vm_user_unwire(m))
+		return (false);
+	old = vm_page_drop(m, 1);
 	if (VPRC_WIRE_COUNT(old) == 0)
-		panic("xegfx: vm: unwire of unwired page %p", m);
+		panic("xegfx: vm: unwire of unwired page %p (pa 0x%lx, ref 0x%x)", m, (u_long)m->phys_addr, old);
 	return (VPRC_WIRE_COUNT(old) == 1);
 }
 
@@ -904,10 +1061,13 @@
 void
 vm_page_unwire(vm_page_t m, uint8_t queue)
 {
-	u_int old = vm_page_drop(m, 1);
+	u_int old;
 
+	if (xg_vm_user_unwire(m))
+		return;
+	old = vm_page_drop(m, 1);
 	if (VPRC_WIRE_COUNT(old) == 0)
-		panic("xegfx: vm: unwire of unwired page %p", m);
+		panic("xegfx: vm: unwire of unwired page %p (pa 0x%lx, ref 0x%x)", m, (u_long)m->phys_addr, old);
 	if ((old & ~VPRC_BLOCKED) == 1)
 		vm_page_free(m);
 }
