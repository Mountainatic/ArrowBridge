+		if (atomic_fetchadd_int(&logs, 1) < 8)
+			printf("xegfx: vm: refusing to free user-held page %p (pa 0x%lx)\n", m,
+			    (u_long)m->phys_addr);
+		return;
+	}
 	m->flags &= ~PG_ZERO;
 	if (m->object != NULL) {
 		VM_OBJECT_ASSERT_WLOCKED(m->object);
@@ -893,10 +1043,17 @@
 bool
