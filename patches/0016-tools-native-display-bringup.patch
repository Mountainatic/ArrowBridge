+#!/bin/bash
+# install-m0.sh — 安装 M0 OpRegion/VBT 探针版 XeGfx.kext（core），并重建 AuxKC。
+# 用法（root）：sudo bash install-m0.sh [期望二进制 sha256 前缀]
+# 备份：脚本自动把 当前 core + 当前 AuxKC 存到 /Library/XeGfxTrial/core-<stamp>/
+# 回滚：tools/rollback-core.sh /Library/XeGfxTrial/core-<stamp>
+set -euo pipefail
+
+EXPECT_SHA_PREFIX="${1:-2b9f6b38}"
+SRC="${XEGFX_CORE_KEXT:?set XEGFX_CORE_KEXT to the XeGfx.kext build artifact}"
+INSTALLER="${XEGFX_CORE_INSTALLER:?set XEGFX_CORE_INSTALLER to install_core_044.py}"
+PROBE_SCRIPT="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/m0-probe.sh"
+
+[ "$(id -u)" = "0" ] || { echo "must run as root"; exit 1; }
+[ -d "$SRC" ] || { echo "missing build artifact: $SRC"; exit 1; }
+
+BIN_SHA=$(shasum -a 256 "$SRC/Contents/MacOS/XeGfx" | cut -c1-16)
+echo "== M0 probe core: $BIN_SHA ($(stat -f %z "$SRC/Contents/MacOS/XeGfx") B)"
+case "$BIN_SHA" in
+  "$EXPECT_SHA_PREFIX"*) : ;;
+  *) echo "STOP: binary sha $BIN_SHA does not start with expected $EXPECT_SHA_PREFIX"; exit 1 ;;
+esac
+
+echo "== installing via install_core_044.py"
+python3 "$INSTALLER"
+
+echo "== copying probe helper to /Library/XeGfxTrial/"
+mkdir -p /Library/XeGfxTrial
+cp -f "$PROBE_SCRIPT" /Library/XeGfxTrial/m0-probe.sh
+chmod 755 /Library/XeGfxTrial/m0-probe.sh
+chown root:wheel /Library/XeGfxTrial/m0-probe.sh
+
+LATEST=$(ls -dt /Library/XeGfxTrial/core-* | head -1)
+echo "== install done; backup: $LATEST"
+echo "== next: reboot, then run (osascript, admin): bash /Library/XeGfxTrial/m0-probe.sh"
