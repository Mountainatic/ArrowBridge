@@ -0,0 +1,30 @@
+"""The Metal plugin is an IOService personality property, not a bundle property."""
+PLUGIN = '../../../Library/GPUBundles/XeMTLDriver'
+PLUGIN_CLASS = 'XeMTLDevice'
+
+
+def personality(info):
+    matches = [p for p in info.get('IOKitPersonalities', {}).values()
+               if p.get('IOClass') == 'NMXAccel'
+               and p.get('CFBundleIdentifier') == 'org.watchthelight.XeGfxAccel']
+    if len(matches) != 1:
+        raise ValueError('expected exactly one XeGfx NMXAccel personality')
+    return matches[0]
+
+
+def validate(info):
+    p = personality(info)
+    if (p.get('MetalPluginName'), p.get('MetalPluginClassName')) != (PLUGIN, PLUGIN_CLASS):
+        raise ValueError('XeGfxAccel IOKitPersonalities: plugin must be XeMTLDriver / XeMTLDevice; '
+                         'top-level MetalPlugin fields do not configure the matched service')
+    return p
+
+
+def configure(info):
+    p = personality(info)
+    p['MetalPluginName'] = PLUGIN
+    p['MetalPluginClassName'] = PLUGIN_CLASS
+    info.pop('MetalPluginName', None)
+    info.pop('MetalPluginClassName', None)
+    validate(info)
+    return info
