+#!/usr/bin/env python3
+"""One preflight-gated WS restart per boot, with independent evidence collection."""
+import argparse
+import datetime
+import fcntl
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import time
+
+HERE = Path(__file__).resolve().parent
+TRIALS = Path('/Library/XeGfxTrial')
+TELEM = ['debug.xegfx_stage', 'debug.xegfxaccel_heads_published',
+         'debug.xegfxaccel_heads_registered', 'debug.xegfxaccel_heads_piped',
+         'debug.xegfxaccel_iop_ok', 'debug.xegfxaccel_iop_fail',
+         'debug.xegfxaccel_iop_flips', 'debug.xegfxaccel_iop_xe_flips', 'debug.xegfxaccel_iop_xe_flip_fail',
+         'debug.xegfxaccel_iop_xe_defer_signals', 'debug.xegfxaccel_pipe_perform',
+         'debug.xegfxaccel_vm_alloc']
+
+
+def command(args, timeout=30):
+    return subprocess.run([str(a) for a in args], capture_output=True, text=True, timeout=timeout)
+
+
+def value(key):
+    r = command(['/usr/sbin/sysctl', '-n', key])
+    if r.returncode: raise RuntimeError(r.stderr)
+    return r.stdout.strip()
+
+
+def pid():
+    r = command(['/usr/bin/pgrep', '-x', 'WindowServer'])
+    return r.stdout.split()
+
+
+def main(argv=None):
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--probe', required=True, type=Path)
+    p.add_argument('--out', required=True, type=Path)
+    args = p.parse_args(argv)
+    if os.geteuid() != 0: p.error('administrator authentication required')
+    out = args.out.resolve()
+    if out.parent != TRIALS or not out.name.startswith('ws-check-'):
+        p.error('--out must be /Library/XeGfxTrial/ws-check-*')
+    out.mkdir()
+    state = {'state': 'preflight', 'boot': value('kern.bootsessionuuid'),
+             'oldPID': pid(), 'started': datetime.datetime.now().isoformat()}
+
+    def save():
+        (out/'status.json').write_text(json.dumps(state, indent=2)+'\n')
+
+    stream = None
+    save()
+    with (TRIALS/'.ws-restart.lock').open('a') as lock:
+        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        try:
+            pre = command(['/usr/bin/python3', HERE/'xegfx-ws-preflight.py', '--metal-probe', args.probe], timeout=45)
+            (out/'preflight.txt').write_text(pre.stdout+pre.stderr)
+            if pre.returncode: raise RuntimeError('runtime Metal preflight failed; no WS restart requested')
+            if len(state['oldPID']) != 1: raise RuntimeError('expected one old WindowServer')
+            # Fail before the restart if a previous attempt exists for this boot.
+            marker = TRIALS/('ws-restart-'+state['boot']+'.attempt')
+            with marker.open('x') as f: f.write(str(out)+'\n')
+            before = command(['/usr/sbin/sysctl', *TELEM])
+            (out/'telemetry-before.txt').write_text(before.stdout+before.stderr)
+            startlog = datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')
+            with (out/'live-unified.log').open('w') as live:
+                stream = subprocess.Popen(['/usr/bin/log', 'stream', '--level', 'info', '--style', 'compact',
+                    '--predicate', '(process == "WindowServer") OR (process == "ReportCrash") OR '
+                    '(process == "kernel" AND (eventMessage CONTAINS "NMXAccel" OR eventMessage CONTAINS "XEGFX"))'],
+                    stdout=live, stderr=subprocess.STDOUT)
+                state['state'] = 'restart_requested'; save()
+                kick = command(['/bin/launchctl', 'kickstart', '-k', '-p', 'system/com.apple.WindowServer'])
+                (out/'kickstart.txt').write_text(kick.stdout+kick.stderr)
+                if kick.returncode: raise RuntimeError('kickstart failed')
+                began = time.monotonic()
+                new = None
+                while time.monotonic()-began < 150:
+                    time.sleep(3)
+                    current = pid()
+                    if value('kern.bootsessionuuid') != state['boot']: raise RuntimeError('boot changed')
+                    if len(current) > 1: raise RuntimeError('multiple WindowServer PIDs after restart')
+                    if current and current != state['oldPID']:
+                        if new and current != new: raise RuntimeError('new WindowServer PID replaced: crash loop suspected')
+                        new = current
+                        state['newPID'] = new
+                        state['state'] = 'observing'
+                    tel = command(['/usr/sbin/sysctl', *TELEM])
+                    with (out/'telemetry.log').open('a') as f:
+                        f.write('t=%.1f pids=%s console=%s\n' % (time.monotonic()-began, current,
+                            command(['/usr/bin/stat', '-f', '%Su', '/dev/console']).stdout.strip()))
+                        f.write(tel.stdout+tel.stderr)
+                    save()
+                if not new or pid() != new: raise RuntimeError('no stable new WindowServer')
+                state['state'] = 'stable_pid_desktop_unverified'; save()
+            diag = command(['/usr/bin/log', 'show', '--start', startlog, '--style', 'compact',
+                '--predicate', '(process == "ReportCrash" AND eventMessage CONTAINS "ASI") OR '
+                '(process == "launchd" AND eventMessage CONTAINS "WindowServer")'], timeout=45)
+            (out/'crash-diagnostics.txt').write_text(diag.stdout+diag.stderr)
+        except BaseException as exc:
+            state['state'] = 'failed'
+            state['reason'] = str(exc)
+            save()
+            raise
+        finally:
+            if stream:
+                stream.terminate()
+                try: stream.wait(timeout=5)
+                except subprocess.TimeoutExpired: stream.kill(); stream.wait()
+
+
+if __name__ == '__main__':
+    main()
