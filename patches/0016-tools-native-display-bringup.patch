+#!/usr/bin/env python3
+"""Read-only checks. A passing disk plist alone never authorizes a WS restart."""
+import argparse
+import json
+import os
+import plistlib
+from pathlib import Path
+import subprocess
+import sys
+from xegfx_metal_contract import PLUGIN, PLUGIN_CLASS, validate
+
+
+def run(args, **kwargs):
+    r = subprocess.run(args, capture_output=True, timeout=30, **kwargs)
+    if r.returncode:
+        raise RuntimeError('%s: %s' % (args[0], r.stderr.decode(errors='replace').strip()))
+    return r.stdout
+
+
+def walk(node):
+    if isinstance(node, list):
+        for item in node:
+            yield from walk(item)
+    elif isinstance(node, dict):
+        yield node
+        yield from walk(node.get('IORegistryEntryChildren', []))
+
+
+def check_live(nodes):
+    accels = [n for n in nodes if n.get('CFBundleIdentifier') == 'org.watchthelight.XeGfxAccel'
+              and n.get('IOClass') == 'NMXAccel']
+    if len(accels) != 1:
+        raise ValueError('expected one running XeGfx accelerator, got %d' % len(accels))
+    a = accels[0]
+    if (a.get('MetalPluginName'), a.get('MetalPluginClassName')) != (PLUGIN, PLUGIN_CLASS):
+        raise ValueError('running iGPU service still advertises %r / %r; disk-only changes are insufficient' %
+                         (a.get('MetalPluginName'), a.get('MetalPluginClassName')))
+    fbs = []
+    for n in nodes:
+        cls = n.get('IOObjectClass')
+        if cls not in ('XeGfxIntelFramebuffer', 'XeGfxFramebuffer'):
+            continue
+        state = n.get('IOServiceState')
+        if not isinstance(state, int):
+            raise ValueError('framebuffer IOServiceState missing; cannot establish registration')
+        # IOService.h: registered=0x2, inactive=0x1. A pull skeleton calls
+        # IOService::start, never IOFramebuffer::start/registerService.
+        if (cls == 'XeGfxFramebuffer' and state == 0
+                and n.get('XeGfxDisplayVersion') == '0.5-pull'
+                and n.get('XeGfxDisplayFail') is True
+                and n.get('XeGfxFbRegistered') is False
+                and n.get('XeGfxFbOpened') is False):
+            continue
+        if not state & 0x2 or state & 0x1:
+            raise ValueError('unexpected inactive or unregistered framebuffer outside verified pull skeleton')
+        fbs.append(n)
+    if len(fbs) != 1 or fbs[0].get('IOObjectClass') != 'XeGfxIntelFramebuffer':
+        raise ValueError('manual M2c requires exactly one IntelFB and no S2 adapter FB')
+    if fbs[0].get('XeGfxL0Ready') is not True:
+        raise ValueError('IntelFB start gate is not true')
+    return a['IORegistryEntryID']
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--disk-only', action='store_true')
+    p.add_argument('--metal-probe', type=Path)
+    args = p.parse_args()
+    info = plistlib.loads(Path('/Library/Extensions/XeGfxAccel.kext/Contents/Info.plist').read_bytes())
+    validate(info)
+    plugin = Path('/Library/GPUBundles/XeMTLDriver.bundle')
+    run(['/usr/bin/codesign', '--verify', '--strict', str(plugin)])
+    exe = plugin/'Contents/MacOS/XeMTLDriver'
+    if b'_OBJC_CLASS_$_XeMTLDevice' not in run(['/usr/bin/nm', '-gU', str(exe)]):
+        raise ValueError('installed XeMTLDriver does not export XeMTLDevice')
+    print('DISK_METAL_CONTRACT_PASS: matched personality = XeMTLDriver / XeMTLDevice')
+    if args.disk_only:
+        return
+    nodes = list(walk(plistlib.loads(run(['/usr/sbin/ioreg', '-a', '-l', '-p', 'IOService']))))
+    rid = check_live(nodes)
+    required = {'debug.xegfx_stage': 7, 'debug.xegfxaccelfb': 1,
+                'debug.xegfxaccel_heads_published': 16, 'debug.xegfxaccel_heads_registered': 16,
+                'debug.xegfxaccel_heads_piped': 16, 'debug.nmxaccel_headless': 0,
+                'debug.xegfxaccel_iop': 1}
+    for key, want in required.items():
+        got = int(run(['/usr/sbin/sysctl', '-n', key]).strip())
+        if got != want:
+            raise ValueError('%s=%d (expected %d)' % (key, got, want))
+    if not args.metal_probe:
+        raise ValueError('runtime preflight requires --metal-probe; counters alone do not prove Metal enumeration')
+    env = {k: v for k, v in os.environ.items() if k not in ('XEMTL_ENABLE', 'NVMTL_ENABLE')}
+    probe = json.loads(run([str(args.metal_probe.resolve())], env=env))
+    if not any(d.get('class') == 'XeMTLDevice' and d.get('registryID') == rid
+               for d in probe.get('devices', [])):
+        raise ValueError('WindowServer-named Metal probe did not enumerate XeMTLDevice for this iGPU: '+str(probe))
+    print('PRE_RESTART_PASS: live iGPU registryID=%#x and Metal probe agree; desktop validation remains required' % rid)
+
+
+if __name__ == '__main__':
+    try:
+        main()
+    except Exception as exc:
+        print('WS_PREFLIGHT_BLOCKED: '+str(exc), file=sys.stderr)
+        sys.exit(2)
