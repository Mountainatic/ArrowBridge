+#!/usr/bin/env python3
+"""Bound an IORegistry probe without waiting forever for an unkillable ioctl.
+
+Child output goes to a file, never the watchdog's command-substitution pipe.
+On timeout the watchdog can continue even if SIGKILL cannot interrupt a kernel
+wait. The caller must treat the marker as failure, not as an empty registry.
+"""
+import os
+from pathlib import Path
+import shutil
+import signal
+import subprocess
+import sys
+import tempfile
+import time
+
+
+def main(argv):
+    seconds = float(argv[0])
+    marker = Path(argv[1])
+    assert argv[2] == '--' and 0 < seconds <= 30
+    command = argv[3:]
+    with tempfile.TemporaryFile() as output:
+        child = subprocess.Popen(command, stdin=subprocess.DEVNULL,
+                                 stdout=output, stderr=subprocess.DEVNULL,
+                                 start_new_session=True, close_fds=True)
+        deadline = time.monotonic() + seconds
+        while child.poll() is None:
+            if time.monotonic() >= deadline:
+                marker.write_text('probe deadline exceeded: '+command[0]+'\n')
+                try: os.killpg(child.pid, signal.SIGKILL)
+                except ProcessLookupError: pass
+                # Do not communicate()/wait(): a wedged kernel call can ignore
+                # signals until it returns. No inherited pipe keeps us alive.
+                return 124
+            time.sleep(0.05)
+        output.seek(0)
+        shutil.copyfileobj(output, sys.stdout.buffer)
+        return child.returncode if child.returncode >= 0 else 128-child.returncode
+
+
+if __name__ == '__main__':
+    sys.exit(main(sys.argv[1:]))
