+#!/usr/bin/env python3
+"""Run the WS capture once in system launchd so logout cannot kill the collector."""
+import argparse
+import json
+import os
+from pathlib import Path
+import plistlib
+import subprocess
+
+TRIALS = Path('/Library/XeGfxTrial')
+
+
+def main(argv=None):
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--probe', required=True, type=Path)
+    p.add_argument('--out', required=True, type=Path)
+    args = p.parse_args(argv)
+    if os.geteuid() != 0: p.error('administrator authentication required')
+    out = args.out.resolve()
+    if out.parent != TRIALS or not out.name.startswith('ws-check-'):
+        p.error('--out must be /Library/XeGfxTrial/ws-check-*')
+    if out.exists(): p.error('capture directory already exists; do not retry this attempt')
+    probe = args.probe.resolve(strict=True)
+    job = out.with_name(out.name+'-job')
+    job.mkdir(mode=0o755)
+    label = 'com.xegfx.'+out.name
+    data = {'Label': label, 'ProgramArguments': ['/usr/bin/python3',
+                str(Path(__file__).with_name('m2c-restart-ws.py').resolve()),
+                '--probe', str(probe), '--out', str(out)],
+            'RunAtLoad': True, 'KeepAlive': False, 'LaunchOnlyOnce': True,
+            'StandardOutPath': str(job/'stdout.log'), 'StandardErrorPath': str(job/'stderr.log')}
+    path = job/'job.plist'
+    path.write_bytes(plistlib.dumps(data))
+    os.chmod(path, 0o644)
+    subprocess.run(['/bin/launchctl', 'bootstrap', 'system', str(path)], check=True)
+    print(json.dumps({'label': label, 'status': str(out/'status.json'),
+                      'jobPlist': str(path), 'keepAlive': False}))
+
+
+if __name__ == '__main__': main()
