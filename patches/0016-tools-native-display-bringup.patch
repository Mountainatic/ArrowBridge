+++ b/tools/m3db-preflight.sh
@@ -0,0 +1,208 @@
+#!/bin/bash
+#
+# m3db-preflight.sh -- M3d-b（首次 claim 冷启动接管）前的只读体检。
+#
+# 只读：不写 NVRAM、不装/卸 kext、不动 launchd、不重启、不重启 WindowServer。
+# 唯一写入是报告目录 data/m3db-preflight-<stamp>/（项目目录内，便于事后取证）。
+#
+#   sudo bash tools/m3db-preflight.sh          # 推荐 root：/Library/XeGfxTrial 仅管理员可读
+#   bash tools/m3db-preflight.sh               # 非 root 也能跑，个别项记为 SKIP
+#
+# 判定：BLOCK = 不满足就不能 arm；WARN = 可以继续但要知情；PASS/INFO 照常记录。
+# 退出码：0 = 无 BLOCK；1 = 至少一个 BLOCK；2 = 用法错误。
+#
+# 对应文档：docs/24-M3D-B-PLAN.md §3（前置条件）、docs/17 §D、docs/20-M4A2-BOOTGUARD.md。
+
+set -u
+PATH="/usr/bin:/bin:/usr/sbin:/sbin"
+
+SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
+PROJECT_DIR=$(dirname "$SCRIPT_DIR")
+STAMP=$(date +%Y%m%d-%H%M%S)
+OUT="$PROJECT_DIR/data/m3db-preflight-$STAMP"
+mkdir -p "$OUT" || { echo "cannot create $OUT" >&2; exit 2; }
+SUM="$OUT/summary.txt"
+
+NB=0 NW=0 NP=0
+say()   { echo "$*" | tee -a "$SUM"; }
+pass()  { NP=$((NP+1)); say "PASS   $*"; }
+warn()  { NW=$((NW+1)); say "WARN   $*"; }
+block() { NB=$((NB+1)); say "BLOCK  $*"; }
+info()  { say "INFO   $*"; }
+
+IS_ROOT=0; [ "$(id -u)" -eq 0 ] && IS_ROOT=1
+
+# ---------------------------------------------------------------- pins
+# 与本轮审计候选及 AuxKC UUID 校验后的装机 sha 对齐。
+# accel 同时校验本轮修复二进制 pin 与已验证的 Xe Metal personality。
+PIN_CORE=94278c72a95862552186432f528bc2ddd43a426ebc981a90027bc5f117d12f71
+# M3d-b: downstream controller, registration, import and present audit fixes.
+PIN_ADAPTER=b4e22af6584cbab93695f3c195653392fff68349e3f6457b57606fc6482e9e52
+PIN_AGDC=43dfb951dc551fc91b26d9e174d80288419481148d064920bf02c1802dc5530a
+PIN_INTELFB=4adce586aa112e6ab9bb9ab9592f632f68055266c17f6c2bb3db518ff7d6b30e
+
+u32() { # nvram key -> decimal, or "absent" / "bad:<raw>"
+    _raw=$(nvram "$1" 2>/dev/null | awk -F'\t' '{print $2}')
+    [ -z "$_raw" ] && { echo absent; return; }
+    _hex=$(printf '%s' "$_raw" | tr -d '%')
+    case "$_hex" in
+        [0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]) ;;
+        *) echo "bad:$_raw"; return ;;
+    esac
+    echo $(( 0x${_hex:0:2} + 0x${_hex:2:2}*256 + 0x${_hex:4:2}*65536 + 0x${_hex:6:2}*16777216 ))
+}
+
+say "== m3db-preflight $STAMP"
+say "host: $(sw_vers -productVersion 2>/dev/null) ($(sw_vers -buildVersion 2>/dev/null))  boot: $(sysctl -n kern.bootsessionuuid 2>/dev/null)"
+say "uptime: $(uptime)"
+say "root: $IS_ROOT"
+say ""
+
+# ---------------------------------------------------------------- 1. 硬件身份
+if ioreg -l -w0 -r -c IOPCIDevice 2>/dev/null | grep -q '"device-id" = <677d0000>'; then
+    pass "iGPU 8086:7D67 present"
+else
+    block "iGPU 8086:7D67 not found in IOPCIDevice (wrong machine or registry changed)"
+fi
+
+# ---------------------------------------------------------------- 2. 五件套装机 sha
+chk_sha() { # name pin
+    _f=/Library/Extensions/$1.kext/Contents/MacOS/$1
+    if [ ! -f "$_f" ]; then block "$1 not installed ($_f)"; return; fi
+    _s=$(shasum -a 256 "$_f" | awk '{print $1}')
+    if [ "$_s" = "$2" ]; then pass "$1 sha ${_s:0:12} matches pin"
+    else block "$1 sha ${_s:0:12} != pin ${2:0:12} (re-pin deliberately before arming)"; fi
+}
+chk_sha XeGfx        $PIN_CORE
+chk_sha XeGfxDisplay $PIN_ADAPTER
+chk_sha XeGfxAGDC    $PIN_AGDC
+_ifb=$(shasum -a 256 /Library/Extensions/XeGfxIntelFB.kext/Contents/MacOS/XeGfxIntelFB 2>/dev/null | awk '{print $1}')
+case "$_ifb" in
+    4adce586aa112e6ab9bb9ab9592f632f68055266c17f6c2bb3db518ff7d6b30e) pass "XeGfxIntelFB sha 4adce586 (16:15 build)";;
+    2a5b426779df9fb39bfc5989f5bf0f1835b37af9493a83ada37152f8c18b88aa) pass "XeGfxIntelFB sha 2a5b4267 (M3d-a pair: L0Ready + boot guard; ran the 18:29 desktop)";;
+    "") block "XeGfxIntelFB not installed";;
+    *) block "XeGfxIntelFB sha ${_ifb:0:12} is neither known build";;
+esac
+
+ACCEL_PL=/Library/Extensions/XeGfxAccel.kext/Contents/Info.plist
+if [ -f "$ACCEL_PL" ]; then
+    _cls=$(/usr/libexec/PlistBuddy -c 'Print :IOKitPersonalities:XeGfxAccel:MetalPluginClassName' "$ACCEL_PL" 2>/dev/null)
+    _name=$(/usr/libexec/PlistBuddy -c 'Print :IOKitPersonalities:XeGfxAccel:MetalPluginName' "$ACCEL_PL" 2>/dev/null)
+    info "accel personality MetalPluginClassName=$_cls MetalPluginName=$_name"
+    case "$_cls:$_name" in
+        XeMTLDevice:../../../Library/GPUBundles/XeMTLDriver) pass "accel nested personality uses XeMTLDevice (18:22 repair present)" ;;
+        *) block "accel nested personality is '$_cls' (expected XeMTLDevice; see docs/23)" ;;
+    esac
+    chk_sha XeGfxAccel c3d39f2c004454b9a3bf12ec8657a7289c819347178dcf06424f44009fc83ed6
+    shasum -a 256 /Library/Extensions/XeGfxAccel.kext/Contents/MacOS/XeGfxAccel >>"$OUT/accel-sha.txt" 2>&1
+    /usr/bin/python3 "$SCRIPT_DIR/xegfx-ws-preflight.py" --disk-only >"$OUT/metal-contract.txt" 2>&1 && pass "Metal plugin contract/signature verified" || block "Metal plugin contract/signature failed"
+else
+    block "XeGfxAccel not installed"
+fi
+
+# ---------------------------------------------------------------- 3. AuxKC 内容
+kmutil inspect -a x86_64 -A /Library/KernelCollections/AuxiliaryKernelExtensions.kc >"$OUT/auxkc-inspect.txt" 2>&1
+for id in org.watchthelight.XeGfx org.watchthelight.XeGfxDisplay org.watchthelight.XeGfxAccel \
+          org.watchthelight.XeGfxAGDC org.watchthelight.XeGfxIntelFB; do
+    if grep -q "$id[^A-Za-z]" "$OUT/auxkc-inspect.txt" 2>/dev/null || grep -q "$id\$" "$OUT/auxkc-inspect.txt" 2>/dev/null; then
+        pass "AuxKC contains $id"
+    else
+        if [ -s "$OUT/auxkc-inspect.txt" ]; then block "AuxKC missing $id (see auxkc-inspect.txt)"
+        else block "kmutil inspect produced no output; AuxKC content unverified"; break; fi
+    fi
+done
+shasum -a 256 /Library/KernelCollections/AuxiliaryKernelExtensions.kc >"$OUT/auxkc-sha.txt" 2>&1
+info "AuxKC $(cut -c1-16 "$OUT/auxkc-sha.txt")"
+
+# ---------------------------------------------------------------- 4. NVRAM 闸门
+nvram -p 2>/dev/null | grep -E 'xegfx|nullmoth|xeintelfb|boot-args|csr-active' >"$OUT/nvram.txt"
+P=$(u32 xegfx-disp-phase); T=$(u32 xegfx-disp-trial); F=$(u32 xegfx-disp-fail)
+S=$(u32 xegfx-disp-starts); E=$(u32 xegfx-disp-expose); BA=$(u32 xegfx-disp-bootarm)
+say "gates: phase=$P trial=$T fail=$F starts=$S expose=$E bootarm=$BA"
+case "$P" in 1|absent|0) pass "phase=$P (not armed yet)";; 2) warn "phase already 2 -- someone armed earlier; arm script will re-check";; *) block "phase=$P unknown encoding";; esac
+case "$T" in 0|absent) pass "trial=$T";; 1) warn "trial already 1 -- next reboot WILL claim";; *) block "trial=$T unknown encoding";; esac
+case "$E" in 1) pass "expose=1 (M3d serve path enabled)";; *) block "expose=$E -- claim without expose is a guaranteed black boot";; esac
+case "$BA" in 0|absent) pass "bootarm=$BA (M4a-1 daemon idle)";; *) block "bootarm=$BA -- M4a-1 auto bring-up must be off for M3d-b";; esac
+case "$S" in 0|absent) pass "starts=$S";; 1|2) warn "starts=$S -- arm script resets it to 0";; *) warn "starts=$S";; esac
+info "fail=$F (arm script writes 0; today's 1 is the manual-pull gate from docs/23)"
+grep -i nullmoth "$OUT/nvram.txt" >/dev/null 2>&1 && info "nullmoth keys present: $(grep -i nullmoth "$OUT/nvram.txt" | tr '\t\n' '= ')"
+# The NVIDIA guard intentionally stores one raw byte; display gates are u32.
+_nvs=$(/usr/sbin/nvram -x -p | /usr/bin/python3 -c 'import plistlib,sys; v=plistlib.loads(sys.stdin.buffer.read()).get("nullmoth-nv-starts"); print("absent" if v is None else int.from_bytes(v,"little") if isinstance(v,bytes) and len(v)==1 else "bad-guard-encoding")')
+case "$_nvs" in
+    absent|0|1) pass "nullmoth-nv-starts=$_nvs (accel start() not vetoed)";;
+    *) block "nullmoth-nv-starts=$_nvs -- nvrm_driver_off() would make XeGfxAccel refuse to start (docs/00 §7.2)";;
+esac
+_ba=$(nvram boot-args 2>/dev/null | cut -f2-)
+info "boot-args: ${_ba:-<none>}"
+
+# ---------------------------------------------------------------- 5. launchd 自启项
+ls -l /Library/LaunchDaemons 2>/dev/null | grep -iE 'xegfx|nullmoth|nvgfx' >"$OUT/launchdaemons.txt"
+info "LaunchDaemons: $(awk '{print $NF}' "$OUT/launchdaemons.txt" | tr '\n' ' ')"
+launchctl print-disabled system >"$OUT/launchctl-disabled.txt" 2>&1
+mkdir -p "$OUT/launchdaemons"
+is_disabled() { grep -q "\"$1\" => disabled\|\"$1\" => true" "$OUT/launchctl-disabled.txt"; }
+for f in /Library/LaunchDaemons/*.plist; do
+    [ -f "$f" ] || continue
+    b=$(basename "$f" .plist)
+    grep -qiE 'xegfx|m2c-|resume-bringup|debug\.xegfx' "$f" 2>/dev/null || case "$b" in com.xegfx.*) ;; *) continue;; esac
+    cp "$f" "$OUT/launchdaemons/" 2>/dev/null
+    case "$b" in
+        com.xegfx.m4a2bootguard) continue ;;
+        com.xegfx.bootarm|com.xegfx.resume)
+            if is_disabled "$b"; then pass "$b disabled"
+            else warn "$b enabled -- m3db-control.py stops and disables this managed job before arming"; fi ;;
+        *)
+            if is_disabled "$b"; then pass "$b installed but disabled"
+            elif launchctl print "system/$b" >/dev/null 2>&1; then
+                block "$b is loaded and enabled -- it may run bring-up during the claim boot (content copied to launchdaemons/)"
+            else
+                block "$b plist present and not disabled -- launchd loads it at next boot (content copied to launchdaemons/)"
+            fi ;;
+    esac
+done
+if [ -f /Library/LaunchDaemons/com.xegfx.m4a2bootguard.plist ]; then
+    info "bootguard already installed: $(shasum -a 256 /usr/local/xegfx/m4a2-bootguard.sh 2>/dev/null | cut -c1-16)"
+else
+    info "bootguard not installed yet (m3db-arm.sh installs it)"
+fi
+
+# ---------------------------------------------------------------- 6. 恢复通道
+if pgrep -x sshd >/dev/null 2>&1 || launchctl print system/com.openssh.sshd >/dev/null 2>&1; then
+    pass "Remote Login (sshd) available"
+else
+    warn "Remote Login is off -- turn it on in System Settings > General > Sharing before the trial"
+fi
+_ip=$(ipconfig getifaddr en0 2>/dev/null); [ -z "$_ip" ] && _ip=$(ipconfig getifaddr en1 2>/dev/null)
+info "LAN address now: ${_ip:-unknown} (write it down for the ssh fallback)"
+diskutil list >"$OUT/diskutil.txt" 2>&1
+if grep -q "Recovery" "$OUT/diskutil.txt"; then pass "APFS Recovery volume present"; else warn "no Recovery volume in diskutil list"; fi
+fdesetup status >"$OUT/filevault.txt" 2>&1
+info "FileVault: $(head -1 "$OUT/filevault.txt")"
+if [ "$IS_ROOT" = 1 ]; then
+    ls -dlt /Library/XeGfxTrial/* 2>/dev/null | head -20 >"$OUT/trial-dirs.txt"
+    info "latest trial dirs: $(head -3 "$OUT/trial-dirs.txt" | awk '{print $NF}' | tr '\n' ' ')"
+else
+    say "SKIP   /Library/XeGfxTrial listing (needs root)"
+fi
+
+# ---------------------------------------------------------------- 7. 当前 boot 的运行状态（参考）
+kmutil showloaded 2>/dev/null | grep -iE 'watchthelight|nullmoth' >"$OUT/loaded.txt"
+info "loaded: $(awk '{print $6}' "$OUT/loaded.txt" | tr '\n' ' ')"
+for c in XeGfxFBClaim XeGfxDisplayNub XeGfxFramebuffer XeGfxIntelFramebuffer; do
+    info "ioreg $c nodes: $(ioreg -r -c $c 2>/dev/null | grep -c "class $c")"
+done
+ioreg -l -w0 -r -c XeGfxDisplayNub >"$OUT/nub.txt" 2>&1
+sysctl debug.xegfx_stage debug.xegfx_boot debug.xegfx_timing debug.xegfx_kms_scanout 2>/dev/null >"$OUT/sysctl.txt"
+info "$(grep xegfx_timing "$OUT/sysctl.txt" | cut -c1-160)"
+system_profiler SPDisplaysDataType >"$OUT/displays.txt" 2>&1
+info "Metal: $(grep -m1 -E '^[[:space:]]+Metal( Support)?:' "$OUT/displays.txt" | sed 's/^ *//')"
+
+# ---------------------------------------------------------------- 8. 静态脚本
+bash -n "$SCRIPT_DIR/m4a2-bootguard.sh" 2>"$OUT/bootguard-syntax.txt" && pass "m4a2-bootguard.sh syntax ok" || block "m4a2-bootguard.sh syntax error"
+plutil -lint "$SCRIPT_DIR/com.xegfx.m4a2bootguard.plist" >/dev/null 2>&1 && pass "bootguard plist lint ok" || block "bootguard plist lint failed"
+/usr/bin/python3 -c 'import plistlib,sys; plistlib.load(open(sys.argv[1],"rb"))' "$SCRIPT_DIR/com.xegfx.m4a2bootguard.plist" 2>"$OUT/bootguard-plist-python.txt" && pass "bootguard plist strict XML parse ok" || block "bootguard plist strict XML parse failed"
+
+say ""
+say "== result: BLOCK=$NB WARN=$NW PASS=$NP"
+say "== report: $OUT"
+[ "$NB" -eq 0 ] && exit 0 || exit 1
