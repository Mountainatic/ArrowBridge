+#!/bin/bash
+# M3d-a only. Dry-run never invokes install-m3d.py (its dry flag is ineffective).
+# No privilege escalation, reboot, boot-args, bootarm daemon, or phase=2 path.
+set -euo pipefail
+HERE=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
+exec /usr/bin/python3 - "$HERE" "$0" "$@" <<'PY'
+import argparse
+import datetime
+import fcntl
+import hashlib
+import json
+import os
+from pathlib import Path
+import plistlib
+import shutil
+import signal
+import subprocess
+import sys
+import tempfile
+
+tools, script = Path(sys.argv[1]), Path(sys.argv[2]).resolve()
+sys.path.insert(0, str(tools))
+from xegfx_metal_contract import configure as configure_metal, validate as validate_metal
+project = tools.parent
+build = Path(os.environ["XEGFX_BUILD_ROOT"]).expanduser().resolve()
+core = Path(os.environ["XEGFX_CORE_KEXT"]).expanduser().resolve()
+names = dict(core='XeGfx', adapter='XeGfxDisplay', accel='XeGfxAccel', agdc='XeGfxAGDC')
+defaults = dict(core=core, adapter=project/'nvrmfb-adapter/kexts/XeGfxDisplay/out/XeGfxDisplay.kext',
+                accel=build/'XeGfxAccel/26/XeGfxAccel.kext', agdc=build/'XeGfxAGDC/XeGfxAGDC.kext')
+safe = dict(phase=1, trial=0, expose=1, starts=0, fail=0)
+gates = ['xegfx-disp-' + k for k in safe]
+trials = Path('/Library/XeGfxTrial')
+extensions = Path('/Library/Extensions')
+kc = Path('/Library/KernelCollections/AuxiliaryKernelExtensions.kc')
+
+def run(args):
+    r = subprocess.run([str(a) for a in args], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+    if r.returncode:
+        raise RuntimeError('%s: %s' % (args[0], r.stderr.decode(errors='replace').strip()))
+    return r.stdout
+
+def sha(path):
+    h = hashlib.sha256()
+    with path.open('rb') as f:
+        for block in iter(lambda: f.read(1024 * 1024), b''):
+            h.update(block)
+    return h.hexdigest()
+
+def load(path):
+    return plistlib.loads(path.read_bytes())
+
+def gate_number(value):
+    if value is None:
+        return None
+    if isinstance(value, bytes) and len(value) == 4:
+        return int.from_bytes(value, 'little')
+    if isinstance(value, bytes) and len(value) == 1:
+        return value[0]
+    if isinstance(value, (int, bool)):
+        return int(value)
+    if isinstance(value, str) and value in ('0', '1'):
+        return int(value)
+    raise RuntimeError('unrecognized phase/trial encoding; use the recovery runbook first')
+
+def require_safe_old_gates(values):
+    # Exact gate restoration must never re-arm takeover, including --rollback.
+    if gate_number(values.get('xegfx-disp-phase')) not in (None, 0, 1):
+        raise RuntimeError('old phase is unsafe; disarm via recovery before this runbook')
+    if gate_number(values.get('xegfx-disp-trial')) not in (None, 0):
+        raise RuntimeError('old trial is armed; disarm via recovery before this runbook')
+
+def rollback_hint(backup):
+    import shlex
+    print('BACKUP_DIR=' + str(backup), flush=True)
+    print('Rollback (root, no automatic reboot): bash %s --rollback %s' %
+          (shlex.quote(str(script)), shlex.quote(str(backup))), flush=True)
+    print('Black-screen recovery: ' + str(project/'bootfix/README-recovery-m3d.md'), flush=True)
+
+def restore(backup):
+    backup = backup.resolve()
+    if backup.parent != trials or not backup.name.startswith('m3d-runbook-'):
+        raise RuntimeError('rollback requires this wrapper\'s m3d-runbook backup directory')
+    manifest = json.loads((backup/'snapshot.json').read_text())
+    if manifest.get('format') != 'm3d-runbook-v1':
+        raise RuntimeError('not a complete wrapper snapshot')
+    old = load(backup/'gates-before.plist')
+    require_safe_old_gates(old)
+    if sha(backup/kc.name) != manifest['kcSHA256']:
+        raise RuntimeError('backup AuxKC hash mismatch')
+    for name in names.values():
+        if manifest['present'][name]:
+            for rel, digest in manifest['hashes'][name].items():
+                if sha(backup/(name+'.kext.original')/rel) != digest:
+                    raise RuntimeError('backup bundle hash mismatch: '+name+'/'+rel)
+    errors = []
+    # Prepare copies before replacing anything; backups remain reusable.
+    for name in names.values():
+        dest = extensions/(name+'.kext')
+        stage = extensions/(name+'.kext.m3d-restore')
+        try:
+            if stage.exists():
+                raise RuntimeError('stale recovery stage: '+str(stage))
+            if manifest['present'][name]:
+                run(['/usr/bin/ditto', backup/(name+'.kext.original'), stage])
+            if dest.exists():
+                shutil.rmtree(dest)
+            if manifest['present'][name]:
+                os.rename(stage, dest)
+            leftover = extensions/(name+'.kext.m3d-new')
+            if leftover.exists():
+                shutil.rmtree(leftover)
+        except Exception as exc:
+            errors.append(str(exc))
+    try:
+        fd, tmp = tempfile.mkstemp(prefix='.m3d-restore-', dir=str(kc.parent))
+        os.close(fd)
+        try:
+            shutil.copy2(backup/kc.name, tmp)
+            with open(tmp, 'rb') as f:
+                os.fsync(f.fileno())
+            os.replace(tmp, kc)
+        finally:
+            if os.path.exists(tmp):
+                os.unlink(tmp)
+    except Exception as exc:
+        errors.append(str(exc))
+    for gate in gates:
+        if gate not in old:
+            r = subprocess.run(['/usr/sbin/nvram', '-d', gate], capture_output=True)
+            # An already absent key is harmless; confirm through a fresh XML read below.
+    try:
+        run(['/usr/sbin/nvram', '-x', '-f', backup/'gates-before.plist'])
+        current = plistlib.loads(run(['/usr/sbin/nvram', '-x', '-p']))
+        if {k: current[k] for k in gates if k in current} != old:
+            raise RuntimeError('gate restoration readback mismatch')
+    except Exception as exc:
+        errors.append(str(exc))
+    if errors:
+        raise RuntimeError('rollback incomplete: '+'; '.join(errors))
+    print('ROLLBACK: disk bundles + AuxKC + original gates restored; running kernel unchanged.')
+
+def main():
+    p = argparse.ArgumentParser(description='M3d-a: four bundles; fixed phase=1/trial=0/expose=1/starts=0/fail=0')
+    for key in names:
+        p.add_argument('--'+key, type=Path, default=defaults[key])
+    mode = p.add_mutually_exclusive_group()
+    mode.add_argument('--dry-run', action='store_true', help='read artifact SHA/version/plist/markers only; no root needed')
+    mode.add_argument('--rollback', type=Path, metavar='BACKUP_DIR', help='restore this wrapper snapshot; requires root')
+    opts = p.parse_args(sys.argv[3:])
+    if opts.rollback:
+        if os.geteuid() != 0:
+            p.error('--rollback requires an already authorized root shell')
+        with (trials/'.m3d-runbook.lock').open('a') as lock:
+            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+            rollback_hint(opts.rollback)
+            restore(opts.rollback)
+        return
+    selected = {}
+    for key, name in names.items():
+        src = getattr(opts, key).resolve()
+        info = load(src/'Contents/Info.plist')
+        exe = src/'Contents/MacOS'/name
+        ident = 'org.watchthelight.'+name
+        if (info.get('CFBundleIdentifier') != ident or info.get('CFBundleExecutable') != name
+                or info.get('CFBundlePackageType') != 'KEXT' or not info.get('CFBundleVersion')):
+            raise RuntimeError(key+': invalid bundle identity/executable/version')
+        raw = exe.read_bytes()
+        markers = {
+            'core': [b'xegfx_boot', b'_sysctl__debug_xegfx_boot', b'xegfx-kms-kapi',
+                     b'XeGfxDisplayNub', b'XEGFX_KAPI_SCANOUT'],
+            'adapter': [b'XeGfxFBClaim', b'XeGfxS3Preflight', b'XeGfxFbRegistered',
+                        b'XeGfxFbOpened', b'XeGfxFbOpenDenied', b'xegfx-fb-claim-state', b'XeGfxDisplayInert'],
+            'accel': [b'XeGfxIntelFramebuffer', b'XeGfxFramebuffer', b'XeGfxFbModeReady'],
+            'agdc': [b'XeGfxFramebuffer'],
+        }[key]
+        missing = [s.decode() for s in markers if s not in raw]
+        if missing:
+            raise RuntimeError(key+': missing binary markers '+repr(missing))
+        personalities = info.get('IOKitPersonalities', {})
+        if key == 'accel':
+            # Validate the exact transformation even for --dry-run.
+            configure_metal(info)
+        if key == 'core':
+            resident = personalities.get('XeGfxResident', {})
+            if (resident.get('IOProviderClass'), resident.get('IOResourceMatch'), resident.get('IOMatchCategory')) != (
+                    'IOResources', 'XeGfxArm', 'XeGfxArmed'):
+                raise RuntimeError('core must remain IOResources / XeGfxArm / XeGfxArmed gated')
+            if len(personalities) != 1:
+                raise RuntimeError('unexpected extra core personality; review startup gating')
+        if key == 'adapter':
+            claim = personalities.get('XeGfxFBClaim', {})
+            expected = dict(IOClass='XeGfxFBClaim', IOProviderClass='IOPCIDevice',
+                            IOMatchCategory='IOFramebuffer', IOPCIMatch='0x7d678086',
+                            IONameMatch='display', IOProbeScore=20100)
+            if any(claim.get(k) != v for k, v in expected.items()):
+                raise RuntimeError('adapter claim personality mismatch')
+            fb = personalities.get('XeGfxFramebuffer', {})
+            if fb.get('IOClass') != 'XeGfxFramebuffer' or fb.get('IOProviderClass') != 'XeGfxDisplayNub':
+                raise RuntimeError('adapter framebuffer provider mismatch')
+        selected[key] = src
+        print(json.dumps(dict(component=key, path=str(src), identifier=ident,
+                              version=info['CFBundleVersion'], executableSHA256=sha(exe),
+                              plistSHA256=sha(src/'Contents/Info.plist'), markers='PASS'), ensure_ascii=False), flush=True)
+    print('GATES: phase=1 trial=0 expose=1 starts=0 fail=0 (fixed; no overrides)', flush=True)
+    print('ACCEL staged plist: MetalPluginClassName=XeMTLDevice; MetalPluginName=../../../Library/GPUBundles/XeMTLDriver', flush=True)
+    if opts.dry_run:
+        print('DRY-RUN PASS: no files created, no codesign, no installer/system commands executed.')
+        return
+    if os.geteuid() != 0:
+        p.error('installation requires an already authorized root shell; use --dry-run for preflight')
+    if not (extensions/'XeGfxIntelFB.kext').is_dir():
+        raise RuntimeError('fallback XeGfxIntelFB.kext must remain installed')
+    old_entries = run(['/usr/bin/kmutil', 'inspect', '-a', 'x86_64', '-A', kc]).decode()
+    if not any(line.split('\t', 1)[0] == 'org.watchthelight.XeGfxIntelFB'
+               for line in old_entries.splitlines()):
+        raise RuntimeError('fallback XeGfxIntelFB must also remain in the current AuxKC')
+    for name in names.values():
+        for suffix in ('.m3d-new', '.m3d-restore'):
+            if (extensions/(name+'.kext'+suffix)).exists():
+                raise RuntimeError('stale stage present; inspect/recover before retrying')
+    trials.mkdir(mode=0o755, exist_ok=True)
+    with (trials/'.m3d-runbook.lock').open('a') as lock:
+        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        old = plistlib.loads(run(['/usr/sbin/nvram', '-x', '-p']))
+        old = {k: old[k] for k in gates if k in old}
+        require_safe_old_gates(old)
+        stamp = datetime.datetime.now().strftime('%Y%m%d-%H%M%S')
+        backup = Path(tempfile.mkdtemp(prefix='m3d-runbook-'+stamp+'-', dir=str(trials)))
+        rollback_hint(backup)
+        # Outer snapshot covers partial rename/gate failures in the legacy installer.
+        shutil.copy2(kc, backup/kc.name)
+        (backup/'gates-before.plist').write_bytes(plistlib.dumps(old))
+        manifest = dict(format='m3d-runbook-v1', kcSHA256=sha(kc), present={}, hashes={})
+        for name in names.values():
+            dest = extensions/(name+'.kext')
+            manifest['present'][name] = dest.exists()
+            if dest.exists():
+                target = backup/(name+'.kext.original')
+                run(['/usr/bin/ditto', dest, target])
+                manifest['hashes'][name] = {str(f.relative_to(target)): sha(f)
+                                           for f in target.rglob('*') if f.is_file()}
+        (backup/'snapshot.json').write_text(json.dumps(manifest, indent=2)+'\n')
+        (backup/'sources.json').write_text(json.dumps({k: str(v) for k, v in selected.items()}, indent=2)+'\n')
+        try:
+            with tempfile.TemporaryDirectory(prefix='m3d-accel-') as tmp:
+                staged = Path(tmp)/'XeGfxAccel.kext'
+                run(['/usr/bin/ditto', selected['accel'], staged])
+                plist = staged/'Contents/Info.plist'
+                data = load(plist)
+                configure_metal(data)
+                plist.write_bytes(plistlib.dumps(data))
+                validate_metal(load(plist))
+                run(['/usr/bin/plutil', '-lint', plist])
+                args = ['/usr/bin/python3', str(tools/'install-m3d.py')]
+                for key, src in selected.items():
+                    args += ['--'+key, str(staged if key == 'accel' else src)]
+                for key, value in safe.items():
+                    args += ['--'+key, str(value)]
+                with (backup/'installer.log').open('w') as log:
+                    child = subprocess.Popen(args, stdout=log, stderr=subprocess.STDOUT,
+                                             start_new_session=True)
+                    try:
+                        rc = child.wait()
+                    except BaseException:
+                        # Stop installer AND its kmutil/codesign descendants before
+                        # restoring; no orphan may continue writing over recovery.
+                        try:
+                            os.killpg(child.pid, signal.SIGTERM)
+                        except ProcessLookupError:
+                            pass
+                        try:
+                            child.wait(timeout=10)
+                        except subprocess.TimeoutExpired:
+                            os.killpg(child.pid, signal.SIGKILL)
+                            child.wait()
+                        raise
+                print((backup/'installer.log').read_text(), flush=True)
+                if rc:
+                    raise RuntimeError('install-m3d.py exit '+str(rc))
+                current = plistlib.loads(run(['/usr/sbin/nvram', '-x', '-p']))
+                if any(current.get('xegfx-disp-'+k) != v.to_bytes(4, 'little') for k, v in safe.items()):
+                    raise RuntimeError('safe gates did not read back as canonical 4-byte LE data')
+        except BaseException:
+            print('INSTALL FAILED: applying outer snapshot rollback.', flush=True)
+            restore(backup)
+            raise
+        finally:
+            rollback_hint(backup)
+        print('INSTALLED_PENDING_MANUAL_REBOOT: disk only; verify after the planned reboot.')
+
+try:
+    main()
+except Exception as exc:
+    print('ERROR: '+str(exc), file=sys.stderr)
+    sys.exit(1)
+PY
