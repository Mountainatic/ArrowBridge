+import copy
+import importlib.util
+from pathlib import Path
+import unittest
+from xegfx_metal_contract import configure, validate, PLUGIN, PLUGIN_CLASS
+
+spec = importlib.util.spec_from_file_location('preflight', Path(__file__).with_name('xegfx-ws-preflight.py'))
+preflight = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(preflight)
+
+
+class MetalContractTest(unittest.TestCase):
+    def old(self):
+        return {'MetalPluginName': PLUGIN, 'MetalPluginClassName': PLUGIN_CLASS,
+                'IOKitPersonalities': {'XeGfxAccel': {'IOClass': 'NMXAccel',
+                    'CFBundleIdentifier': 'org.watchthelight.XeGfxAccel',
+                    'MetalPluginName': '../../../Library/GPUBundles/NVMTLDriver',
+                    'MetalPluginClassName': 'NVMTLDevice'}}}
+
+    def test_original_regression_is_rejected(self):
+        with self.assertRaises(ValueError): validate(self.old())
+
+    def test_nested_fix_is_idempotent(self):
+        fixed = configure(self.old())
+        self.assertEqual(validate(fixed)['MetalPluginName'], PLUGIN)
+        self.assertNotIn('MetalPluginName', fixed)
+        self.assertEqual(configure(copy.deepcopy(fixed)), fixed)
+
+    def test_missing_or_ambiguous_target_is_rejected(self):
+        for personalities in ({}, {'a': self.old()['IOKitPersonalities']['XeGfxAccel'],
+                                  'b': self.old()['IOKitPersonalities']['XeGfxAccel']}):
+            with self.assertRaises(ValueError): configure({'IOKitPersonalities': personalities})
+
+    def live(self):
+        return [dict(validate(configure(self.old())), IORegistryEntryID=123),
+                {'IOObjectClass': 'XeGfxIntelFramebuffer', 'XeGfxL0Ready': True, 'IOServiceState': 30}]
+
+    def test_live_single_ready_intelfb(self):
+        self.assertEqual(preflight.check_live(self.live()), 123)
+
+    def test_disk_fix_cannot_mask_old_live_personality(self):
+        nodes = self.live(); nodes[0]['MetalPluginClassName'] = 'NVMTLDevice'
+        with self.assertRaises(ValueError): preflight.check_live(nodes)
+
+    def test_inert_second_fb_or_false_start_gate_is_rejected(self):
+        nodes = self.live()+[{'IOObjectClass': 'XeGfxFramebuffer', 'IOServiceState': 30}]
+        with self.assertRaises(ValueError): preflight.check_live(nodes)
+
+    def test_verified_unregistered_pull_skeleton_is_not_an_enumerable_fb(self):
+        pull = {'IOObjectClass': 'XeGfxFramebuffer', 'IOServiceState': 0,
+                'XeGfxDisplayVersion': '0.5-pull', 'XeGfxDisplayFail': True,
+                'XeGfxFbRegistered': False, 'XeGfxFbOpened': False}
+        self.assertEqual(preflight.check_live(self.live()+[pull]), 123)
+        # A pull label cannot hide a registered FB, an opened FB or unknown state.
+        for key, value in [('IOServiceState', 30), ('XeGfxFbOpened', True),
+                           ('XeGfxFbRegistered', True), ('IOServiceState', None)]:
+            with self.assertRaises(ValueError):
+                preflight.check_live(self.live()+[dict(pull, **{key: value})])
+        nodes = self.live(); nodes[1]['XeGfxL0Ready'] = False
+        with self.assertRaises(ValueError): preflight.check_live(nodes)
+
+    def test_ioreg_dictionary_and_list_roots_are_supported(self):
+        root = {'IORegistryEntryChildren': self.live()}
+        self.assertEqual(list(preflight.walk(root)), list(preflight.walk([root])))
+
+
+if __name__ == '__main__': unittest.main()
