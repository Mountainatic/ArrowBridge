# 0016 tools: native display bring-up, install and boot-guard scripts (M0-M4a)
#
# Base:  none (new files under tools/)
# Files: tools/* (new)
# Apply: patch -p1 < patches/0016-tools-native-display-bringup.patch
#
# The scripts behind 0011-0015, in stage order: m0/m1a/m1b/m2c probes and bring-up, m3c baseline and gates,
# m3d install/verify and preflight, the m3db arm/disarm/health/control set, m4a1 boot-arm and the m4a2 boot guard
# (launchd plists included), the Metal contract probe, and build-xegfxdisplay.sh.  Absolute paths are replaced:
# repository-local tools resolve from their own location; external source/build trees use explicit XEGFX_* environment variables; AppleScript wrappers resolve sibling scripts from path to me
# home folder.  m3db-preflight.applescript is stored as UTF-8 (was UTF-16).
#
--- /dev/null
+++ b/tools/build-xegfxdisplay.sh
@@ -0,0 +1,79 @@
+#!/bin/bash
+#
+# build-xegfxdisplay.sh -- compile and link the M2b XeGfxDisplay.kext skeleton.
+#
+#   SDKROOT=/Library/Developer/CommandLineTools/SDKs/MacOSX15.4.sdk \
+#       tools/build-xegfxdisplay.sh
+#
+# Output:
+#   nvrmfb-adapter/kexts/XeGfxDisplay/out/XeGfxDisplay.kext
+#
+# The kext is x86_64 kernel code (same toolchain/flags as the XeGfxIntelFB
+# placeholder in src44/build/nvgfx/build_xegfxintelfb.sh).  Nothing is
+# installed, loaded or signed with a real identity: codesign is ad-hoc (-).
+#
+set -euo pipefail
+
+HERE=$(cd "$(dirname "$0")/.." && pwd)
+KEXT=${KEXTROOT:-$HERE/nvrmfb-adapter/kexts/XeGfxDisplay}
+SRC="$KEXT/src"
+PLIST="$KEXT/Info.plist"
+OUT="$KEXT/out"
+SDK=${SDKROOT:-/Library/Developer/CommandLineTools/SDKs/MacOSX15.4.sdk}
+K="$SDK/System/Library/Frameworks/Kernel.framework/Headers"
+BUNDLE="$OUT/XeGfxDisplay.kext"
+
+[ -d "$K" ]    || { echo "STOP: no Kernel.framework headers in $SDK" >&2; exit 1; }
+[ -d "$SRC" ]  || { echo "STOP: no sources in $SRC" >&2; exit 1; }
+[ -f "$PLIST" ] || { echo "STOP: no Info.plist at $PLIST" >&2; exit 1; }
+
+# Refuse to build if a future edit reintroduces the P0-1/P0-2 mistakes, so the
+# report cannot silently claim a fix that is not in the tree.
+if grep -nE 'bytesPerPlane\[|pixelFormat[[:space:]]*=[[:space:]]*kIO32ARGBPixelFormat' "$SRC"/*.cpp "$SRC"/*.h; then
+    echo "STOP: P0-1/P0-2 pattern found in src (see docs/05-ADAPTER-GAPS.md)" >&2
+    exit 1
+fi
+
+rm -rf "$BUNDLE"
+mkdir -p "$BUNDLE/Contents/MacOS" "$OUT/obj"
+
+FLAGS=(-arch x86_64 -mmacosx-version-min=15.0 -fapple-kext -mkernel -nostdinc
+       -isysroot "$SDK" -I"$K" -I"$SRC"
+       -DKERNEL -DKERNEL_PRIVATE -DDRIVER_PRIVATE -DAPPLE -DNeXT
+       -std=c++17 -fno-rtti -fno-exceptions -fno-builtin -fno-common
+       -O2 -g0 -Wall -Wno-unused-parameter -Wno-deprecated-declarations
+       -Wno-inconsistent-missing-override -Wno-unused-function -Wno-sign-conversion)
+
+OBJS=()
+shopt -s nullglob
+for src in "$SRC"/*.cpp; do
+    obj="$OUT/obj/$(basename "${src%.cpp}").o"
+    echo "== compile $(basename "$src")"
+    xcrun clang++ "${FLAGS[@]}" -c "$src" -o "$obj"
+    OBJS+=("$obj")
+done
+shopt -u nullglob
+
+[ "${#OBJS[@]}" -gt 0 ] || { echo "STOP: no .cpp files in $SRC" >&2; exit 1; }
+
+echo "== link XeGfxDisplay"
+xcrun clang++ -arch x86_64 -mmacosx-version-min=15.0 -fapple-kext -nostdlib \
+    -Wl,-kext -lkmodc++ -lkmod -lcc_kext \
+    "${OBJS[@]}" -o "$BUNDLE/Contents/MacOS/XeGfxDisplay"
+
+cp "$PLIST" "$BUNDLE/Contents/Info.plist"
+plutil -lint "$BUNDLE/Contents/Info.plist" >/dev/null
+
+# Ad-hoc signature only.  A real install (future, see docs/08) must re-sign with
+# the user's identity and rebuild the AuxKC; this script never does either.
+codesign -f -s - "$BUNDLE" >/dev/null 2>&1 || true
+
+BIN="$BUNDLE/Contents/MacOS/XeGfxDisplay"
+echo "== artifact"
+file "$BIN"
+echo "== undefined symbols (expected: IOKit/libkern only)"
+nm -u "$BIN" | sed 's/^/  /'
+echo "== size / sha256"
+stat -f 'binary bytes: %z' "$BIN"
+shasum -a 256 "$BIN" "$BUNDLE/Contents/Info.plist"
+echo "OK: $BUNDLE"
