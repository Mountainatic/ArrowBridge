+    had_kc = KC.is_file()
+    if had_kc:
+        if opts['missing_reference']:
+            die('--recover-missing-kc requires the live AuxKC to be absent')
+        old_entries = entries(KC)
+    else:
+        reference = opts['missing_reference']
+        if not reference or reference.resolve().parent.parent != TRIALS.resolve() or reference.name != 'status.json':
+            die('missing AuxKC requires --recover-missing-kc with a prior /Library/XeGfxTrial install status.json')
