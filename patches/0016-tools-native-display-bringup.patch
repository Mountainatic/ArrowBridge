+#!/bin/bash
+# rollback-core.sh — 从 /Library/XeGfxTrial/core-<stamp>/ 备份恢复 core kext + AuxKC。
+# 用法（root）：sudo bash rollback-core.sh <backup-dir> [--reboot]
+# backup-dir 由 install_core_044.py 生成，包含：
+#   XeGfx.kext.before/              ← 安装前的 core kext
+#   AuxiliaryKernelExtensions.kc    ← 安装前的 AuxKC
+set -euo pipefail
+
+BK="${1:?usage: rollback-core.sh <backup-dir> [--reboot]}"
+REBOOT="${2:-}"
+DEST=/Library/Extensions/XeGfx.kext
+KC=/Library/KernelCollections/AuxiliaryKernelExtensions.kc
+
+[ "$(id -u)" = "0" ] || { echo "must run as root"; exit 1; }
+[ -d "$BK/XeGfx.kext.before" ] || { echo "missing $BK/XeGfx.kext.before"; exit 1; }
+[ -f "$BK/AuxiliaryKernelExtensions.kc" ] || { echo "missing $BK/AuxiliaryKernelExtensions.kc"; exit 1; }
+
+echo "== restoring core kext from $BK"
+rm -rf "$DEST.rollback-new"
+/usr/bin/ditto "$BK/XeGfx.kext.before" "$DEST.rollback-new"
+/usr/sbin/chown -R root:wheel "$DEST.rollback-new"
+/bin/chmod -R 755 "$DEST.rollback-new"
+/usr/bin/codesign -f -s - --timestamp=none "$DEST.rollback-new"
+rm -rf "$DEST"
+mv "$DEST.rollback-new" "$DEST"
+
+echo "== restoring AuxKC"
+cp -f "$BK/AuxiliaryKernelExtensions.kc" "$KC"
+chown root:wheel "$KC"
+chmod 755 "$KC"
+
+echo "== verify"
+/usr/bin/kmutil inspect -a x86_64 -A "$KC" --show-kext-uuids 2>/dev/null | grep -E "XeGfx" || true
+shasum -a 256 "$DEST/Contents/MacOS/XeGfx" "$KC" | cut -c1-20
+echo "RESULT=restored (reboot required)"
+if [ "$REBOOT" = "--reboot" ]; then
+  echo "== rebooting"
+  /sbin/shutdown -r +1
+fi
