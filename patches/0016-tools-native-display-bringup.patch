+#!/usr/bin/env python3
+"""M3d-b first cold trial: transactional userspace deployment; no kext changes or reboot."""
+import argparse
+import datetime
+import fcntl
+import hashlib
+import json
+import os
+from pathlib import Path
+import plistlib
+import shutil
+import signal
+import subprocess
+import sys
+import tempfile
+import time
+from xegfx_metal_contract import validate as validate_metal
+
+HERE = Path(__file__).resolve().parent
+TRIALS = Path('/Library/XeGfxTrial')
+LIVE = Path('/usr/local/xegfx')
+DAEMON = Path('/Library/LaunchDaemons/com.xegfx.m4a2bootguard.plist')
+LABEL = 'com.xegfx.m4a2bootguard'
+MANAGED = ['com.xegfx.bootarm', 'com.xegfx.resume']
+SAFE = {'trial': 0, 'phase': 1, 'fail': 1, 'bootarm': 0}
+ARMED = {'expose': 1, 'starts': 0, 'fail': 0, 'phase': 2, 'trial': 1, 'bootarm': 0}
+FILES = {LIVE/name: HERE/name for name in ('m4a2-bootguard.sh', 'm3db-health.py', 'm3db-bounded-probe.py', 'm3db-ws-report.py')}
+
+
+def run(args, check=True):
+    r = subprocess.run([str(x) for x in args], capture_output=True, timeout=90)
+    if check and r.returncode:
+        raise RuntimeError('%s: %s' % (args[0], r.stderr.decode(errors='replace').strip()))
+    return r
+
+
+def sha(path): return hashlib.sha256(path.read_bytes()).hexdigest()
+def nv(): return plistlib.loads(run(['/usr/sbin/nvram', '-x', '-p']).stdout)
+def boot(): return run(['/usr/sbin/sysctl', '-n', 'kern.bootsessionuuid']).stdout.decode().strip()
+def loaded(label): return run(['/bin/launchctl', 'print', 'system/'+label], check=False).returncode == 0
+
+
+def stop(label):
+    if loaded(label): run(['/bin/launchctl', 'bootout', 'system/'+label])
+    if loaded(label): raise RuntimeError('launchd job did not stop: '+label)
+
+
+def write_gate(key, value):
+    data = value.to_bytes(4, 'little')
+    raw = ''.join('%%%02x' % x for x in data)
+    run(['/usr/sbin/nvram', 'xegfx-disp-'+key+'='+raw])
+    if nv().get('xegfx-disp-'+key) != data: raise RuntimeError('gate readback mismatch: '+key)
+
+
+def safe_gates():
+    errors = []
+    for key, value in SAFE.items():
+        try: write_gate(key, value)
+        except Exception as exc: errors.append(str(exc))
+    if errors: raise RuntimeError('safe gates incomplete: '+'; '.join(errors))
+
+
+def atomic_file(dest, data, mode):
+    dest.parent.mkdir(parents=True, exist_ok=True)
+    fd, tmp = tempfile.mkstemp(prefix='.m3db-', dir=dest.parent)
+    try:
+        with os.fdopen(fd, 'wb') as f:
+            f.write(data); f.flush(); os.fsync(f.fileno())
+        os.chmod(tmp, mode)
+        os.chown(tmp, 0, 0)
+        os.replace(tmp, dest)
+    finally:
+        if os.path.exists(tmp): os.unlink(tmp)
+
+
+def baseline():
+    # The outer shell preflight validates all five binaries and AuxKC. Never
+    # permit --skip-preflight to bypass it.
+    r = run(['/bin/bash', HERE/'m3db-preflight.sh'], check=False)
+    print(r.stdout.decode(errors='replace'), flush=True)
+    if r.returncode: raise RuntimeError('preflight has BLOCK items; no system change')
+    v = nv()
+    for key, want in dict(SAFE, expose=1, starts=0).items():
+        if v.get('xegfx-disp-'+key) != want.to_bytes(4, 'little'):
+            raise RuntimeError('requires current manual baseline gate '+key+'='+str(want))
+    validate_metal(plistlib.loads(Path('/Library/Extensions/XeGfxAccel.kext/Contents/Info.plist').read_bytes()))
+    allow = Path('/Library/GPUBundles/xemtl-allow.txt')
+    rules = [x.strip() for x in allow.read_text().splitlines() if x.strip() and not x.lstrip().startswith('#')]
+    if rules != ['!WindowServer']: raise RuntimeError('expected the verified armed-only WS allow rule')
+    return v
+
+
+def arm(apply, recovery):
+    original = baseline()
+    current = boot()
+    payload = plistlib.loads((HERE/'com.xegfx.m4a2bootguard.plist').read_bytes())
+    payload.setdefault('EnvironmentVariables', {}).update(M4A2_RETRY_ONCE='0',
+        M4A2_ARMED_FROM_BOOT=current, M4A2_DISARM_ON_SUCCESS='1', M4A2_HEALTH_CHECK=str(LIVE/'m3db-health.py'))
+    for path in FILES.values():
+        if not path.is_file(): raise RuntimeError('missing deployment source '+str(path))
+    run(['/bin/bash', '-n', HERE/'m4a2-bootguard.sh'])
+    print(json.dumps({'plan': 'first cold claim trial', 'kextsChanged': False, 'reboot': False,
+        'managedDaemonsDisabled': MANAGED, 'armedFromBoot': current, 'futureGates': ARMED,
+        'retryOnce': False, 'disarmOnSuccess': True}, indent=2), flush=True)
+    if not apply: return
+    if not recovery: raise RuntimeError('--recovery-confirmed required; record the available Recovery keyboard route')
+    if os.geteuid() != 0: raise RuntimeError('--apply requires administrator authentication')
+    with (TRIALS/'.m3d-runbook.lock').open('a') as lock:
+        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        if nv() != original: raise RuntimeError('NVRAM changed during preflight; re-run instead of overwriting')
+        backup = Path(tempfile.mkdtemp(prefix='m3db-arm-'+datetime.datetime.now().strftime('%Y%m%d-%H%M%S')+'-', dir=TRIALS))
+        before = run(['/bin/launchctl', 'print-disabled', 'system']).stdout
+        (backup/'nvram-before.plist').write_bytes(plistlib.dumps(original))
+        (backup/'launchctl-disabled-before.txt').write_bytes(before)
+        paths = list(FILES)+[DAEMON]
+        manifest = {'state': 'snapshot', 'boot': current, 'files': {}, 'jobs': {}, 'hashes': {}}
+        for i, path in enumerate(paths):
+            entry = {'exists': path.exists(), 'copy': str(i)}
+            if path.exists():
+                shutil.copy2(path, backup/str(i)); entry['mode'] = path.stat().st_mode & 0o777
+                manifest['hashes'][str(i)] = sha(backup/str(i))
+            manifest['files'][str(path)] = entry
+        for label in MANAGED+[LABEL]:
+            manifest['jobs'][label] = {'loaded': loaded(label),
+                'disabled': ('"'+label+'" => disabled').encode() in before or ('"'+label+'" => true').encode() in before}
+        (backup/'transaction.json').write_text(json.dumps(manifest, indent=2)+'\n')
+        print('BACKUP='+str(backup), flush=True)
+        try:
+            # Stop conflicting userspace writers before touching activation gates.
+            for label in MANAGED+[LABEL]: stop(label)
+            for label in MANAGED: run(['/bin/launchctl', 'disable', 'system/'+label])
+            safe_gates()
+            ticket = TRIALS/'.m4a2-boot-ticket'
+            if ticket.exists(): os.rename(ticket, backup/'stale-boot-ticket')
+            for dest, source in FILES.items(): atomic_file(dest, source.read_bytes(), 0o755)
+            ack = backup/'pending-reboot.ack'
+            payload['EnvironmentVariables']['M4A2_PENDING_ACK'] = str(ack)
+            atomic_file(DAEMON, plistlib.dumps(payload), 0o644)
+            run(['/usr/bin/plutil', '-lint', DAEMON])
+            run(['/bin/launchctl', 'enable', 'system/'+LABEL])
+            run(['/bin/launchctl', 'bootstrap', 'system', DAEMON])
+            # Its current-boot invocation must finish as pending-reboot. It must
+            # never inspect live gates as if this were an already claimed boot.
+            deadline = time.monotonic()+15
+            while True:
+                if ack.exists() and ack.read_text().strip() == current: break
+                if time.monotonic() > deadline: raise RuntimeError('bootguard did not exit pending-reboot')
+                time.sleep(0.25)
+            for dest, source in FILES.items():
+                if sha(dest) != sha(source): raise RuntimeError('deployed script mismatch')
+            # Activation commit; trial is always the last write.
+            for key in ('expose', 'starts', 'fail', 'phase', 'trial'): write_gate(key, ARMED[key])
+            after = nv()
+            for key, want in ARMED.items():
+                if after.get('xegfx-disp-'+key) != want.to_bytes(4, 'little'): raise RuntimeError('final gate mismatch')
+            (backup/'nvram-after.plist').write_bytes(plistlib.dumps(after))
+            manifest['state'] = 'armed_pending_manual_cold_boot'
+        except BaseException as exc:
+            errors = []
+            for operation in (lambda: stop(LABEL), safe_gates):
+                try: operation()
+                except Exception as repair: errors.append(str(repair))
+            for path, entry in manifest['files'].items():
+                try:
+                    if entry['exists']: atomic_file(Path(path), (backup/entry['copy']).read_bytes(), entry['mode'])
+                    else: Path(path).unlink(missing_ok=True)
+                except Exception as repair: errors.append(str(repair))
+            for label, entry in manifest['jobs'].items():
+                try:
+                    run(['/bin/launchctl', 'disable' if entry['disabled'] else 'enable', 'system/'+label])
+                    plist = Path('/Library/LaunchDaemons')/(label+'.plist')
+                    if entry['loaded'] and plist.exists() and not loaded(label):
+                        run(['/bin/launchctl', 'bootstrap', 'system', plist])
+                except Exception as repair: errors.append(str(repair))
+            manifest.update(state='failed_safe' if not errors else 'rollback_incomplete', reason=str(exc), rollbackErrors=errors)
+            raise
+        finally:
+            (backup/'transaction.json').write_text(json.dumps(manifest, indent=2)+'\n')
+        print('ARMED_PENDING_MANUAL_COLD_BOOT: no kext/KC change, no WS restart, no automatic shutdown')
+
+
+def disarm(keep):
+    if os.geteuid() != 0: raise RuntimeError('disarm requires administrator authentication')
+    with (TRIALS/'.m3d-runbook.lock').open('a') as lock:
+        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        stop(LABEL)
+        safe_gates()
+        if not keep:
+            run(['/bin/launchctl', 'disable', 'system/'+LABEL])
+            if DAEMON.exists():
+                room = Path(tempfile.mkdtemp(prefix='m3db-disarmed-', dir=TRIALS))
+                os.rename(DAEMON, room/DAEMON.name)
+        print('DISARMED_VERIFIED: phase=1 trial=0 fail=1 bootarm=0; current kernel ownership changes only after reboot')
+
+
+def main():
+    def interrupted(signum, frame): raise InterruptedError('transaction interrupted by signal '+str(signum))
+    signal.signal(signal.SIGTERM, interrupted)
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument('action', choices=['arm', 'disarm'])
+    p.add_argument('--apply', action='store_true')
+    p.add_argument('--recovery-confirmed', action='store_true')
+    p.add_argument('--keep-daemon', action='store_true')
+    args = p.parse_args()
+    if args.action == 'arm': arm(args.apply, args.recovery_confirmed)
+    elif args.apply: disarm(args.keep_daemon)
+    else: print('DRY_RUN: stop bootguard, verify safe gates, optionally archive daemon; no system mutation')
+
+
+if __name__ == '__main__':
+    try: main()
+    except Exception as exc:
+        print('M3DB_FAILED: '+str(exc), file=sys.stderr); sys.exit(1)
