+#!/usr/bin/env python3
+"""Transactional multi-kext installer for M3d (core + adapter + accel + AGDC).
+
+One transaction, one AuxKC rebuild:
+  * stage → ad-hoc sign → verify each requested kext bundle
+  * swap into /Library/Extensions (previous bundles preserved in the backup dir)
+  * rebuild the auxiliary kernel collection with the canonical `kmutil create` line
+  * validate the candidate entry set (identifiers/versions, no unrelated drift)
+  * replace the live AuxKC, fsync
+  * write the NVRAM display gates (canonical 4-byte little-endian values)
+Any failure restores the old AuxKC, the old bundles and the old gate values.
+
+Run as root (the Lead wraps it in osascript administrator privileges).
+"""
+import datetime
+import json
+import os
+import pathlib
+import plistlib
+import re
+import shutil
+import subprocess
+import sys
+from xegfx_metal_contract import validate as validate_metal
