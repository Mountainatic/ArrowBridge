+#!/usr/bin/env python3
+"""Repair only the installed accel personality and rebuild AuxKC; never restart WS/reboot or write NVRAM."""
+import argparse
+import datetime
+import fcntl
+import hashlib
+import json
+import os
+from pathlib import Path
+import plistlib
+import shutil
+import signal
+import subprocess
+import sys
+import tempfile
+from xegfx_metal_contract import configure, validate
+
+HERE = Path(__file__).resolve().parent
+DEST = Path('/Library/Extensions/XeGfxAccel.kext')
+KC = Path('/Library/KernelCollections/AuxiliaryKernelExtensions.kc')
+TRIALS = Path('/Library/XeGfxTrial')
+
+
+def run(args):
+    r = subprocess.run([str(a) for a in args], capture_output=True)
+    if r.returncode:
+        raise RuntimeError(r.stderr.decode(errors='replace') or r.stdout.decode(errors='replace'))
+    return r.stdout
+
+
+def sha(p):
+    return hashlib.sha256(p.read_bytes()).hexdigest()
+
+
+def restore(backup):
+    manifest = json.loads((backup/'repair.json').read_text())
+    original = backup/'XeGfxAccel.kext'
+    for rel, digest in manifest['bundleSHA256'].items():
+        if sha(original/rel) != digest:
+            raise RuntimeError('backup hash mismatch: '+rel)
+    if sha(backup/KC.name) != manifest['kcSHA256']:
+        raise RuntimeError('backup KC hash mismatch')
+    stage = DEST.with_name('XeGfxAccel.kext.metal-restore')
+    if stage.exists():
+        raise RuntimeError('stale repair restore stage: '+str(stage))
+    run(['/usr/bin/ditto', original, stage])
+    # KC stays intact until a full bundle copy is ready.
+    if DEST.exists():
+        shutil.rmtree(DEST)
+    os.rename(stage, DEST)
+    fd, tmp = tempfile.mkstemp(prefix='.metal-restore-', dir=KC.parent)
+    os.close(fd)
+    try:
+        shutil.copy2(backup/KC.name, tmp)
+        with open(tmp, 'rb') as f:
+            os.fsync(f.fileno())
+        os.replace(tmp, KC)
+    finally:
+        if os.path.exists(tmp): os.unlink(tmp)
+    print('RESTORED_DISK_ONLY: reboot required to change loaded state')
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__)
+    mode = p.add_mutually_exclusive_group()
+    mode.add_argument('--apply', action='store_true')
+    mode.add_argument('--rollback', type=Path)
+    opts = p.parse_args()
+    if opts.rollback:
+        backup = opts.rollback.resolve()
+        if backup.parent != TRIALS or not backup.name.startswith('metal-repair-'):
+            p.error('rollback accepts only /Library/XeGfxTrial/metal-repair-* snapshots')
+        if os.geteuid() != 0: p.error('rollback requires administrator authentication')
+        with (TRIALS/'.m3d-runbook.lock').open('a') as lock:
+            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+            restore(backup)
+        return
+    info = plistlib.loads((DEST/'Contents/Info.plist').read_bytes())
+    configure(info)
+    print('REPAIR_PLAN: IOKitPersonalities/XeGfxAccel -> XeMTLDriver / XeMTLDevice; remove misplaced top-level keys')
+    print('Only XeGfxAccel plist/signature + AuxKC change. All NVRAM gates and other kexts are preserved.')
+    run(['/usr/bin/codesign', '--verify', '--strict', '/Library/GPUBundles/XeMTLDriver.bundle'])
+    if not opts.apply:
+        print('DRY_RUN_PASS: no system files changed')
+        return
+    if os.geteuid() != 0: p.error('--apply requires administrator authentication')
+    loaded = run(['/usr/bin/kmutil', 'showloaded']).decode()
+    if 'org.watchthelight.XeGfxAccel (' in loaded or 'org.watchthelight.XeGfx (' in loaded:
+        raise RuntimeError('repair requires cold safe boot before manual core/accel bring-up')
+    gates = run(['/usr/sbin/nvram', '-x', '-p'])
+    nv = plistlib.loads(gates)
+    for key, want in [('phase', 1), ('trial', 0), ('bootarm', 0), ('fail', 1)]:
+        v = nv.get('xegfx-disp-'+key)
+        if not isinstance(v, bytes) or len(v) not in (1, 4) or int.from_bytes(v, 'little') != want:
+            raise RuntimeError('requires xegfx-disp-%s=%d in this manual-pull repair' % (key, want))
+    with (TRIALS/'.m3d-runbook.lock').open('a') as lock:
+        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        backup = Path(tempfile.mkdtemp(prefix='metal-repair-'+datetime.datetime.now().strftime('%Y%m%d-%H%M%S')+'-', dir=TRIALS))
+        run(['/usr/bin/ditto', DEST, backup/'XeGfxAccel.kext'])
+        shutil.copy2(KC, backup/KC.name)
+        original = backup/'XeGfxAccel.kext'
+        manifest = {'kcSHA256': sha(KC), 'bundleSHA256': {
+            str(f.relative_to(original)): sha(f) for f in original.rglob('*') if f.is_file()}}
+        (backup/'repair.json').write_text(json.dumps(manifest, indent=2)+'\n')
+        (backup/'nvram-before.plist').write_bytes(gates)
+        print('BACKUP='+str(backup), flush=True)
+        try:
+            with tempfile.TemporaryDirectory(prefix='metal-staged-', dir=backup) as tmp:
+                staged = Path(tmp)/'XeGfxAccel.kext'
+                run(['/usr/bin/ditto', DEST, staged])
+                (staged/'Contents/Info.plist').write_bytes(plistlib.dumps(info))
+                with (backup/'install.log').open('wb') as log:
+                    child = subprocess.Popen(['/usr/bin/python3', str(HERE/'install-m3d.py'), '--accel', str(staged), '--no-gates'],
+                                             stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
+                    try:
+                        rc = child.wait()
+                    except BaseException:
+                        try: os.killpg(child.pid, signal.SIGTERM)
+                        except ProcessLookupError: pass
+                        try: child.wait(timeout=10)
+                        except subprocess.TimeoutExpired:
+                            os.killpg(child.pid, signal.SIGKILL)
+                            child.wait()
+                        raise
+                    if rc:
+                        raise RuntimeError('installer failed; see '+str(backup/'install.log'))
+            validate(plistlib.loads((DEST/'Contents/Info.plist').read_bytes()))
+            # --no-gates must really preserve all relevant display gates.
+            after = plistlib.loads(run(['/usr/sbin/nvram', '-x', '-p']))
+            relevant = lambda d: {k: v for k, v in d.items() if k.startswith('xegfx-disp-')}
+            if relevant(nv) != relevant(after):
+                raise RuntimeError('unexpected display gate change')
+            manifest['state'] = 'installed_pending_manual_reboot'
+            manifest['installedPlistSHA256'] = sha(DEST/'Contents/Info.plist')
+            manifest['installedKCSHA256'] = sha(KC)
+            (backup/'repair.json').write_text(json.dumps(manifest, indent=2)+'\n')
+        except BaseException:
+            restore(backup)
+            raise
+        print('INSTALLED_PENDING_MANUAL_REBOOT: no WS restart, explicit kext load/unload, or reboot was requested')
+        print('ROLLBACK: /usr/bin/python3 '+str(HERE/'repair-m3d-metal.py')+' --rollback '+str(backup))
+
+
+if __name__ == '__main__':
+    try:
+        main()
+    except Exception as exc:
+        print('REPAIR_FAILED: '+str(exc), file=sys.stderr)
+        sys.exit(1)
