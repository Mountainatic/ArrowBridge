+    candidate = backup / "AuxiliaryKernelExtensions.m3s2.kc"
+    log = (backup / "install.log").open("w")
+    state = {"state": "preparing", "backup": str(backup),
+             "sourceCore": str(SRC_CORE), "sourceCoreSHA256": sha(SRC_CORE / "Contents/MacOS/XeGfx"),
+             "sourceAdapter": str(SRC_DISP), "sourceAdapterSHA256": sha(SRC_DISP / "Contents/MacOS/XeGfxDisplay"),
+             "oldKCSHA256": sha(KC), "oldBootArgs": old_bootargs, "withCore": with_core,
+             "newCoreVersion": src_core_info.get("CFBundleVersion"),
+             "newAdapterVersion": src_disp_info.get("CFBundleVersion")}
+    (backup / "status.json").write_text(json.dumps(state, indent=2) + "\n")
+
+    stages = {}
+    swapped = False
+    gates_changed = False
+    try:
+        # stage the adapter bundle (and the core bundle with --with-core)
+        stage_list = [] if with_core else [(DEST_DISP, SRC_DISP)]
+        if with_core:
+            stage_list = [(DEST_CORE, SRC_CORE), (DEST_DISP, SRC_DISP)]
+        for dest, src in stage_list:
+            stage = dest.with_name(dest.name + ".m2c-new")
+            if stage.exists():
+                shutil.rmtree(stage)
+            run(["/usr/bin/ditto", str(src), str(stage)], log)
+            run(["/usr/sbin/chown", "-R", "root:wheel", str(stage)], log)
+            run(["/bin/chmod", "-R", "755", str(stage)], log)
+            run(["/usr/bin/codesign", "-f", "-s", "-", "--timestamp=none", str(stage)], log)
+            run(["/usr/bin/codesign", "--verify", "--strict", str(stage)], log)
+            stages[dest] = stage
+        # swap into place
+        if with_core:
+            if DEST_CORE.exists():
+                os.rename(DEST_CORE, backup / "XeGfx.kext.original")
+            os.rename(stages[DEST_CORE], DEST_CORE)
+        if DEST_DISP.exists():
+            os.rename(DEST_DISP, backup / "XeGfxDisplay.kext.original")
+        os.rename(stages[DEST_DISP], DEST_DISP)
+        swapped = True
+        # rebuild AuxKC with the canonical command line (same one the core installer uses)
+        args = ["/usr/bin/kmutil", "create", "-n", "aux", "--volume-root", "/", "--allow-missing-kdk",
+                "-B", "/System/Library/KernelCollections/BootKernelExtensions.kc",
+                "-S", "/System/Library/KernelCollections/SystemKernelExtensions.kc",
+                "--repository", "/Library/Extensions",
+                "--repository", "/Library/Apple/System/Library/Extensions",
+                "-A", str(candidate), "-z"]
+        if pathlib.Path("/System/Library/Kernels/kernel").exists():
+            args += ["--kernel", "/System/Library/Kernels/kernel"]
+        run(args, log)
+        new_entries = entries(candidate)
+        if new_entries.get(IDENT_CORE) != src_core_info.get("CFBundleVersion"):
+            raise RuntimeError("candidate core version %r != %r" % (new_entries.get(IDENT_CORE), src_core_info.get("CFBundleVersion")))
+        if IDENT_DISP not in new_entries:
+            raise RuntimeError("candidate AuxKC is missing %s" % IDENT_DISP)
+        changed = [b for b, v in old_entries.items() if b not in (IDENT_CORE, IDENT_DISP) and new_entries.get(b) != v]
+        if changed:
+            raise RuntimeError("existing AuxKC bundles changed: " + ", ".join(changed))
+        uuid_text = run(["/usr/bin/kmutil", "inspect", "-a", "x86_64", "-A", str(candidate), "--show-kext-uuids"], log)
+        (backup / "candidate-uuids.txt").write_text(uuid_text)
+        os.chmod(candidate, 0o744)
+        os.replace(candidate, KC)
+        with KC.open("rb") as f:
+            os.fsync(f.fileno())
+        # M3c S1/S2: arm the NVRAM gates (never boot-args: OpenCore rewrites them)
+        gate_names = ("xegfx-disp-phase", "xegfx-disp-trial", "xegfx-disp-starts",
+                      "xegfx-disp-fail", "xegfx-disp-expose")
+        old_gates = {n: nvram_get(n) for n in gate_names}
+        (backup / "nvram-gates-before.txt").write_text("\n".join(f"{k}={v}" for k, v in old_gates.items()) + "\n")
+        if with_gates:
+            nvram_set("xegfx-disp-phase", "%01")
+            nvram_set("xegfx-disp-trial", "%00")
+            nvram_set("xegfx-disp-starts", "%00")
+            nvram_set("xegfx-disp-fail", "%00")
+            nvram_set("xegfx-disp-expose", "%01")
+            gates_changed = True
+            state["newGates"] = {n: nvram_get(n) for n in gate_names}
+        else:
+            gates_changed = False
+            state["newGates"] = old_gates
+        installed = entries(KC)
+        state.update(state="installed_pending_manual_reboot",
+                     installedKCSHA256=sha(KC), installedEntries=installed,
+                     newKextFiles={str(DEST_CORE): sha(DEST_CORE / "Contents/MacOS/XeGfx"),
+                                   str(DEST_DISP): sha(DEST_DISP / "Contents/MacOS/XeGfxDisplay")},
+                     displayKextBefore=disp_was_present, gatesChanged=gates_changed)
+        (backup / "status.json").write_text(json.dumps(state, indent=2) + "\n")
+        print(json.dumps(state, indent=2))
+    except BaseException as exc:
+        log.write("FAILED: %r\n" % (exc,))
+        if swapped:
+            restore = backup / "AuxiliaryKernelExtensions.restore.kc"
+            shutil.copy2(backup / KC.name, restore)
+            os.replace(restore, KC)
+            for dest, orig in ((DEST_CORE, "XeGfx.kext.original"), (DEST_DISP, "XeGfxDisplay.kext.original")):
+                if dest.exists():
+                    shutil.rmtree(dest)
+                if (backup / orig).exists():
+                    os.rename(backup / orig, dest)
+        for stage in stages.values():
+            if stage.exists():
+                shutil.rmtree(stage)
+        if gates_changed:
+            for name, val in old_gates.items():
+                try:
+                    if val == "":
+                        subprocess.run(["/usr/sbin/nvram", "-d", name], capture_output=True)
+                    else:
+                        nvram_set(name, val)
+                except Exception:
+                    pass
+        state.update(state="failed_disk_rolled_back", error=str(exc))
+        (backup / "status.json").write_text(json.dumps(state, indent=2) + "\n")
+        print(json.dumps(state, indent=2))
+        raise
+    finally:
+        log.close()
+
+main()
