+#!/bin/bash
+# M3d / M4a 装机后统一检查（只读）：kext 版本、闸门、双 FB、S2/S3 日志、Metal、S4 判据。
+# 用法：./tools/m3d-verify.sh        （无需 root）
+# 输出：data/m3d-verify-<stamp>/ 下的文件 + 终端摘要
+set -u
+ND=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
+STAMP=$(date '+%Y%m%d-%H%M%S')
+OUT="$ND/data/m3d-verify-$STAMP"
+mkdir -p "$OUT"
+IOREG=/usr/sbin/ioreg
+LOG=/usr/bin/log
+
+say() { echo "$@" | tee -a "$OUT/summary.txt"; }
+
+say "== m3d-verify $STAMP =="
+say "boot: $(sysctl -n kern.boottime)  uuid: $(sysctl -n kern.bootsessionuuid)"
+say "uptime: $(uptime)"
+
+say ""
+say "== installed kexts (binary sha) =="
+for k in XeGfx XeGfxDisplay XeGfxAccel XeGfxAGDC XeGfxIntelFB; do
+  b="/Library/Extensions/$k.kext/Contents/MacOS/$k"
+  if [ -f "$b" ]; then
+    say "$k: $(shasum -a 256 "$b" | awk '{print $1}')  $(stat -f%z "$b") B"
+  else
+    say "$k: (not installed)"
+  fi
+done
+say "AuxKC: $(shasum -a 256 /Library/KernelCollections/AuxiliaryKernelExtensions.kc | awk '{print $1}')"
+
+say ""
+say "== nvram gates =="
+nvram -p | grep xegfx-disp | tee -a "$OUT/summary.txt" >/dev/null || true
+
+say ""
+say "== loaded kexts =="
+kmutil showloaded 2>/dev/null | grep -E "org\.watchthelight|com\.nullmoth" | tee -a "$OUT/kexts.txt" | sed 's/^/  /' | tail -12
+
+say ""
+say "== IOFramebuffer / adapter / nub nodes =="
+for cls in IOFramebuffer XeGfxFramebuffer XeGfxIntelFramebuffer XeGfxDisplayNub XeGfxFBClaim; do
+  n=$($IOREG -c "$cls" 2>/dev/null | grep -c "class $cls")
+  say "  $cls: $n"
+done
+$IOREG -w0 -l -c XeGfxDisplayNub > "$OUT/nub.txt" 2>/dev/null
+$IOREG -w0 -l -c XeGfxFramebuffer > "$OUT/fb-adapter.txt" 2>/dev/null
+$IOREG -w0 -l -c XeGfxIntelFramebuffer > "$OUT/fb-intelfb.txt" 2>/dev/null
+$IOREG -w0 -l -c IOFramebuffer > "$OUT/fb-all.txt" 2>/dev/null
+
+say ""
+say "== adapter/FB core properties =="
+grep -E '"(xegfx-fb-state|xegfx-fb-registered|xegfx-display-version|IOFBDetailedTimings|IOFBCurrentPixelClock|IOFBDependentIndex|IOFBMemorySize|XeGfxFbRegistered|XeGfxDisplayVersion)"' "$OUT/fb-adapter.txt" 2>/dev/null | head -12 | sed 's/^/  /'
+
+say ""
+say "== S2/S3/M3d kernel log (last 20m) =="
+$LOG show --last 20m --style compact --predicate 'process == "kernel"' 2>/dev/null |
+  grep -E "XEGFX_DISPLAY|XEGFX_KAPI|S2:|S3:|xegfx-disp" | tail -40 > "$OUT/log-xegfx.txt"
+wc -l < "$OUT/log-xegfx.txt" | xargs -I{} echo "  lines: {}"
+head -20 "$OUT/log-xegfx.txt" | sed 's/^/  /'
+
+say ""
+say "== display / Metal =="
+HERE=$(cd -- "$(dirname -- "$0")" && pwd)
+/usr/bin/python3 "$HERE/xegfx-ws-preflight.py" --disk-only > "$OUT/metal-contract.txt" 2>&1
+CONTRACT_RC=$?
+cat "$OUT/metal-contract.txt" | tee -a "$OUT/summary.txt"
+say "  disk contract exit=$CONTRACT_RC (not desktop validation)"
+system_profiler SPDisplaysDataType 2>/dev/null | grep -iE "Chipset|Metal|Resolution|VRAM|Refresh" | head -12 | tee -a "$OUT/display.txt" | sed 's/^/  /'
+
+say ""
+say "== WindowServer / user =="
+pgrep -lx WindowServer | head -2
+stat -f "console user: %Su" /dev/console 2>/dev/null
+say ""
+say "raw outputs: $OUT"
