+#!/bin/bash
+# M3c S1: NVRAM takeover gates + rollback assets.   Must run as root (osascript admin).
+#   usage: m3c-gates.sh init|status|arm-trial|disarm-trial|clear|backup
+# Gates (all under our own NVRAM namespace so OpenCore boot-args never matter):
+#   xegfx-disp-phase : 0/1 = skeleton/inert only (default 1), 2 = same-mode claim armed
+#   xegfx-disp-trial : 0/1 = one-boot trial opt-in (S3); a failed trial must end as 0
+#   xegfx-disp-starts: u32 consecutive boots with no user client (watchdog counter)
+#   xegfx-disp-fail  : 0/1 = last boot reached the point of no return and failed
+#   xegfx-disp-expose: 0/1 = publish the extra IOFramebuffer node in ioreg (debug visibility)
+set -u
+NB=/usr/sbin/nvram
+STAMP=$(date +%Y%m%d-%H%M%S)
+BK=/Library/XeGfxTrial/m3c-$STAMP
+case "${1:-status}" in
+init)
+  $NB xegfx-disp-phase=%01%00%00%00 2>/dev/null || true
+  $NB xegfx-disp-trial=%00%00%00%00 2>/dev/null || true
+  $NB xegfx-disp-starts=%00%00%00%00 2>/dev/null || true
+  $NB xegfx-disp-fail=%00%00%00%00 2>/dev/null || true
+  $NB xegfx-disp-expose=%01%00%00%00 2>/dev/null || true
+  mkdir -p /var/db/xegfx
+  : > /var/db/xegfx/takeover.ok 2>/dev/null || true
+  rm -f /var/db/xegfx/fail 2>/dev/null || true
+  echo "== gates initialized"; $0 status ;;
+arm-trial)
+  $NB xegfx-disp-phase=%02%00%00%00; $NB xegfx-disp-trial=%01%00%00%00
+  echo "== armed trial (phase=2 trial=1). M3d claim will be tried on next boot."; $0 status ;;
+disarm-trial)
+  $NB xegfx-disp-trial=%00%00%00%00; $NB xegfx-disp-phase=%01%00%00%00
+  echo "== disarmed (phase=1 trial=0). Next boot stays inert."; $0 status ;;
+clear)
+  for k in xegfx-disp-phase xegfx-disp-trial xegfx-disp-starts xegfx-disp-fail xegfx-disp-expose; do
+    $NB -d "$k" 2>/dev/null && echo "deleted $k"
+  done
+  rm -f /var/db/xegfx/fail /var/db/xegfx/takeover.ok 2>/dev/null || true
+  echo "== all gates removed (fallback: stock behaviour)" ;;
+status)
+  echo "== nvram gates:"; $NB -p 2>/dev/null | grep -E 'xegfx-disp' || echo "(none set)"
+  echo "== sentinels:"; ls -l /var/db/xegfx 2>/dev/null || echo "(no /var/db/xegfx)"
+  echo "== display kexts:"; for k in XeGfxDisplay XeGfxIntelFB XeGfxAccel XeGfxAGDC; do
+    f=/Library/Extensions/$k.kext/Contents/MacOS/$k; [ -f "$f" ] && printf "  %-14s %s %s\n" "$k" "$(shasum -a 256 "$f" | cut -c1-16)" "$(stat -f%z "$f")"
+  done ;;
+backup)
+  mkdir -p "$BK"
+  echo "== backup assets -> $BK"
+  $NB -p > "$BK/nvram-before.txt" 2>/dev/null
+  kmutil showloaded > "$BK/showloaded-before.txt" 2>/dev/null
+  ioreg -w0 -c IOFramebuffer -r > "$BK/ioreg-fb-before.txt" 2>/dev/null
+  for k in XeGfxDisplay XeGfxIntelFB XeGfxAccel XeGfxAGDC XeGfx; do
+    [ -d /Library/Extensions/$k.kext ] && /usr/bin/tar -cpf "$BK/$k.kext.tar" -C /Library/Extensions "$k.kext" 2>/dev/null
+  done
+  cp -p /Library/KernelCollections/AuxiliaryKernelExtensions.kc "$BK/AuxKC.before" 2>/dev/null || true
+  cp -p /System/Library/KernelCollections/BootKernelExtensions.kc "$BK/BootKC.before" 2>/dev/null || true
+  ls -l "$BK" | head -20; echo "RESULT_BACKUP=$BK" ;;
+*) echo "usage: $0 init|status|arm-trial|disarm-trial|clear|backup"; exit 2 ;;
+esac
