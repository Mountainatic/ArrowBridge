+#!/bin/bash
+# Read-only baseline capture for M3c S1/S2 (no root needed for most of it).
+P=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
+D=$P/data/m3c-baseline-$(date +%Y%m%d-%H%M%S); mkdir -p "$D"
+echo "out=$D"
+date > "$D/date.txt"; sysctl -n kern.boottime >> "$D/date.txt"; sysctl -n kern.bootsessionuuid >> "$D/date.txt"
+/usr/sbin/nvram -p > "$D/nvram.txt" 2>/dev/null
+/usr/bin/kmutil showloaded > "$D/showloaded.txt" 2>/dev/null
+/usr/bin/ioreg -w0 -l -c XeGfxIntelFramebuffer > "$D/ioreg-fb-intelfb.txt" 2>/dev/null
+/usr/bin/ioreg -w0 -l -c XeGfxFramebuffer > "$D/ioreg-fb-adapter.txt" 2>/dev/null
+/usr/bin/ioreg -w0 -l -c IONDRVFramebuffer > "$D/ioreg-fb-iondrv.txt" 2>/dev/null
+/usr/sbin/system_profiler SPDisplaysDataType > "$D/system-profiler.txt" 2>/dev/null
+/usr/bin/ioreg -w0 -c IOFramebufferUserClient > "$D/ioreg-fbclient.txt" 2>/dev/null
+/usr/bin/log show --last 10m --style compact 2>/dev/null | grep -E "XEGFX_|IOFramebuffer" | tail -80 > "$D/log-display.txt"
+for k in XeGfxDisplay XeGfxIntelFB XeGfxAccel XeGfxAGDC XeGfx; do
+  f=/Library/Extensions/$k.kext/Contents/MacOS/$k
+  [ -f "$f" ] && shasum -a 256 "$f" >> "$D/kext-shas.txt"
+done
+ls -l /Library/KernelCollections/AuxiliaryKernelExtensions.kc >> "$D/kext-shas.txt" 2>/dev/null
+echo "captured"; ls "$D"
