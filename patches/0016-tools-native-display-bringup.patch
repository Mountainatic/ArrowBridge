+        if info.get("CFBundleIdentifier") != comp["ident"]:
+            die("%s: unexpected CFBundleIdentifier %r (want %r)" %
+                (name, info.get("CFBundleIdentifier"), comp["ident"]))
+        if not (src / "Contents/MacOS" / comp["macos"]).is_file():
