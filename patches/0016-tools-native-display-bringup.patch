+#!/bin/bash
+# M3c S2 verification (read-only; run after bring-up).  usage: m3s2-verify.sh [outdir]
+set -u
+D=${1:-$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)/data/m3s2-verify-$(date +%Y%m%d-%H%M%S)}
+mkdir -p "$D"
+exec > >(tee -a "$D/report.txt") 2>&1
+echo "== M3c S2 verification $(date) =="
+echo "-- boot / session --"
+sysctl -n kern.boottime; /usr/sbin/sysctl -n kern.bootsessionuuid
+stat -f "%Sm" /dev/console 2>/dev/null
+echo "console user: $(/usr/bin/stat -f '%Su' /dev/console 2>/dev/null)"
+pgrep -x WindowServer
+echo
+echo "-- installed kexts --"
+for k in XeGfx XeGfxDisplay XeGfxIntelFB XeGfxAccel XeGfxAGDC; do
+  f=/Library/Extensions/$k.kext/Contents/MacOS/$k
+  [ -f "$f" ] && printf "  %-16s %s %s\n" "$k" "$(shasum -a 256 "$f" | cut -c1-16)" "$(stat -f%z "$f")"
+done
+echo
+echo "-- nvram gates --"
+/usr/sbin/nvram -p | grep -E 'xegfx-disp' || echo "(none)"
+echo
+echo "-- loaded watch --"
+/usr/bin/kmutil showloaded | grep -E "XeGfx|NVAccel" || true
+echo
+echo "-- IOFramebuffer nodes --"
+/usr/sbin/ioreg -w0 -l -c XeGfxIntelFramebuffer > "$D/ioreg-intelfb.txt" 2>/dev/null
+/usr/sbin/ioreg -w0 -l -c XeGfxFramebuffer      > "$D/ioreg-adapter.txt" 2>/dev/null
+/usr/sbin/ioreg -w0 -l -c XeGfxDisplayNub       > "$D/ioreg-nub.txt" 2>/dev/null
+/usr/sbin/ioreg -w0 -l -c IOFramebufferUserClient > "$D/ioreg-userclients.txt" 2>/dev/null
+echo "intelfb node: $(grep -c 'class XeGfxIntelFramebuffer' "$D/ioreg-intelfb.txt" 2>/dev/null)  adapter: $(grep -c 'class XeGfxFramebuffer' "$D/ioreg-adapter.txt" 2>/dev/null)  nub: $(grep -c 'class XeGfxDisplayNub' "$D/ioreg-nub.txt" 2>/dev/null)"
+echo "adapter state: $(grep -oE 'registered, matched, active|!registered, !matched, active|registered, !matched, active' "$D/ioreg-adapter.txt" 2>/dev/null | head -1)"
+echo "userclients total: $(grep -c IOFramebufferUserClient "$D/ioreg-userclients.txt" 2>/dev/null)"
+grep -E "IOFramebufferUserClient|display0" "$D/ioreg-userclients.txt" 2>/dev/null | head -5
+echo
+echo "-- S2 log lines --"
+/usr/bin/log show --last 30m --style compact 2>/dev/null | grep -E "S2: inert IOFramebuffer registered|S2: open\(\) denied|XeGfxDisplaySkeleton|XeGfxDisplayInert" | head -10
+echo
+echo "-- KAPI mock report (needs core loaded) --"
+if [ -n "$(sysctl -n debug.xegfx_disp 2>/dev/null)" ] || sysctl debug.xegfx_disp >/dev/null 2>&1; then
+  sysctl -w debug.xegfx_disp_log=1 >/dev/null 2>&1 || true
+  if [ -n "$(sysctl -n debug.xegfx_disp_log 2>/dev/null)" ]; then
+    /usr/bin/sysctl -b debug.xegfx_disp > "$D/kapi-report.bin" 2>/dev/null
+    strings -a "$D/kapi-report.bin" | head -30
+  fi
+else
+  echo "(core not loaded yet -- run bring-up first)"
+fi
+echo
+echo "-- display / Metal --"
+/usr/sbin/system_profiler SPDisplaysDataType 2>/dev/null | grep -iE "Chipset|Metal:|Resolution" | head -8
+echo
+echo "-- accel telemetry --"
+for k in stage running accel_igpu accelfb accel_iop accel_heads_published accel_heads_registered accel_heads_piped; do
+  printf "  %-24s %s\n" "$k" "$(sysctl -n debug.xegfx_$k 2>/dev/null)"
+done
+echo
+echo "saved: $D"
