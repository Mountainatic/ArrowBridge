+def run(args, log=None):
+    r = subprocess.run(args, capture_output=True, text=True)
+    if log is not None:
+        log.write("$ " + " ".join(args) + "\n" + (r.stdout or "") + (r.stderr or "") + "\n")
+        log.flush()
+    if r.returncode != 0:
+        die("command failed (%d): %s\n%s" % (r.returncode, " ".join(args), (r.stderr or r.stdout)[-1500:]))
