+            i += 1
+            opts["targets"][a[2:]] = pathlib.Path(argv[i])
+        elif a in ("--phase", "--trial", "--starts", "--fail", "--expose"):
+            i += 1
+            opts["gates"][a[2:]] = int(argv[i])
