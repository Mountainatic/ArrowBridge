+<?xml version="1.0" encoding="UTF-8"?>
+<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
+<plist version="1.0">
+<dict>
+	<!--
+	  M4a-2 claim-takeover bootguard.
+
+	  Boot-chain contract: docs/18-M4A-BOOT-CHAIN.md
+	  Claim attribute contract: docs/19-M4A-CLAIM.md §8
+	  Operator runbook: docs/20-M4A2-BOOTGUARD.md
+
+	  RunAtLoad + no KeepAlive: the daemon runs exactly once per boot, as
+	  early as launchd allows (before loginwindow/WindowServer).  It is a
+	  one-shot state machine; it never respawns itself, and
+	  always exits 0 so launchd does not treat a normal rollback as a crash.
+
+	  Install (root LaunchDaemon, done by the M4a-2 installer or by hand):
+	    install -m 644 tools/com.xegfx.m4a2bootguard.plist \
+	        /Library/LaunchDaemons/com.xegfx.m4a2bootguard.plist
+	    install -m 755 tools/m4a2-bootguard.sh \
+	        /usr/local/xegfx/m4a2-bootguard.sh
+	    launchctl bootout system/com.xegfx.m4a2bootguard 2>/dev/null || true
+	    launchctl bootstrap system /Library/LaunchDaemons/com.xegfx.m4a2bootguard.plist
+	    launchctl enable system/com.xegfx.m4a2bootguard
+
+	  Remove (rollback, see bootfix/rollback-m4a2.sh):
+	    launchctl bootout system/com.xegfx.m4a2bootguard 2>/dev/null || true
+	    rm -f /Library/LaunchDaemons/com.xegfx.m4a2bootguard.plist \
+	          /usr/local/xegfx/m4a2-bootguard.sh
+	-->
+	<key>Label</key>
+	<string>com.xegfx.m4a2bootguard</string>
+
+	<key>ProgramArguments</key>
+	<array>
+		<string>/bin/bash</string>
+		<string>/usr/local/xegfx/m4a2-bootguard.sh</string>
+	</array>
+
+	<!-- Start as early as possible after the root filesystem is writable. -->
+	<key>RunAtLoad</key>
+	<true/>
+
+	<!-- One shot: a failure path schedules its own reboot. -->
+	<key>LaunchOnlyOnce</key>
+	<true/>
+	<key>KeepAlive</key>
+	<false/>
+	<key>ProcessType</key>
+	<string>Background</string>
+	<key>ThrottleInterval</key>
+	<integer>10</integer>
+
+	<!-- launchd does not run as root by default for user jobs; root Daemon
+	     jobs under /Library/LaunchDaemons run as root, but be explicit. -->
+	<key>UserName</key>
+	<string>root</string>
+	<key>GroupName</key>
+	<string>wheel</string>
+
+	<!-- Environment is fixed so probes behave identically from a terminal. -->
+	<key>EnvironmentVariables</key>
+	<dict>
+		<key>PATH</key>
+		<string>/usr/bin:/bin:/usr/sbin:/sbin</string>
+	</dict>
+
+	<key>StandardOutPath</key>
+	<string>/var/log/xegfx-m4a2bootguard.out</string>
+	<key>StandardErrorPath</key>
+	<string>/var/log/xegfx-m4a2bootguard.err</string>
+</dict>
+</plist>
