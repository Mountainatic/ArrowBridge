+#!/bin/bash
+# M4a-1 boot-time auto-arm for XeGfx (LaunchDaemon, root).
+#
+# Goal: reproduce the manually proven bring-up at every boot, without taking the
+# PCI display category away from XeGfxIntelFB (M4a-2 / claim takeover needs the
+# M3d aperture+open work; this is the safe first step).
+#
+# Flow: load core -> core boot thread runs stages 1..7 + AGDC/K5 auto -> IOKit
+# auto-matches XeGfxAccel after stage 7 -> arm the accelerator's boot thread ->
+# write plugin allow markers -> restart WindowServer exactly once -> watch
+# stability. If anything fails, log it, set xegfx-disp-fail=1 and DO NOT restart
+# WindowServer (desktop stays on the known-good unaccelerated path). If
+# WindowServer crash-loops after the restart, disable the bootarm gate and reboot
+# once to the safe desktop.
+#
+# Gates (NVRAM, canonical 4-byte LE):
+#   xegfx-disp-bootarm = %01%00%00%00  this script may run
+#   xegfx-disp-fail    != 0            manual pull / previous failure, skip
+set -u
+
+LOG=/Library/XeGfxTrial/m4a1-$(date +%Y%m%d-%H%M%S)
+mkdir -p "$LOG" || exit 0
+exec >>"$LOG/bootarm.log" 2>&1
+
+echo "=== m4a1 bootarm start $(date '+%F %T')"
+nv()      { /usr/sbin/nvram "$1" 2>/dev/null | awk -F'\t' '{print $2}'; }
+nonzero() { case "$1" in ""|"%00%00%00%00") return 1;; *) return 0;; esac; }
+finish()  { echo "RESULT=$1" > "$LOG/RESULT"; echo "=== m4a1 bootarm end $(date '+%F %T') RESULT=$1"; exit 0; }
+failgate() { /usr/sbin/nvram xegfx-disp-fail=%01%00%00%00 2>/dev/null || true; restore_allow; }
+# canonical 4-byte LE gate values (same encoding as tools/m3c-gates.sh)
+u32hex()   { case "$1" in 0) echo "%00%00%00%00";; 1) echo "%01%00%00%00";; 2) echo "%02%00%00%00";; 3) echo "%03%00%00%00";; *) echo "%00%00%00%00";; esac; }
+nvu32()    { v=$(nv "$1"); case "$v" in "%01%00%00%00") echo 1;; "%02%00%00%00") echo 2;; "%03%00%00%00") echo 3;; *) echo 0;; esac; }
+setu32()   { /usr/sbin/nvram "$1=$(u32hex "$2")" 2>/dev/null || true; }
+ALLOW=/Library/GPUBundles/xemtl-allow.txt
+restore_allow() {
+  if [ -f "$LOG/xemtl-allow.before" ]; then
+    cp -p "$LOG/xemtl-allow.before" "$ALLOW" 2>/dev/null || rm -f "$ALLOW"
+  else
+    rm -f "$ALLOW" 2>/dev/null || true
+  fi
+  echo "allow file restored to pre-arm state"
+}
+# save the pre-arm allow file (may be absent) before we touch it
+[ -f "$ALLOW" ] && cp -p "$ALLOW" "$LOG/xemtl-allow.before" 2>/dev/null || true
+
+BOOTARM=$(nv xegfx-disp-bootarm)
+nonzero "$BOOTARM" || { echo "bootarm gate off (${BOOTARM:-absent}); nothing to do"; finish "gate-off"; }
+
+# pending-reboot guard: the installer writes the boot UUID of the boot it ran on;
+# on that same boot the new AuxKC is not live yet, so skip without touching gates.
+INST=$(/usr/sbin/nvram -p 2>/dev/null | awk '$1=="xegfx-disp-instboot"{print $2}')
+CURB=$(/usr/sbin/sysctl -n kern.bootsessionuuid 2>/dev/null)
+if [ -n "${INST:-}" ] && [ "$INST" = "$CURB" ]; then
+  echo "pending reboot (installed on boot $CURB); skipping this boot without touching gates"
+  finish "pending-reboot"
+fi
+if [ -n "${INST:-}" ]; then /usr/sbin/nvram -d xegfx-disp-instboot >/dev/null 2>&1 || true; fi
+FAILG=$(nv xegfx-disp-fail)
+nonzero "$FAILG" && { echo "fail gate set ($FAILG); skip auto-arm this boot"; finish "fail-gate"; }
+STARTS=$(nvu32 xegfx-disp-starts)
+if [ "$STARTS" -ge 2 ]; then
+  echo "circuit breaker: $STARTS consecutive failed boots; disabling bootarm and restoring safe desktop"
+  setu32 xegfx-disp-bootarm 0; setu32 xegfx-disp-fail 1
+  finish "circuit-breaker"
+fi
+setu32 xegfx-disp-starts $((STARTS+1))
+echo "attempt $((STARTS+1)) (xegfx-disp-starts)"
+BOOT=$(/usr/sbin/sysctl -n kern.bootsessionuuid 2>/dev/null || echo unknown)
+echo "bootsession=$BOOT"
+
+# 1) load the core kext by hand (its personality is gated on XeGfxArm, which
+#    nobody publishes on the M4a-1 path; kmutil load -b is the manual equivalent).
+sleep 2
+ok=0
+for i in $(seq 1 30); do
+  if /usr/bin/kmutil showloaded 2>/dev/null | grep -q "org.watchthelight.XeGfx ("; then ok=1; break; fi
+  if /usr/bin/kmutil load -b org.watchthelight.XeGfx >/dev/null 2>&1; then ok=1; break; fi
+  sleep 2
+done
+if [ "$ok" != 1 ]; then
+  echo "FAILED: could not load core kext"
+  failgate
+  finish "core-load-failed"
+fi
+echo "core loaded: $(/usr/bin/kmutil showloaded 2>/dev/null | grep 'org.watchthelight.XeGfx ' | head -1)"
+
+# 2) wait for the core boot-armed stage chain (XeGfxCoreReady / debug.xegfx_boot).
+stageok=0
+for i in $(seq 1 150); do
+  if /usr/sbin/ioreg -l -w0 -r -c IOResources 2>/dev/null | grep -q XeGfxCoreReady; then stageok=1; break; fi
+  b=$(/usr/sbin/sysctl -n debug.xegfx_boot 2>/dev/null || true)
+  case "$b" in *"stage 7"*) stageok=1; break;; esac
+  sleep 1
+done
+if [ "$stageok" != 1 ]; then
+  echo "FAILED: stage chain not ready (debug.xegfx_boot=$(/usr/sbin/sysctl -n debug.xegfx_boot 2>/dev/null))"
+  failgate
+  finish "stage-timeout"
+fi
+echo "stage chain ready: $(/usr/sbin/sysctl -n debug.xegfx_boot 2>/dev/null)"
+
+# 3) accelerator: IOKit should auto-match it once stage 7 published
+#    'nmxgpu-claimed'; then arm its boot thread (no XeGfxBootArm resource here).
+for i in $(seq 1 60); do
+  /usr/bin/kmutil showloaded 2>/dev/null | grep -q "org.watchthelight.XeGfxAccel (" && break
+  sleep 1
+done
+/usr/bin/kmutil showloaded 2>/dev/null | grep -q "org.watchthelight.XeGfxAccel (" || \
+  /usr/bin/kmutil load -b org.watchthelight.XeGfxAccel >/dev/null 2>&1 || true
+sleep 1
+armok=0
+for i in $(seq 1 30); do
+  if /usr/sbin/sysctl -w debug.xegfxaccel_boot=1 >/dev/null 2>&1; then armok=1; break; fi
+  sleep 1
+done
+if [ "$armok" != 1 ]; then
+  echo "FAILED: cannot write debug.xegfxaccel_boot"
+  finish "accel-arm-write-failed"
+fi
+ready=0; armed_failed=0
+for i in $(seq 1 150); do
+  s=$(/usr/sbin/sysctl -n debug.xegfxaccel_boot 2>/dev/null || true)
+  case "$s" in
+    2) ready=1 ;;
+    3) armed_failed=1 ;;
+    "") : ;;
+    0|1) : ;;
+    *) : ;;
+  esac
+  /usr/sbin/ioreg -l -w0 -r -c NMXAccel 2>/dev/null | grep -qiE "XeGfxAccelBootReady.*true" && ready=1
+  [ "$ready" = 1 ] && break
+  [ "$armed_failed" = 1 ] && break
+  sleep 1
+done
+if [ "$armed_failed" = 1 ]; then
+  echo "FAILED: accel boot-armed reported FAILED (debug.xegfxaccel_boot=3)"
+  /usr/bin/log show --last 5m --style compact 2>/dev/null | grep -E "boot-armed|XeGfxAccelBootFailure" | tail -20
+  failgate
+  finish "accel-boot-failed"
+fi
+if [ "$ready" != 1 ]; then
+  echo "FAILED: accel boot-armed did not reach READY"
+  failgate
+  finish "accel-timeout"
+fi
+echo "accel ready: boot=$(/usr/sbin/sysctl -n debug.xegfxaccel_boot 2>/dev/null) iop=$(/usr/sbin/sysctl -n debug.xegfxaccel_iop 2>/dev/null) heads=$(/usr/sbin/sysctl -n debug.xegfxaccel_heads_registered 2>/dev/null) piped=$(/usr/sbin/sysctl -n debug.xegfxaccel_heads_piped 2>/dev/null)"
+
+# 4) plugin allow markers for the next WindowServer generation.
+printf '# XeGfx M4a1 auto %s\n!WindowServer\n' "$BOOT" > /Library/GPUBundles/xemtl-allow.txt 2>/dev/null
+/usr/sbin/chown root:wheel /Library/GPUBundles/xemtl-allow.txt 2>/dev/null
+/bin/chmod 644 /Library/GPUBundles/xemtl-allow.txt 2>/dev/null
+: > /private/tmp/xemtl-first-loss-enable 2>/dev/null
+/usr/sbin/chown root:wheel /private/tmp/xemtl-first-loss-enable 2>/dev/null
+/bin/chmod 644 /private/tmp/xemtl-first-loss-enable 2>/dev/null
+: > /private/tmp/xemtl-ws-nowait 2>/dev/null
+/usr/sbin/chown root:wheel /private/tmp/xemtl-ws-nowait 2>/dev/null
+/bin/chmod 644 /private/tmp/xemtl-ws-nowait 2>/dev/null
+echo "allow file: $(cat /Library/GPUBundles/xemtl-allow.txt 2>/dev/null | tr '\n' '|')"
+
+# 5) one WindowServer restart (the logout step of the manual flow).
+old=$(/usr/bin/pgrep -x WindowServer || true)
+/bin/launchctl kickstart -k system/com.apple.WindowServer >/dev/null 2>&1
+new=""
+for i in $(seq 1 60); do
+  sleep 1
+  new=$(/usr/bin/pgrep -x WindowServer || true)
+  [ -n "$new" ] && break
+done
+echo "WindowServer: ${old:-none} -> ${new:-none}"
+
+# 6) stability watch: revert to the safe desktop if WindowServer keeps dying.
+pids=" ${new:-0} "
+crashes=0
+for i in $(seq 1 60); do
+  sleep 1
+  cur=$(/usr/bin/pgrep -x WindowServer || true)
+  if [ -z "$cur" ]; then
+    crashes=$((crashes+1))
+  else
+    case "$pids" in *" $cur "*) : ;; *) pids="$pids$cur "; crashes=$((crashes+1));; esac
+  fi
+  [ "$crashes" -ge 4 ] && break
+done
+if [ "$crashes" -ge 4 ]; then
+  echo "WINDOWSERVER CRASH LOOP ($crashes new instances); disabling bootarm gate and rebooting to safe desktop"
+  setu32 xegfx-disp-bootarm 0
+  failgate
+  /sbin/shutdown -r +1 >/dev/null 2>&1 || true
+  finish "ws-crash-loop-reverting"
+fi
+echo "WindowServer stable: pids=$pids"
+
+# 7) record diagnostics for the next login.
+/usr/sbin/sysctl -a 2>/dev/null | grep -E 'xegfx|nmxaccel' > "$LOG/sysctl.txt" 2>/dev/null || true
+/usr/bin/ioreg -a -l -w0 -r -c NMXAccel > "$LOG/ioreg-accel.plist" 2>/dev/null || true
+/usr/bin/ioreg -l -w0 -r -c IOResources 2>/dev/null | grep -i xegfx > "$LOG/ioreg-ioresources.txt" 2>/dev/null || true
+/usr/bin/log show --last 15m --style compact 2>/dev/null | grep -E 'XEGFX|NMXAccel|boot-armed|claim|S2:|S3:' | tail -400 > "$LOG/unified-tail.txt" 2>/dev/null || true
+
+setu32 xegfx-disp-starts 0
+echo "OK: armed and WindowServer restarted"
+finish "armed-and-restarted"
