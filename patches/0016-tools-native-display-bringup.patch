+#!/bin/bash
+# M4a-1 install transaction (root; the Lead wraps this in osascript administrator
+# privileges). Installs the boot-armed core + accelerator, rebuilds the AuxKC via
+# the proven install-m3d.py transaction, installs the com.xegfx.bootarm
+# LaunchDaemon, and arms the NVRAM bootarm gate. XeGfxIntelFB keeps owning the
+# display (claim stays at phase=1 / declines), so the only new risk is the
+# single WindowServer restart performed by the daemon.
+set -u
+
+P=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
+CORE_OUT=${XEGFX_CORE_KEXT:?set XEGFX_CORE_KEXT to the XeGfx.kext build artifact}
+ACCEL_OUT=${XEGFX_ACCEL_KEXT:?set XEGFX_ACCEL_KEXT to the XeGfxAccel.kext build artifact}
+STAMP=$(date +%Y%m%d-%H%M%S)
+BK=/Library/XeGfxTrial/m4a1-install-$STAMP
+mkdir -p "$BK"
+
+echo "== m4a1 install $STAMP =="
+[ -d "$CORE_OUT" ]  || { echo "MISSING core artifact: $CORE_OUT"; exit 2; }
+[ -d "$ACCEL_OUT" ] || { echo "MISSING accel artifact: $ACCEL_OUT"; exit 2; }
+echo "core : $(shasum -a 256 "$CORE_OUT/Contents/MacOS/XeGfx" | awk '{print $1}') $(stat -f%z "$CORE_OUT/Contents/MacOS/XeGfx")"
+echo "accel: $(shasum -a 256 "$ACCEL_OUT/Contents/MacOS/XeGfxAccel" | awk '{print $1}') $(stat -f%z "$ACCEL_OUT/Contents/MacOS/XeGfxAccel")"
+
+# ---------------------------------------------------------------------------
+# 1) accelerator bundle with the XeMTL plugin names patched in.
+#    The build template still says NVMTLDriver/NVMTLDevice (upstream default);
+#    the installed kext has always used the Xe names. Installing the raw build
+#    would make Metal load the NVIDIA plugin.
+rm -rf /tmp/m4a1-accel
+/usr/bin/ditto "$ACCEL_OUT" /tmp/m4a1-accel/XeGfxAccel.kext || exit 3
+/usr/bin/python3 - <<'PY' || exit 3
+import plistlib
+p = "/tmp/m4a1-accel/XeGfxAccel.kext/Contents/Info.plist"
+d = plistlib.load(open(p, "rb"))
+d["MetalPluginClassName"] = "XeMTLDevice"
+d["MetalPluginName"] = "../../../Library/GPUBundles/XeMTLDriver"
+plistlib.dump(d, open(p, "wb"))
+print("patched MetalPluginClassName=%s MetalPluginName=%s"
+      % (d["MetalPluginClassName"], d["MetalPluginName"]))
+PY
+/usr/bin/plutil -lint /tmp/m4a1-accel/XeGfxAccel.kext/Contents/Info.plist || exit 3
+/usr/bin/codesign -f -s - --timestamp=none /tmp/m4a1-accel/XeGfxAccel.kext >/dev/null 2>&1 || true
+
+# ---------------------------------------------------------------------------
+# 2) kext + AuxKC transaction (backup dir is printed by the installer).
+echo "== install core + accel (phase=1 trial=0) =="
+/usr/bin/python3 "$P/tools/install-m3d.py" \
+  --core  "$CORE_OUT" \
+  --accel /tmp/m4a1-accel/XeGfxAccel.kext \
+  --phase 1 --trial 0 --starts 0 --fail 0 --expose 1
+RC=$?
+echo "kext transaction rc=$RC"
+[ "$RC" -ne 0 ] && { echo "KEXT TRANSACTION FAILED; nothing else changed"; exit "$RC"; }
+
+# keep the pre-arm plugin allow file inside the transaction backup so the
+# rollback script can restore it exactly instead of blindly deleting it
+TXN=$(/bin/ls -dt /Library/XeGfxTrial/m3d-* 2>/dev/null | head -1)
+if [ -n "${TXN:-}" ] && [ -f /Library/GPUBundles/xemtl-allow.txt ]; then
+  cp -p /Library/GPUBundles/xemtl-allow.txt "$TXN/xemtl-allow.before" 2>/dev/null || true
+  echo "saved plugin allow file into $TXN/xemtl-allow.before"
+fi
+if [ -n "${TXN:-}" ] && [ -f /Library/XeGfxTrial/m4a1-bootarm.sh ]; then
+  cp -p /Library/XeGfxTrial/m4a1-bootarm.sh "/usr/local/xegfx/m4a1-bootarm.sh" 2>/dev/null || true
+fi
+
+# ---------------------------------------------------------------------------
+# 3) bootarm gate + daemon.
+echo "== bootarm gate =="
+/usr/sbin/nvram xegfx-disp-bootarm=%01%00%00%00 || exit 5
+# pending-reboot guard: remember which boot this install ran on (daemon skips that boot)
+/sbin/nvram xegfx-disp-instboot="$(/usr/sbin/sysctl -n kern.bootsessionuuid)" || true
+echo "== install com.xegfx.bootarm daemon =="
+cp -p /Library/LaunchDaemons/com.xegfx.bootarm.plist "$BK/" 2>/dev/null || true
+cp -p /usr/local/xegfx/m4a1-bootarm.sh          "$BK/" 2>/dev/null || true
+/usr/bin/install -d -m 755 -o root -g wheel /usr/local/xegfx
+/usr/bin/install -m 755 -o root -g wheel "$P/tools/m4a1-bootarm.sh"          /usr/local/xegfx/m4a1-bootarm.sh
+/usr/bin/install -m 644 -o root -g wheel "$P/tools/com.xegfx.bootarm.plist"  /Library/LaunchDaemons/com.xegfx.bootarm.plist
+/bin/launchctl bootout system/com.xegfx.bootarm >/dev/null 2>&1 || true
+/bin/launchctl bootstrap system /Library/LaunchDaemons/com.xegfx.bootarm.plist >/dev/null 2>&1 || true
+echo "daemon state: $(/bin/launchctl print system/com.xegfx.bootarm 2>/dev/null | grep -E 'state =|program =' | head -2 | tr '\n' ' ')"
+
+# ---------------------------------------------------------------------------
+echo "== gates =="
+/usr/sbin/nvram -p | grep -E "xegfx-disp|boot-args" || true
+echo "== installed bundles =="
+for k in XeGfx XeGfxDisplay XeGfxAccel XeGfxAGDC XeGfxIntelFB; do
+  if [ -d "/Library/Extensions/$k.kext" ]; then
+    printf "%-16s version=%s sha=%s\n" "$k" \
+      "$(/usr/bin/plutil -extract CFBundleVersion raw "/Library/Extensions/$k.kext/Contents/Info.plist" 2>/dev/null)" \
+      "$(shasum -a 256 "/Library/Extensions/$k.kext/Contents/MacOS/$k" 2>/dev/null | awk '{print $1}')"
+  else
+    echo "MISSING /Library/Extensions/$k.kext"
+  fi
+done
+echo "KC: $(shasum -a 256 /Library/KernelCollections/AuxiliaryKernelExtensions.kc | awk '{print $1}') $(stat -f%z /Library/KernelCollections/AuxiliaryKernelExtensions.kc)"
+echo "== m4a1 install DONE; reboot to test =="
