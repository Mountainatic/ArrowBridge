+#!/usr/bin/env python3
+"""Preserve the first real WindowServer IPS for exactly one boot session."""
+import hashlib
+import json
+from pathlib import Path
+import sys
+import time
+
+WS_PATHS = {
+    '/System/Library/PrivateFrameworks/SkyLight.framework/Resources/WindowServer',
+    '/System/Library/PrivateFrameworks/SkyLight.framework/Versions/A/Resources/WindowServer',
+}
+
+def collect(dest, boot, reports=Path('/Library/Logs/DiagnosticReports')):
+    dest = Path(dest)
+    dest.mkdir(parents=True, exist_ok=True)
+    deadline = time.monotonic() + 3
+    found = []
+    rejected = []
+    for path in sorted(Path(reports).glob('WindowServer*.ips')):
+        if time.monotonic() > deadline:
+            rejected.append({'file': str(path), 'reason': 'scan-deadline'})
+            break
+        try:
+            if path.stat().st_size > 8*1024*1024:
+                raise ValueError('oversized report')
+            raw = path.read_bytes()
+            first, body = raw.decode().split('\n', 1)
+            header, report = json.loads(first), json.loads(body)
+            if report.get('bootSessionUUID', '').upper() != boot.upper():
+                continue
+            if report.get('procName') != 'WindowServer' or report.get('procPath') not in WS_PATHS:
+                rejected.append({'file': str(path), 'reason': 'not-system-WindowServer'})
+                continue
+            if report.get('codeSigningID', '').startswith('local.xegfx.'):
+                continue
+            if not report.get('captureTime'):
+                raise ValueError('missing captureTime')
+            found.append((report['captureTime'], path, raw, report))
+        except (OSError, ValueError, TypeError) as exc:
+            rejected.append({'file': str(path), 'reason': str(exc)})
+    result = {'boot': boot, 'matchingReports': len(found), 'rejected': rejected}
+    if found:
+        capture, path, raw, report = min(found, key=lambda row: row[0])
+        saved = dest/'WindowServer-firstfault.ips'
+        saved.write_bytes(raw)
+        threads = report.get('threads', [])
+        index = report.get('faultingThread')
+        fault = threads[index] if isinstance(index, int) and 0 <= index < len(threads) else next((t for t in threads if t.get('triggered')), {})
+        result.update(state='first-system-WS-report-preserved', source=str(path), saved=str(saved),
+                      captureTime=capture, pid=report.get('pid'), sha256=hashlib.sha256(raw).hexdigest(),
+                      exception=report.get('exception'), termination=report.get('termination'),
+                      frames=fault.get('frames', []), images=report.get('usedImages', []))
+    else:
+        result['state'] = 'no-system-WS-report-for-this-boot'
+    (dest/'WindowServer-firstfault.json').write_text(json.dumps(result, indent=2)+'\n')
+    return result
+
+if __name__ == '__main__':
+    print(json.dumps(collect(sys.argv[1], sys.argv[2]), indent=2))
