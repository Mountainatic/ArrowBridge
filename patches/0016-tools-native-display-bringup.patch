+#!/usr/bin/env python3
+"""Read-only post-claim health; a placeholder or a mere FB object never passes."""
+import json
+import plistlib
+import subprocess
+import sys
+
+
+def run(args):
+    return subprocess.check_output(args, stderr=subprocess.STDOUT, timeout=20)
+
+
+def walk(node):
+    if isinstance(node, list):
+        for item in node: yield from walk(item)
+    elif isinstance(node, dict):
+        yield node
+        yield from walk(node.get('IORegistryEntryChildren', []))
+
+
+def check(nodes, ws):
+    nodes = list(nodes)
+    live = lambda n: isinstance(n.get('IOServiceState'), int) and n['IOServiceState'] & 2 and not n['IOServiceState'] & 1
+    fbs = [n for n in nodes if n.get('IOObjectClass') in ('XeGfxFramebuffer', 'XeGfxIntelFramebuffer') and live(n)]
+    if len(fbs) != 1 or fbs[0].get('IOObjectClass') != 'XeGfxFramebuffer':
+        raise ValueError('claim requires one registered adapter FB and no registered IntelFB')
+    fb = fbs[0]
+    for key in ('XeGfxFbRegistered', 'XeGfxFbOpened', 'XeGfxFbReady', 'XeGfxM3dReady', 'XeGfxScanoutReady'):
+        if fb.get(key) is not True: raise ValueError(key+' is not true')
+    if not any(n.get('IOObjectClass') == 'IOFramebufferUserClient'
+               and n.get('IOUserClientCreator') == 'pid %s, WindowServer' % ws for n in walk(fb)):
+        raise ValueError('the running WindowServer has no framebuffer server client under adapter')
+    accels = [n for n in nodes if n.get('CFBundleIdentifier') == 'org.watchthelight.XeGfxAccel' and n.get('IOClass') == 'NMXAccel']
+    if len(accels) != 1: raise ValueError('expected one XeGfx accelerator')
+    a = accels[0]
+    if a.get('MetalPluginName') != '../../../Library/GPUBundles/XeMTLDriver' or a.get('MetalPluginClassName') != 'XeMTLDevice':
+        raise ValueError('running iGPU Metal personality mismatch')
+    if a.get('XeGfxAccelBootReady') is not True: raise ValueError('accel boot sequence has not reached ready')
+    if a.get('XeGfxAccelKmsMemoryEnabled') is not True:
+        raise ValueError('KMS resource memory access has not been enabled')
+    return {'framebuffer': fb['IORegistryEntryID'], 'accelerator': a['IORegistryEntryID'], 'windowServer': int(ws),
+            'outputPath': 'legacy-copy' if fb.get('XeGfxKmsCopyOnly') is True else 'normal'}
+
+
+def main():
+    pids = run(['/usr/bin/pgrep', '-x', 'WindowServer']).decode().split()
+    if len(pids) != 1: raise ValueError('expected one WindowServer')
+    j = plistlib.loads(run(['/usr/sbin/ioreg', '-a', '-l', '-p', 'IOService']))
+    result = check(walk(j), pids[0])
+    for key, want in {'debug.xegfx_stage': 7, 'debug.xegfxaccel_boot': 2,
+                      'debug.xegfxaccel_heads_registered': 16, 'debug.xegfxaccel_heads_piped': 16,
+                      'debug.xegfxaccel_iop': 1}.items():
+        got = int(run(['/usr/sbin/sysctl', '-n', key]).strip())
+        if got != want: raise ValueError('%s=%s expected %s' % (key, got, want))
+    if result['outputPath'] == 'legacy-copy':
+        copies = int(run(['/usr/sbin/sysctl', '-n', 'debug.xegfxaccel_scanout_copies']).strip())
+        if copies < 1: raise ValueError('copy-only output has completed no scanout copies')
+        result['scanoutCopies'] = copies
+    print(json.dumps(dict(state='claim-health-pass', **result)))
+
+
+if __name__ == '__main__':
+    try: main()
+    except Exception as exc:
+        print(json.dumps({'state': 'claim-health-failed', 'reason': str(exc)}))
+        sys.exit(1)
