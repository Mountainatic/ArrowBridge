+#!/bin/bash
+#
+# m4a2-bootguard.sh -- M4a-2 claim-takeover boot watchdog (root LaunchDaemon).
+#
+# Installed as /usr/local/xegfx/m4a2-bootguard.sh and started by
+# com.xegfx.m4a2bootguard.plist with RunAtLoad, i.e. long before a human can
+# log in.  It is the only thing between a failed claim takeover and a black
+# screen, so every decision is written to disk before it acts.
+#
+# References (read those before changing this file):
+#   docs/18-M4A-BOOT-CHAIN.md  boot chain, claim category, watchdog order
+#   docs/19-M4A-CLAIM.md  §8  userspace bootguard contract (claim node attrs)
+#   docs/20-M4A2-BOOTGUARD.md timeline / state machine / failure injection
+#
+# ---------------------------------------------------------------------------
+# Activation gate (NVRAM, 4-byte little endian, written/read with nvram(8)):
+#   xegfx-disp-phase = 2   claim owns the IOFramebuffer category this boot
+#   xegfx-disp-trial = 1   claim trial armed for this boot
+#   xegfx-disp-fail  = 0   manual fail gate not pulled
+#   xegfx-disp-starts< 3   attempt counter not exhausted
+# Any other combination only records why it did nothing and exits.  This
+# A final fallback writes phase=1 and keeps its disk ticket until a later
+# boot observes the safe gates. Same-boot readback cannot prove persistence.
+#
+# Stage deadlines (seconds since bootguard start AND since claim start,
+# whichever is larger -- a late launchd start must not fail an early stage):
+#   core 20 | nub 60 | fb 90 | open 120 | WindowServer 180
+# In addition the claim node itself is authoritative:
+#   xegfx-fb-claim-state = failed        -> immediate failure (claim reason)
+#   xegfx-fb-claim-poll  = unavailable   -> immediate failure
+#   xegfx-fb-claim-t    >= 130           -> stuck-<state> failure
+# On success WindowServer must stay alive for WS_SETTLE (90 s) and may restart
+# at most WS_MAX_CRASH-1=2 times inside that window.
+#
+# Failure policy (see docs/20-M4A2-BOOTGUARD.md §3):
+#   attempt 1 (starts==0): starts=1, keep phase=2/trial=1, reboot -> retry once
+#   attempt 2+          : starts=2..3, trial=0, fail=1, reboot -> safe IntelFB
+# A starts bump that already happened this boot (old S3 watchdog, docs/19
+# §8.4) is detected and not counted twice.  Exactly one reboot is scheduled
+# per boot session; a reboot marker keyed by kern.bootsessionuuid prevents
+# reboot loops even if launchd restarts the daemon.
+#
+# Testability: the script is pure bash 3.2 (macOS /bin/bash) and has no
+# external state besides nvram/ioreg/log/kmutil.  --dry-run + M4A2_SIM let
+# the complete state machine be exercised without touching NVRAM or rebooting:
+#   tools/m4a2-bootguard.sh --dry-run --logdir /tmp/x
+#   M4A2_SIM=1 M4A2_SIM_SCENARIO=fail-nub tools/m4a2-bootguard.sh ...
+# Environment overrides used by the failure-injection tests:
+#   M4A2_LOGBASE, M4A2_POLL, M4A2_DEADLINE_{CORE,NUB,FB,OPEN,WS},
+#   M4A2_WS_SETTLE, M4A2_WS_MAX_CRASH, M4A2_CLAIM_T_MAX, M4A2_RETRY_ONCE,
+#   M4A2_SIM, M4A2_SIM_SCENARIO, M4A2_SIM_CLAIM, M4A2_SIM_GATE,
+#   M4A2_SIM_STARTS_RAW, M4A2_SIM_FAIL_RAW, M4A2_SIM_DIAG=0 (skip slow diag capture).
+#
+# Exit status: always 0 (a LaunchDaemon with KeepAlive=false must not look
+# like a crash); the outcome is in <logdir>/RESULT and boot-stage.log.
+
+set -u
+
+PATH="/usr/bin:/bin:/usr/sbin:/sbin:${PATH:-}"
+NVRAM=/usr/sbin/nvram
+IOREG=/usr/sbin/ioreg
+SYSCTL=/usr/sbin/sysctl
+PMSET=/usr/bin/pmset
+DATE=/bin/date
+SHUTDOWN=/sbin/shutdown
+SYSTEM_PROFILER=/usr/sbin/system_profiler
+
+# ---------------------------------------------------------------------------
+# 0. arguments / environment
+# ---------------------------------------------------------------------------
+DRY_RUN=0
+SIM=0
+LOGBASE="${M4A2_LOGBASE:-/Library/XeGfxTrial}"
+SELF="m4a2-bootguard"
+
+usage() {
+    cat <<'EOF'
+Usage: m4a2-bootguard.sh [--dry-run] [--logdir DIR]
+
+  --dry-run     print mutating commands instead of executing them
+                (nvram writes, shutdown, launchctl); read-only probes still run
+  --logdir DIR  base directory for m4a2-run-*/m4a2-fail-*/m4a2-ok-* artifacts
+  --help        this text
+
+Normally installed as a root LaunchDaemon; run without arguments.
+EOF
+}
+
+while [ $# -gt 0 ]; do
+    case "$1" in
+        --dry-run)  DRY_RUN=1 ;;
+        --logdir)   shift; [ $# -gt 0 ] && LOGBASE=$1 ;;
+        -h|--help)  usage; exit 0 ;;
+        *)          echo "$SELF: unknown argument: $1" >&2; exit 2 ;;
+    esac
+    shift
+done
+
+if [ "${M4A2_SIM:-0}" = "1" ]; then
+    SIM=1
+    DRY_RUN=1
+fi
+
+# Deadlines/heuristics: production values.  In SIM mode default to fast
+# values unless the caller overrode them (dry-run tests must finish quickly).
+if [ "$SIM" = 1 ]; then
+    DEADLINE_CORE=${M4A2_DEADLINE_CORE:-2}
+    DEADLINE_NUB=${M4A2_DEADLINE_NUB:-3}
+    DEADLINE_FB=${M4A2_DEADLINE_FB:-4}
+    DEADLINE_OPEN=${M4A2_DEADLINE_OPEN:-5}
+    DEADLINE_WS=${M4A2_DEADLINE_WS:-6}
+    POLL=${M4A2_POLL:-1}
+    # The settle window must span more than WS_MAX_CRASH poll ticks, otherwise
+    # the fail-ws-crash injection can never reach the crash limit before the
+    # window closes (WS_MAX_CRASH defaults to 3, POLL to 1 -> 4s window).
+    WS_SETTLE=${M4A2_WS_SETTLE:-$(( ${M4A2_WS_MAX_CRASH:-3} + 1 ))}
+else
+    DEADLINE_CORE=${M4A2_DEADLINE_CORE:-20}
+    DEADLINE_NUB=${M4A2_DEADLINE_NUB:-60}
+    DEADLINE_FB=${M4A2_DEADLINE_FB:-90}
+    DEADLINE_OPEN=${M4A2_DEADLINE_OPEN:-120}
+    DEADLINE_WS=${M4A2_DEADLINE_WS:-180}
+    POLL=${M4A2_POLL:-2}
+    WS_SETTLE=${M4A2_WS_SETTLE:-90}
+fi
+WS_MAX_CRASH=${M4A2_WS_MAX_CRASH:-3}
+CLAIM_T_MAX=${M4A2_CLAIM_T_MAX:-130}
+CLAIM_NODE_GRACE=${M4A2_CLAIM_NODE_GRACE:-45}
+RETRY_ONCE=${M4A2_RETRY_ONCE:-1}
+MAX_STARTS=3
+BOOTLOG="$LOGBASE/boot-stage.log"
+
+# ---------------------------------------------------------------------------
+# 1. root / log directory
+# ---------------------------------------------------------------------------
+if [ "$(id -u)" -ne 0 ] && [ "$DRY_RUN" != 1 ]; then
+    echo "$SELF: must run as root (or pass --dry-run)" >&2
+    exit 0
+fi
+if [ "$DRY_RUN" = 1 ] && [ "$(id -u)" -ne 0 ] && [ "$LOGBASE" = "/Library/XeGfxTrial" ]; then
+    LOGBASE="/tmp/m4a2-bootguard-dryrun"
+fi
+
+STAMP="$($DATE +%Y%m%d-%H%M%S)"
+BOOT_UUID="$($SYSCTL -n kern.bootsessionuuid 2>/dev/null || echo unknown)"
+[ "$SIM" = 1 ] && [ -n "${M4A2_SIM_BOOT_UUID:-}" ] && BOOT_UUID=$M4A2_SIM_BOOT_UUID
+LOG="$LOGBASE/m4a2-run-$STAMP"
+mkdir -p "$LOGBASE" 2>/dev/null || {
+    echo "$SELF: cannot create $LOGBASE" >&2
+    exit 0
+}
+mkdir -p "$LOG" 2>/dev/null || {
+    echo "$SELF: cannot create $LOG" >&2
+    exit 0
+}
+exec >>"$LOG/bootguard.log" 2>&1
+
+log() { echo "[${STAMP} +$(elapsed)s] $*"; }
+START_EPOCH=$($DATE +%s)
+elapsed() { echo $(( $($DATE +%s) - START_EPOCH )); }
+
+log "==== $SELF start (pid $$) ===="
+log "boot=${BOOT_UUID} dry_run=${DRY_RUN} sim=${SIM} logdir=${LOG}"
+log "deadlines core=${DEADLINE_CORE}s nub=${DEADLINE_NUB}s fb=${DEADLINE_FB}s open=${DEADLINE_OPEN}s ws=${DEADLINE_WS}s; claim_t_max=${CLAIM_T_MAX}; ws_settle=${WS_SETTLE}s max_crashes=${WS_MAX_CRASH}"
+
+# Flush only our own file, with a deadline. Global sync can wait for unrelated
+# APFS/mount work while driver matching is stalled and stop the watchdog itself.
+flush_file() {
+    [ "$DRY_RUN" = 1 ] && return 0
+    /usr/bin/python3 "${M4A2_PROBE_HELPER:-/usr/local/xegfx/m3db-bounded-probe.py}" \
+        5 "$LOG/file-flush-timeout" -- /usr/bin/python3 -c \
+        'import os,sys; f=open(sys.argv[1], "rb"); os.fsync(f.fileno())' "$1"
+}
+
+# boot-stage.log is the black-screen postmortem trail (docs/18 §2): append +
+# flush every line.  Failure to write there is not fatal (diag copy has it).
+boot_stage_log() {
+    printf '%s %s: %s\n' "$($DATE '+%F %T')" "$SELF" "$*" >>"$BOOTLOG" 2>/dev/null
+    flush_file "$BOOTLOG" || log "boot-stage trail flush exceeded deadline"
+}
+
+# ---------------------------------------------------------------------------
+# 2. NVRAM gate helpers (4-byte LE, nvram(8))
+# ---------------------------------------------------------------------------
+u32_to_raw() {
+    printf '%%%02X%%%02X%%%02X%%%02X' \
+        $(( $1 & 0xFF )) $(( ($1 >> 8) & 0xFF )) \
+        $(( ($1 >> 16) & 0xFF )) $(( ($1 >> 24) & 0xFF ))
+}
+
+# echo the number (empty on parse failure/absent key); raw form is %XX%XX...
+u32_from_raw() {
+    [ -z "$1" ] && return 1
+    _hex=$(printf '%s' "$1" | tr -d '%')
+    _val=0
+    _shift=0
+    while [ -n "$_hex" ]; do
+        _b=${_hex:0:2}
+        _hex=${_hex:2}
+        case "$_b" in
+            [0-9A-Fa-f][0-9A-Fa-f]) ;;
+            *) return 1 ;;
+        esac
+        _val=$(( _val + 0x$_b * (1 << _shift) ))
+        _shift=$(( _shift + 8 ))
+        [ "$_shift" -ge 32 ] && break
+    done
+    echo "$_val"
+    return 0
+}
+
+# Raw gate value.  SIM mode synthesizes an armed claim trial unless
+# M4A2_SIM_GATE=off was requested.
+gate_raw() {
+    if [ "$SIM" = 1 ]; then
+        if [ "${M4A2_SIM_GATE:-on}" = "off" ] && [ "$1" != "xegfx-disp-fail" ]; then
+            case "$1" in
+                xegfx-disp-phase) echo '%00%00%00%00' ;;
+                xegfx-disp-trial) echo '%00%00%00%00' ;;
+                *) echo '%00%00%00%00' ;;
+            esac
+            return 0
+        fi
+        case "$1" in
+            xegfx-disp-phase)  echo '%02%00%00%00' ;;
+            xegfx-disp-trial)  echo '%01%00%00%00' ;;
+            xegfx-disp-fail)   echo "${M4A2_SIM_FAIL_RAW:-%00%00%00%00}" ;;
+            xegfx-disp-starts) echo "${M4A2_SIM_STARTS_RAW:-%00%00%00%00}" ;;
+            xegfx-disp-bootarm) echo "${M4A2_SIM_BOOTARM_RAW:-%00%00%00%00}" ;;
+            *) echo '' ;;
+        esac
+        return 0
+    fi
+    $NVRAM "$1" 2>/dev/null | awk -F'\t' '{print $2}'
+}
+
+gate_num() { # name default
+    _raw=$(gate_raw "$1")
+    if [ -z "$_raw" ]; then
+        echo "${2:-0}"
+        return 0
+    fi
+    _n=$(u32_from_raw "$_raw") || { echo "${2:-0}"; return 0; }
+    echo "${_n:-0}"
+}
+
+GATE_PHASE=0 GATE_TRIAL=0 GATE_FAIL=0 GATE_STARTS=0 GATE_BOOTARM=0
+read_gates() {
+    GATE_PHASE=$(gate_num xegfx-disp-phase 0)
+    GATE_TRIAL=$(gate_num xegfx-disp-trial 0)
+    GATE_FAIL=$(gate_num xegfx-disp-fail 0)
+    GATE_STARTS=$(gate_num xegfx-disp-starts 0)
+    GATE_BOOTARM=$(gate_num xegfx-disp-bootarm 0)
+}
+
+nv_set_u32() { # name value  (the only NVRAM writer in this daemon)
+    _name=$1
+    _val=$2
+    _raw=$(u32_to_raw "$_val")
+    if [ "$DRY_RUN" = 1 ]; then
+        [ "${M4A2_SIM_NV_FAIL:-}" = "$_name" ] && { log "[SIM] nvram write rejected"; return 1; }
+        log "[DRY] nvram $_name=$_raw (u32=$_val)"
+        printf '%s [DRY] %s=%s (u32=%s)\n' "$($DATE '+%F %T')" "$_name" "$_raw" "$_val" \
+            >>"$LOG/nvram-writes.log" 2>/dev/null
+        return 0
+    fi
+    printf '%s %s=%s (u32=%s)\n' "$($DATE '+%F %T')" "$_name" "$_raw" "$_val" \
+        >>"$LOG/nvram-writes.log" 2>/dev/null
+    log "nvram write $_name=$_raw (u32=$_val)"
+    $NVRAM "$_name=$_raw" >/dev/null 2>&1 || {
+        log "ERROR: nvram write failed for $_name"
+        return 1
+    }
+    [ "$(gate_raw "$_name")" = "$_raw" ] || {
+        log "ERROR: nvram readback mismatch for $_name"; return 1;
+    }
+    return 0
+}
+
+# ---------------------------------------------------------------------------
+# 3. read-only probes
+# ---------------------------------------------------------------------------
+ioreg_bounded() {
+    /usr/bin/python3 "${M4A2_PROBE_HELPER:-/usr/local/xegfx/m3db-bounded-probe.py}" \
+        "${M4A2_PROBE_TIMEOUT:-20}" "$LOG/probe-timeout" -- "$IOREG" "$@"
+}
+
+ioreg_count() { # className -> number of nodes of that exact class
+    _c=$(ioreg_bounded -l -w0 -r -c "$1" 2>/dev/null | grep -c "class $1")
+    [ -n "${_c:-}" ] || _c=0
+    echo "$_c"
+}
+
+as_bool() {
+    case "${1:-}" in
+        Yes|YES|yes|true|TRUE|1) echo 1 ;;
+        *) echo 0 ;;
+    esac
+}
+
+digits() { printf '%s' "${1:-}" | tr -dc '0-9'; }
+
+# One ioreg call per poll for all claim-node attributes (docs/19 §4.3/§5).
+CLAIM_PRESENT=0 CLAIM_STATE='' CLAIM_T='' CLAIM_POLL='' CLAIM_REASON=''
+CLAIM_REG='' CLAIM_OPENED='' CLAIM_CORE='' CLAIM_NUB='' CLAIM_FB=''
+claim_snapshot() {
+    CLAIM_PRESENT=0
+    CLAIM_STATE='' CLAIM_T='' CLAIM_POLL='' CLAIM_REASON=''
+    CLAIM_REG='' CLAIM_OPENED='' CLAIM_CORE='' CLAIM_NUB='' CLAIM_FB=''
+    if [ "$SIM" = 1 ]; then
+        CLAIM_PRESENT=1
+        if [ "${M4A2_SIM_SCENARIO:-}" = "fail-registry-probe" ]; then
+            echo "simulated IORegistry timeout" >"$LOG/probe-timeout"
+            return 0
+        fi
+        case "${M4A2_SIM_CLAIM:-}" in
+            failed)
+                CLAIM_STATE=failed; CLAIM_POLL=done; CLAIM_REASON=fb-not-opened
+                CLAIM_T=$(elapsed)
+                ;;
+            unavailable)
+                CLAIM_STATE=claimed; CLAIM_POLL=unavailable
+                CLAIM_T=$(elapsed)
+                ;;
+            stuck)
+                CLAIM_STATE=waiting-nub; CLAIM_POLL=armed
+                CLAIM_T=999
+                ;;
+            *)
+                CLAIM_T=$(elapsed)
+                CLAIM_POLL=armed
+                if sim_stage_reached 4; then
+                    CLAIM_STATE=ready; CLAIM_REG=Yes; CLAIM_OPENED=Yes
+                    CLAIM_CORE=Yes; CLAIM_NUB=Yes; CLAIM_FB=Yes
+                elif sim_stage_reached 3; then
+                    CLAIM_STATE=waiting-fb; CLAIM_REG=No; CLAIM_OPENED=No
+                    CLAIM_CORE=Yes; CLAIM_NUB=Yes; CLAIM_FB=No
+                elif sim_stage_reached 2; then
+                    CLAIM_STATE=waiting-nub; CLAIM_REG=No; CLAIM_OPENED=No
+                    CLAIM_CORE=Yes; CLAIM_NUB=No; CLAIM_FB=No
+                else
+                    CLAIM_STATE=claimed; CLAIM_REG=No; CLAIM_OPENED=No
+                    CLAIM_CORE=No; CLAIM_NUB=No; CLAIM_FB=No
+                fi
+                ;;
+        esac
+        return 0
+    fi
+    _out=$(ioreg_bounded -l -w0 -r -c XeGfxFBClaim 2>/dev/null)
+    [ -n "$_out" ] || return 0
+    CLAIM_PRESENT=1
+    CLAIM_STATE=$(_claim_attr "$_out" xegfx-fb-claim-state)
+    CLAIM_T=$(digits "$(_claim_attr "$_out" xegfx-fb-claim-t)")
+    CLAIM_POLL=$(_claim_attr "$_out" xegfx-fb-claim-poll)
+    CLAIM_REASON=$(_claim_attr "$_out" xegfx-fb-claim-reason)
+    CLAIM_REG=$(_claim_attr "$_out" xegfx-fb-claim-registered)
+    CLAIM_OPENED=$(_claim_attr "$_out" xegfx-fb-claim-opened)
+    CLAIM_CORE=$(_claim_attr "$_out" xegfx-fb-claim-core)
+    CLAIM_NUB=$(_claim_attr "$_out" xegfx-fb-claim-nub)
+    CLAIM_FB=$(_claim_attr "$_out" xegfx-fb-claim-fb)
+    return 0
+}
+
+_claim_attr() { # ioreg-dump attr-name -> value without quotes
+    printf '%s\n' "$1" | sed -n "s/.*\"$2\" = //p" | head -1 | tr -d '"' | tr -d '\r'
+}
+
+# SIM stage model: 1=core,2=nub,3=fb,4=open,5=ws.  A scenario can hide all
+# stages above its limit; that is how fail-core..fail-ws are injected.
+SIM_MAX_STAGE=5
+case "${M4A2_SIM_SCENARIO:-ok}" in
+    fail-core)    SIM_MAX_STAGE=0 ;;
+    fail-nub)     SIM_MAX_STAGE=1 ;;
+    fail-fb)      SIM_MAX_STAGE=2 ;;
+    fail-open)    SIM_MAX_STAGE=3 ;;
+    fail-ws)      SIM_MAX_STAGE=4 ;;
+    fail-ws-crash) SIM_MAX_STAGE=5 ;;
+    ok|*)         SIM_MAX_STAGE=5 ;;
+esac
+sim_stage_reached() {
+    [ "$SIM" = 1 ] || return 1
+    [ "$1" -le "$SIM_MAX_STAGE" ] || return 1
+    [ "$(elapsed)" -ge "$1" ]
+}
+
+probe_core_loaded() {
+    if [ "$SIM" = 1 ]; then sim_stage_reached 1; return $?; fi
+    /usr/bin/kmutil showloaded 2>/dev/null | grep -q 'org.watchthelight.XeGfx (' && return 0
+    [ "$(ioreg_count XeGfxResident)" -gt 0 ] && return 0
+    return 1
+}
+
+probe_nub_published() {
+    if [ "$SIM" = 1 ]; then
+        sim_stage_reached 2
+        return $?
+    fi
+    [ "$(ioreg_count XeGfxDisplayNub)" -gt 0 ] && return 0
+    return 1
+}
+
+probe_fb_registered() {
+    if [ "$SIM" = 1 ]; then
+        sim_stage_reached 3
+        return $?
+    fi
+    ioreg_bounded -l -w0 -r -c XeGfxFramebuffer 2>/dev/null | grep -q '"XeGfxFbRegistered" = Yes' && return 0
+    return 1
+}
+
+probe_fb_opened() {
+    if [ "$SIM" = 1 ]; then
+        sim_stage_reached 4
+        return $?
+    fi
+    if [ -n "${CLAIM_OPENED:-}" ] && [ "$(as_bool "$CLAIM_OPENED")" = 1 ]; then
+        return 0
+    fi
+    _out=$(ioreg_bounded -l -w0 -r -c XeGfxFramebuffer 2>/dev/null)
+    if [ -n "$_out" ]; then
+        _opened=$(printf '%s\n' "$_out" | sed -n 's/.*"XeGfxFbOpened" = //p' | head -1 | tr -d '"')
+        [ -n "$_opened" ] && [ "$(as_bool "$_opened")" = 1 ] && return 0
+        _cnt=$(printf '%s\n' "$_out" | sed -n 's/.*"XeGfxFbOpenCount" = //p' | head -1)
+        _cnt=$(digits "$_cnt")
+        [ -n "$_cnt" ] && [ "$_cnt" -gt 0 ] && return 0
+    fi
+    return 1
+}
+
+ws_pid() { pgrep -x WindowServer 2>/dev/null | head -1; }
+
+probe_ws_up() {
+    if [ "$SIM" = 1 ]; then sim_stage_reached 5; return $?; fi
+    [ -n "$(ws_pid)" ] && return 0
+    return 1
+}
+
+native_display_present() {
+    if [ "$SIM" = 1 ]; then return 1; fi
+    [ "$(ioreg_count IONDRVFramebuffer)" -gt 0 ] && return 0
+    return 1
+}
+
+# ---------------------------------------------------------------------------
+# 4. diagnosis capture (bounded: failure path has ~60 s before the reboot)
+# ---------------------------------------------------------------------------
+capture_diag() { # destdir budget-seconds
+    _d=$1
+    _budget=$2
+    _t0=$(elapsed)
+    mkdir -p "$_d" 2>/dev/null || return 1
+    _left() { echo $(( _budget - ( $(elapsed) - _t0 ) )); }
+    _own() { # output-file command...
+        _of=$1
+        shift
+        [ "$(_left)" -le 0 ] && return 1
+        "$@" >"$_d/$_of" 2>&1
+    }
+
+    # Preserve the first real crash before slower registry probes consume the
+    # fallback's capture budget. Old boots and synthetic probes are excluded.
+    _report_helper=${M4A2_REPORT_HELPER:-/usr/local/xegfx/m3db-ws-report.py}
+    if [ -f "$_report_helper" ] && [ "$(_left)" -gt 0 ]; then
+        _own ws-report-capture.txt /usr/bin/python3 "${M4A2_PROBE_HELPER:-/usr/local/xegfx/m3db-bounded-probe.py}" \
+            4 "$_d/ws-report.timeout" -- /usr/bin/python3 "$_report_helper" "$_d" "$BOOT_UUID"
+    fi
+    if [ "$(_left)" -gt 0 ]; then
+        _own windowserver.log /usr/bin/python3 "${M4A2_PROBE_HELPER:-/usr/local/xegfx/m3db-bounded-probe.py}" \
+            5 "$_d/windowserver-log.timeout" -- /usr/bin/log show --last 8m --style compact --info --debug \
+            --predicate 'process == "WindowServer" OR process == "ReportCrash" OR process == "osanalyticshelper"'
+    fi
+    _own claim.txt            ioreg_bounded -l -w0 -r -c XeGfxFBClaim
+    _own nub.txt              ioreg_bounded -l -w0 -r -c XeGfxDisplayNub
+    _own resident.txt         ioreg_bounded -l -w0 -r -c XeGfxResident
+    _own framebuffer.txt      ioreg_bounded -l -w0 -r -c IOFramebuffer
+    _own xegfx-fb.txt         ioreg_bounded -l -w0 -r -c XeGfxFramebuffer
+    _own intelfb.txt          ioreg_bounded -l -w0 -r -c XeGfxIntelFramebuffer
+    [ "$(_left)" -gt 0 ] && ioreg_bounded -l -w0 -r -c IOResources 2>/dev/null \
+        | grep -E '"(XeGfx|NMXAccel|xegfx-)' >"$_d/ioresources-xegfx.txt" 2>&1
+    _own showloaded.txt       /usr/bin/kmutil showloaded
+    [ "$(_left)" -gt 0 ] && $SYSCTL debug 2>/dev/null | grep -i 'xegfx' >"$_d/sysctl-xegfx.txt" 2>&1
+    [ "$(_left)" -gt 0 ] && $NVRAM -x -p 2>/dev/null | grep -i -E 'xegfx|xeintelfb' \
+        >"$_d/nvram-gates.plist" 2>&1
+    [ "$(_left)" -gt 0 ] && /usr/bin/log show --last 15m --style compact \
+        --predicate 'process == "kernel"' 2>/dev/null \
+        | grep -E 'XEGFX_DISPLAY|XeGfx|NMXAccel|XEGFX' >"$_d/kernel.log" 2>&1
+    _own ps.txt               /bin/ps axu
+    [ "$(_left)" -gt 0 ] && ps axu 2>/dev/null | grep -E 'WindowServer|loginwindow' \
+        >"$_d/ws.txt" 2>&1
+    [ "$(_left)" -gt 0 ] && $SYSTEM_PROFILER SPDisplaysDataType >"$_d/displays.txt" 2>&1
+    [ "$(_left)" -gt 0 ] && [ -f "$BOOTLOG" ] && tail -40 "$BOOTLOG" >"$_d/boot-stage-tail.txt" 2>&1
+    log "diag captured in $_d ($(ls "$_d" 2>/dev/null | wc -l | tr -d ' ') files)"
+    return 0
+}
+
+# ---------------------------------------------------------------------------
+# 5. reboot (single-shot per boot session)
+# ---------------------------------------------------------------------------
+maybe_reboot() { # reason
+    _why=$1
+    _marker="$LOGBASE/.m4a2-reboot-asked"
+    if [ -f "$_marker" ]; then
+        _old=$(cat "$_marker" 2>/dev/null)
+        if [ "${_old:-}" = "$BOOT_UUID" ]; then
+            log "reboot suppressed: already scheduled once for boot ${BOOT_UUID}"
+            return 1
+        fi
+    fi
+    echo "$BOOT_UUID" >"$_marker" 2>/dev/null || { log "ERROR: cannot persist reboot marker"; return 1; }
+    flush_file "$_marker" || log "reboot marker flush exceeded deadline; gates already verified"
+    if [ "$DRY_RUN" = 1 ]; then
+        log "[DRY] $SHUTDOWN -r +1 ($_why)"
+        return 0
+    fi
+    log "scheduling reboot in 60 s ($_why)"
+    $SHUTDOWN -r +1 >/dev/null 2>&1
+}
+
+TICKET="$LOGBASE/.m4a2-boot-ticket"
+TICKET_OWNED=0
+finish() { # result
+    echo "RESULT=$1" >"$LOG/RESULT" 2>/dev/null
+    # m3d-b: a terminal result (ok or fail) settles this boot's ticket.
+    if [ "$TICKET_OWNED" = 1 ] && [ "${KEEP_TICKET:-0}" != 1 ]; then
+        rm -f "$TICKET" 2>/dev/null || true
+        log "boot ticket settled ($1)"
+    fi
+    log "bootguard exit: $1"
+    flush_file "$LOG/RESULT" || true
+    exit 0
+}
+
+# ---------------------------------------------------------------------------
+# 6. failure path (docs/19 §8.2/§8.3, docs/20 §3)
+# ---------------------------------------------------------------------------
+fail_run() { # reason [detail]
+    _reason=$1
+    _detail=${2:-}
+    E=$(elapsed)
+    log "FAILURE reason=${_reason} detail=${_detail}"
+    log "  elapsed=${E}s claim: state=${CLAIM_STATE:-?} t=${CLAIM_T:-?} poll=${CLAIM_POLL:-?} reason=${CLAIM_REASON:-?}"
+    log "  stages: core=${T_CORE:-none} nub=${T_NUB:-none} fb=${T_FB:-none} open=${T_OPEN:-none} ws=${T_WS:-none}"
+    boot_stage_log "FAIL reason=${_reason} detail=${_detail} elapsed=${E}s claim_state=${CLAIM_STATE:-?} claim_t=${CLAIM_T:-?} stages core=${T_CORE:-none} nub=${T_NUB:-none} fb=${T_FB:-none} open=${T_OPEN:-none} ws=${T_WS:-none}"
+
+    # ---- attempt accounting (docs/19 §8.4: do not double count starts) ----
+    _starts_now=$(gate_num xegfx-disp-starts 0)
+    if [ "$_starts_now" -gt "$GATE_STARTS" ]; then
+        _starts=$_starts_now
+        _bumped=" (s3-watchdog already bumped it)"
+    else
+        _starts=$(( _starts_now + 1 ))
+        _bumped=""
+    fi
+    [ "$_starts" -lt 1 ] && _starts=1
+    [ "$_starts" -gt "$MAX_STARTS" ] && _starts=$MAX_STARTS
+
+    _faildir="$LOGBASE/m4a2-fail-$STAMP"
+    mkdir -p "$_faildir" 2>/dev/null || _faildir="$LOG"
+    {
+        echo "result=fail"
+        echo "reason=$_reason"
+        echo "detail=$_detail"
+        echo "stamp=$STAMP"
+        echo "boot_uuid=$BOOT_UUID"
+        echo "elapsed_s=$E"
+        echo "claim_state=${CLAIM_STATE:-?}"
+        echo "claim_t=${CLAIM_T:-?}"
+        echo "claim_poll=${CLAIM_POLL:-?}"
+        echo "claim_reason=${CLAIM_REASON:-?}"
+        echo "stage_core=${T_CORE:-0}"
+        echo "stage_nub=${T_NUB:-0}"
+        echo "stage_fb=${T_FB:-0}"
+        echo "stage_open=${T_OPEN:-0}"
+        echo "stage_ws=${T_WS:-0}"
+        echo "gates_before phase=${GATE_PHASE} trial=${GATE_TRIAL} starts=${GATE_STARTS} fail=${GATE_FAIL} bootarm=${GATE_BOOTARM}"
+        echo "starts_now=$_starts_now starts_after=$_starts${_bumped}"
+        echo "retry_once=$RETRY_ONCE"
+    } >"$_faildir/summary.txt" 2>/dev/null
+    cp "$LOG/bootguard.log" "$_faildir/bootguard.log" 2>/dev/null || true
+    cp "$LOG/nvram-writes.log" "$_faildir/nvram-writes.log" 2>/dev/null || true
+
+    # ---- gate updates + one reboot ---------------------------------------
+    _writes_ok=1
+    if [ "$RETRY_ONCE" = "1" ] && [ "$_starts_now" -eq 0 ] &&
+       [ "$_starts" -ge 1 ] && [ "$_starts" -lt "$MAX_STARTS" ]; then
+        _action="retry-once"
+        nv_set_u32 xegfx-disp-starts "$_starts" || _writes_ok=0
+        # keep phase=2/trial=1/fail=0 so the next boot retries the claim path
+        boot_stage_log "action=retry-once starts=${_starts}/${MAX_STARTS} next-boot=claim"
+        echo "action=$_action" >>"$_faildir/summary.txt" 2>/dev/null
+        echo "RESULT=$_action" >"$_faildir/RESULT" 2>/dev/null
+        [ "$_writes_ok" = 1 ] || { KEEP_TICKET=1; finish gate-write-failed-no-reboot; }
+        maybe_reboot "claim attempt $_starts failed; retrying once" || { KEEP_TICKET=1; finish reboot-request-failed; }
+        log "retry-once armed: starts=${_starts} phase=${GATE_PHASE} trial=1; rebooting"
+    else
+        _action="reverted-to-intelfb"
+        nv_set_u32 xegfx-disp-starts "$_starts" || _writes_ok=0
+        nv_set_u32 xegfx-disp-trial 0 || _writes_ok=0
+        nv_set_u32 xegfx-disp-fail 1 || _writes_ok=0
+        nv_set_u32 xegfx-disp-phase 1 || _writes_ok=0
+        nv_set_u32 xegfx-disp-bootarm 0 || _writes_ok=0
+        # Scheduling a reboot is not evidence that fallback actually booted.
+        KEEP_TICKET=1
+        echo "fallback_verified=0" >>"$_faildir/summary.txt"
+        boot_stage_log "action=fallback-requested starts=${_starts}/${MAX_STARTS} trial=0 fail=1 phase=1; next boot must verify persistence"
+        echo "action=$_action" >>"$_faildir/summary.txt" 2>/dev/null
+        echo "RESULT=$_action" >"$_faildir/RESULT" 2>/dev/null
+        [ "$_writes_ok" = 1 ] || { KEEP_TICKET=1; finish gate-write-failed-no-reboot; }
+        maybe_reboot "claim takeover failed; falling back to XeGfxIntelFB" || { KEEP_TICKET=1; finish reboot-request-failed; }
+        log "FALLBACK requested: starts=${_starts} trial=0 fail=1 phase=1; ticket retained, recovery not yet verified"
+    fi
+
+    # ---- best effort diagnostics (after the reboot is already scheduled) --
+    # Dry-run tests do not need the slow captures; production always does.
+    if [ "$SIM" = 1 ] && [ "${M4A2_SIM_DIAG:-1}" = "0" ]; then
+        log "diag capture skipped (M4A2_SIM_DIAG=0)"
+    else
+        capture_diag "$_faildir/diag" 45
+    fi
+    finish "$_action"
+}
+
+# ---------------------------------------------------------------------------
+# 7. success path (docs/18 acceptance, docs/20 §4)
+# ---------------------------------------------------------------------------
+success_run() {
+    if [ "$SIM" != 1 ]; then
+        /usr/bin/python3 "${M4A2_PROBE_HELPER:-/usr/local/xegfx/m3db-bounded-probe.py}" \
+            30 "$LOG/health-timeout" -- /usr/bin/python3 \
+            "${M4A2_HEALTH_CHECK:-/usr/local/xegfx/m3db-health.py}" >"$LOG/claim-health.json" 2>&1 ||
+            fail_run health-check-failed "claim health probe failed or exceeded its 30s deadline"
+    fi
+    # First-trial policy: success preserves this boot's live display, but the
+    # next boot falls back unless the operator deliberately arms another trial.
+    if [ "${M4A2_DISARM_ON_SUCCESS:-0}" = 1 ]; then
+        _safe_ok=1
+        nv_set_u32 xegfx-disp-trial 0 || _safe_ok=0
+        nv_set_u32 xegfx-disp-fail 1 || _safe_ok=0
+        nv_set_u32 xegfx-disp-phase 1 || _safe_ok=0
+        [ "$_safe_ok" = 1 ] || { KEEP_TICKET=1; finish success-disarm-failed; }
+    fi
+    E=$(elapsed)
+    _okfile="$LOGBASE/m4a2-ok-$STAMP.log"
+    _console=$(stat -f '%Su' /dev/console 2>/dev/null || echo unknown)
+    {
+        echo "result=ok"
+        echo "stamp=$STAMP"
+        echo "boot_uuid=$BOOT_UUID"
+        echo "elapsed_s=$E"
+        echo "stage_core_s=${T_CORE:-0}"
+        echo "stage_nub_s=${T_NUB:-0}"
+        echo "stage_fb_s=${T_FB:-0}"
+        echo "stage_open_s=${T_OPEN:-0}"
+        echo "stage_ws_s=${T_WS:-0}"
+        echo "ws_pid=${WS_FINAL_PID:-?}"
+        echo "ws_restarts=$WS_RESTARTS"
+        echo "ws_settle_s=$WS_SETTLE"
+        echo "claim_state=${CLAIM_STATE:-?}"
+        echo "claim_t=${CLAIM_T:-?}"
+        echo "claim_reason=${CLAIM_REASON:-?}"
+        echo "console_user=$_console"
+        echo "gates phase=${GATE_PHASE} trial=${GATE_TRIAL} starts=${GATE_STARTS} fail=${GATE_FAIL} bootarm=${GATE_BOOTARM}"
+        echo "timing_source=$(ioreg_bounded -l -w0 -r -c XeGfxDisplayNub 2>/dev/null | sed -n 's/.*"XeGfxTimingSource" = //p' | head -1 | tr -d '\"')"
+    } >"$_okfile" 2>/dev/null
+    boot_stage_log "OK stages core=${T_CORE:-0}s nub=${T_NUB:-0}s fb=${T_FB:-0}s open=${T_OPEN:-0}s ws=${T_WS:-0}s ws_restarts=${WS_RESTARTS} claim_state=${CLAIM_STATE:-?} ok_file=$(basename "$_okfile")"
+    log "SUCCESS: claim takeover is up; WindowServer stable for ${WS_SETTLE}s (${WS_RESTARTS} restart(s))"
+    log "ok artifact: $_okfile"
+    finish ok
+}
+
+# ---------------------------------------------------------------------------
+# 8. gate check
+# ---------------------------------------------------------------------------
+# Arming can bootstrap this job in an already accelerated manual boot. Do not
+# treat that boot as a cold claim trial even if gate writes happen immediately.
+if [ -n "${M4A2_ARMED_FROM_BOOT:-}" ] && [ "$M4A2_ARMED_FROM_BOOT" = "$BOOT_UUID" ]; then
+    if [ -n "${M4A2_PENDING_ACK:-}" ]; then
+        printf '%s\n' "$BOOT_UUID" > "$M4A2_PENDING_ACK" || finish pending-ack-failed
+        flush_file "$M4A2_PENDING_ACK" || finish pending-ack-flush-failed
+    fi
+    finish pending-reboot
+fi
+read_gates
+log "gates: phase=${GATE_PHASE} trial=${GATE_TRIAL} starts=${GATE_STARTS} fail=${GATE_FAIL} bootarm=${GATE_BOOTARM}"
+
+# m3d-b: with the claim not armed this boot, an unsettled ticket from an
+# earlier boot is evidence only (the operator or Recovery already disarmed);
+# archive it so the next armed boot does not inherit it.
+if { [ "$GATE_PHASE" != "2" ] || [ "$GATE_TRIAL" != "1" ] || [ "$GATE_FAIL" != "0" ] ||
+     [ "$GATE_STARTS" -ge "$MAX_STARTS" ]; } && [ -f "$TICKET" ]; then
+    _tk_boot=$(sed -n 's/^boot_uuid=//p' "$TICKET" 2>/dev/null | head -1)
+    if [ "${_tk_boot:-}" != "$BOOT_UUID" ]; then
+        mv "$TICKET" "$LOG/stale-ticket.txt" 2>/dev/null || rm -f "$TICKET" 2>/dev/null
+        log "archived unsettled ticket of boot ${_tk_boot:-?} (claim not armed this boot)"
+        boot_stage_log "previous claim boot ${_tk_boot:-?} never settled (seen with gates off; ticket archived in $(basename "$LOG"))"
+    fi
+fi
+
+if [ "$GATE_PHASE" != "2" ]; then
+    log "not a claim boot (phase=${GATE_PHASE} != 2); nothing to guard"
+    finish gate-off-phase
+fi
+if [ "$GATE_TRIAL" != "1" ]; then
+    log "claim trial disarmed (trial=${GATE_TRIAL} != 1); nothing to guard"
+    finish gate-off-trial
+fi
+if [ "$GATE_FAIL" != "0" ]; then
+    log "fail gate pulled (fail=${GATE_FAIL} != 0); nothing to guard"
+    # If a failure artifact from an earlier boot exists, this boot is the
+    # automatic fallback the previous bootguard asked for.  Record that the
+    # rollback really happened (no NVRAM write: gates already armed safe).
+    _last_fail=$(ls -dt "$LOGBASE"/m4a2-fail-* 2>/dev/null | head -1)
+    if [ -n "${_last_fail:-}" ]; then
+        _rev="$LOGBASE/m4a2-reverted-$STAMP.log"
+        {
+            echo "result=reverted"
+            echo "stamp=$STAMP"
+            echo "boot_uuid=$BOOT_UUID"
+            echo "previous_failure_dir=$_last_fail"
+            echo "gates phase=${GATE_PHASE} trial=${GATE_TRIAL} starts=${GATE_STARTS} fail=${GATE_FAIL}"
+            echo "native_framebuffer=$([ "$(ioreg_count IONDRVFramebuffer)" -gt 0 ] && echo present || echo absent)"
+            echo "note=claim gates are fail-safe; display is back on XeGfxIntelFB / native path"
+        } >"$_rev" 2>/dev/null
+        boot_stage_log "reverted: fail gate already set; IntelFB owns display (previous=$_last_fail)"
+        log "auto-revert confirmed; wrote $(basename "$_rev")"
+    fi
+    finish gate-off-fail
+fi
+if [ "$GATE_STARTS" -ge "$MAX_STARTS" ]; then
+    log "attempt budget exhausted (starts=${GATE_STARTS} >= ${MAX_STARTS}); nothing to guard"
+    finish gate-off-starts-exhausted
+fi
+if [ "$GATE_BOOTARM" != "0" ]; then
+    log "WARNING: M4a-1 bootarm flag is still set (bootarm=${GATE_BOOTARM});"
+    log "         recommend bootout com.xegfx.bootarm + nvram bootarm=0 before M4a-2 trials"
+fi
+
+log "claim boot confirmed; watching claim chain (test mode: sim=${SIM})"
+boot_stage_log "armed: watching claim chain phase=${GATE_PHASE} trial=${GATE_TRIAL} starts=${GATE_STARTS} fail=${GATE_FAIL}"
+
+# ---------------------------------------------------------------------------
+# 9. single instance lock
+# ---------------------------------------------------------------------------
+if [ "$DRY_RUN" != 1 ]; then
+    LOCK="$LOGBASE/.m4a2-bootguard.lock"
+    if ! mkdir "$LOCK" 2>/dev/null; then
+        _oldpid=$(cat "$LOCK/pid" 2>/dev/null || echo 0)
+        _oldboot=$(cat "$LOCK/boot_uuid" 2>/dev/null || echo unknown)
+        # A PID from a previous boot may now belong to an unrelated process.
+        # Only a live owner from this boot can suppress recovery.
+        if [ "$_oldboot" = "$BOOT_UUID" ] && [ "${_oldpid:-0}" -gt 0 ] && kill -0 "$_oldpid" 2>/dev/null; then
+            log "another bootguard instance is running (boot ${_oldboot}, pid ${_oldpid}); exiting"
+            finish already-running
+        fi
+        log "stale lock from boot ${_oldboot} pid ${_oldpid:-?}; taking it over"
+        rm -rf "$LOCK" 2>/dev/null || true
+        mkdir "$LOCK" 2>/dev/null || { log "cannot take lock; exiting"; finish lock-failed; }
+    fi
+    printf '%s\n' "$BOOT_UUID" >"$LOCK/boot_uuid" || { log "cannot persist lock boot UUID"; finish lock-failed; }
+    echo $$ >"$LOCK/pid" || { log "cannot persist lock PID"; finish lock-failed; }
+    # Do not remove a replacement owner's lock on late exit.
+    trap '[ "$(cat "$LOCK/pid" 2>/dev/null)" = "$$" ] && rm -rf "$LOCK" 2>/dev/null' EXIT
+fi
+
+# ---------------------------------------------------------------------------
+# 9b. boot ticket (covers failures after this daemon starts; pre-launchd panic still needs Recovery)
+# ---------------------------------------------------------------------------
+# A claim boot that panics or hangs before this daemon reaches a terminal
+# result never writes NVRAM, so macOS' automatic post-panic restart would
+# claim again with the same gates. This does not cover a panic before launchd
+# starts us. Every observed armed boot leaves a ticket here and removes it only in finish(). A
+# ticket from another boot session found at start means that boot never
+# settled: count it as a failure and revert to IntelFB without a retry.
+if [ -f "$TICKET" ]; then
+    _tk_boot=$(sed -n 's/^boot_uuid=//p' "$TICKET" 2>/dev/null | head -1)
+    _tk_stamp=$(sed -n 's/^stamp=//p' "$TICKET" 2>/dev/null | head -1)
+    if [ -n "${_tk_boot:-}" ] && [ "$_tk_boot" != "$BOOT_UUID" ]; then
+        log "previous claim boot ${_tk_boot} (bootguard ${_tk_stamp:-?}) never settled: panic, hang or power loss"
+        cp "$TICKET" "$LOG/stale-ticket.txt" 2>/dev/null || true
+        { echo "boot_uuid=$BOOT_UUID"; echo "stamp=$STAMP"; } >"$TICKET" 2>/dev/null
+        TICKET_OWNED=1
+        RETRY_ONCE=0
+        fail_run "previous-claim-boot-unfinished" "boot ${_tk_boot} left its ticket; no retry"
+    fi
+fi
+if { echo "boot_uuid=$BOOT_UUID"; echo "stamp=$STAMP"; } >"$TICKET" 2>/dev/null; then
+    TICKET_OWNED=1
+else
+    RETRY_ONCE=0
+    fail_run boot-ticket-write-failed "cannot persist claim attempt; revert instead of monitoring without a ticket"
+fi
+if ! flush_file "$TICKET"; then
+    RETRY_ONCE=0
+    fail_run boot-ticket-flush-timeout "cannot durably record trial within the file deadline"
+fi
+log "boot ticket written ($TICKET)"
+
+# ---------------------------------------------------------------------------
+# 10. stage watchdog
+# ---------------------------------------------------------------------------
+T_CORE='' T_NUB='' T_FB='' T_OPEN='' T_WS=''
+STAGE=0
+CLAIM_ABSENT_HITS=0
+
+# Failed if a stage deadline has passed both relative to this daemon and
+# relative to the claim itself (the claim node's own t is the boot reference).
+deadline_exceeded() { # deadline
+    [ "$(elapsed)" -ge "$1" ] || return 1
+    # Do not fail a stage while the claim node itself has not appeared yet:
+    # launchd may start us before the framebuffer probe publishes the claim
+    # (the claim node's own t is the true boot reference for every stage).
+    if [ "${CLAIM_PRESENT:-0}" = 0 ] && [ "$(elapsed)" -lt "$CLAIM_NODE_GRACE" ]; then
+        return 1
+    fi
+    if [ -n "${CLAIM_T:-}" ]; then
+        [ "$CLAIM_T" -ge "$1" ] || return 1
+    fi
+    return 0
+}
+
+while [ -z "$T_WS" ]; do
+    E=$(elapsed)
+    if [ -f "$LOG/probe-timeout" ]; then
+        fail_run registry-probe-timeout "IORegistry query did not return; stop waiting for the display service"
+    fi
+    claim_snapshot
+    if [ -f "$LOG/probe-timeout" ]; then
+        fail_run registry-probe-timeout "IORegistry query did not return; stop waiting for the display service"
+    fi
+
+    # --- claim node is authoritative: terminal states fail immediately -----
+    if [ "$CLAIM_PRESENT" = 0 ] && [ "$SIM" = 0 ]; then
+        CLAIM_ABSENT_HITS=$(( CLAIM_ABSENT_HITS + 1 ))
+        if [ "$E" -ge "$CLAIM_NODE_GRACE" ]; then
+            if native_display_present; then
+                log "claim absent with armed gates and native framebuffer; disarm future boots (AuxKC may be missing)"
+                _safe_ok=1
+                nv_set_u32 xegfx-disp-trial 0 || _safe_ok=0
+                nv_set_u32 xegfx-disp-fail 1 || _safe_ok=0
+                nv_set_u32 xegfx-disp-phase 1 || _safe_ok=0
+                nv_set_u32 xegfx-disp-bootarm 0 || _safe_ok=0
+                [ "$_safe_ok" = 1 ] || { KEEP_TICKET=1; finish claim-absent-disarm-failed; }
+                boot_stage_log "claim-declined: native FB present; future gates disarmed, no reboot"
+                finish claim-declined
+            fi
+            fail_run claim-node-absent "no XeGfxFBClaim node after ${E}s"
+        fi
+    fi
+    if [ -n "${CLAIM_STATE:-}" ] && [ "$CLAIM_STATE" = "failed" ]; then
+        fail_run "claim-failed-${CLAIM_REASON:-unknown}" "claim-final state=failed reason=${CLAIM_REASON:-?}"
+    fi
+    if [ -n "${CLAIM_POLL:-}" ] && [ "$CLAIM_POLL" = "unavailable" ]; then
+        fail_run claim-poll-unavailable "claim: thread_call_allocate failed (docs/19 §5)"
+    fi
+    if [ -n "${CLAIM_T:-}" ] && [ "$CLAIM_T" -ge "$CLAIM_T_MAX" ]; then
+        fail_run "stuck-${CLAIM_STATE:-unknown}" "claim t=${CLAIM_T}s exceeded ${CLAIM_T_MAX}s"
+    fi
+
+    # --- stage transitions (each only after the previous one) --------------
+    case "$STAGE" in
+        0)
+            _ok=0
+            probe_core_loaded && _ok=1
+            [ -n "${CLAIM_CORE:-}" ] && [ "$(as_bool "$CLAIM_CORE")" = 1 ] && _ok=1
+            if [ "$_ok" = 1 ]; then
+                T_CORE=$E; STAGE=1
+                log "stage core: XeGfx core loaded (${E}s)"
+                boot_stage_log "stage core-loaded at ${E}s"
+            elif deadline_exceeded "$DEADLINE_CORE"; then
+                fail_run core-not-loaded "core not loaded within ${DEADLINE_CORE}s"
+            fi
+            ;;
+        1)
+            _ok=0
+            probe_nub_published && _ok=1
+            [ -n "${CLAIM_NUB:-}" ] && [ "$(as_bool "$CLAIM_NUB")" = 1 ] && _ok=1
+            if [ "$_ok" = 1 ]; then
+                T_NUB=$E; STAGE=2
+                log "stage nub: XeGfxDisplayNub published (${E}s)"
+                boot_stage_log "stage nub-published at ${E}s"
+            elif deadline_exceeded "$DEADLINE_NUB"; then
+                fail_run nub-not-published "nub not published within ${DEADLINE_NUB}s"
+            fi
+            ;;
+        2)
+            _ok=0
+            probe_fb_registered && _ok=1
+            [ -n "${CLAIM_REG:-}" ] && [ "$(as_bool "$CLAIM_REG")" = 1 ] && _ok=1
+            if [ "$_ok" = 1 ]; then
+                T_FB=$E; STAGE=3
+                log "stage fb: XeGfxFramebuffer registered (${E}s)"
+                boot_stage_log "stage fb-registered at ${E}s"
+            elif deadline_exceeded "$DEADLINE_FB"; then
+                fail_run fb-not-registered "framebuffer not registered within ${DEADLINE_FB}s"
+            fi
+            ;;
+        3)
+            _ok=0
+            probe_fb_opened && _ok=1
+            [ -n "${CLAIM_STATE:-}" ] && [ "$CLAIM_STATE" = "ready" ] && _ok=1
+            if [ "$_ok" = 1 ]; then
+                T_OPEN=$E; STAGE=4
+                log "stage open: IOFramebuffer opened by WindowServer (${E}s)"
+                boot_stage_log "stage fb-opened at ${E}s"
+            elif deadline_exceeded "$DEADLINE_OPEN"; then
+                fail_run fb-not-opened "framebuffer not opened within ${DEADLINE_OPEN}s"
+            fi
+            ;;
+        4)
+            if probe_ws_up; then
+                T_WS=$E
+                log "stage ws: WindowServer is running (pid $(ws_pid), ${E}s)"
+                boot_stage_log "stage ws-up at ${E}s pid=$(ws_pid)"
+            elif deadline_exceeded "$DEADLINE_WS"; then
+                fail_run ws-not-started "WindowServer not up within ${DEADLINE_WS}s"
+            fi
+            ;;
+    esac
+    [ -n "$T_WS" ] && break
+    sleep "$POLL"
+done
+
+# ---------------------------------------------------------------------------
+# 11. WindowServer stability window, then success
+# ---------------------------------------------------------------------------
+SETTLE_START=$(elapsed)
+WS_RESTARTS=0
+WS_FINAL_PID=$(ws_pid)
+_ws_last=$WS_FINAL_PID
+log "WindowServer up (pid ${WS_FINAL_PID:-?}); settling for ${WS_SETTLE}s, tolerating $(( WS_MAX_CRASH - 1 )) restart(s)"
+
+while [ "$(( $(elapsed) - SETTLE_START ))" -lt "$WS_SETTLE" ]; do
+    sleep "$POLL"
+    claim_snapshot
+    if [ -f "$LOG/probe-timeout" ]; then
+        fail_run registry-probe-timeout "IORegistry query stalled during WS stability check"
+    fi
+    if [ "$SIM" = 1 ] && [ "${M4A2_SIM_SCENARIO:-}" = "fail-ws-crash" ]; then
+        WS_RESTARTS=$(( WS_RESTARTS + 1 ))
+        log "sim: WindowServer restart #${WS_RESTARTS}"
+        if [ "$WS_RESTARTS" -ge "$WS_MAX_CRASH" ]; then
+            fail_run ws-crash-loop "WindowServer restarted ${WS_RESTARTS} times in <${WS_SETTLE}s (simulated)"
+        fi
+        continue
+    fi
+    if [ -n "${CLAIM_STATE:-}" ] && [ "$CLAIM_STATE" = "failed" ]; then
+        fail_run "claim-failed-late-${CLAIM_REASON:-unknown}" "claim turned failed after open()"
+    fi
+    _pid=$(ws_pid)
+    if [ -z "$_pid" ]; then
+        if [ -n "${_ws_last:-}" ]; then
+            WS_RESTARTS=$(( WS_RESTARTS + 1 ))
+            log "WindowServer disappeared (restart count ${WS_RESTARTS})"
+            _ws_last=''
+        fi
+    else
+        if [ -n "${_ws_last:-}" ] && [ "$_pid" != "$_ws_last" ]; then
+            WS_RESTARTS=$(( WS_RESTARTS + 1 ))
+            log "WindowServer restarted (pid ${_ws_last} -> ${_pid}, restart count ${WS_RESTARTS})"
+        fi
+        _ws_last=$_pid
+        WS_FINAL_PID=$_pid
+    fi
+    if [ "$WS_RESTARTS" -ge "$WS_MAX_CRASH" ]; then
+        fail_run ws-crash-loop "WindowServer restarted ${WS_RESTARTS} times within ${WS_SETTLE}s"
+    fi
+done
+
+success_run
--- /dev/null
+++ b/tools/m4a2-verify.sh
@@ -0,0 +1,428 @@
+#!/bin/bash
+#
+# m4a2-verify.sh -- read-only acceptance check for an M4a-2 claim boot.
+#
+# Run after a trial boot (either by hand or from a login-item/CI-like caller):
+#
+#   tools/m4a2-verify.sh                 # auto: full acceptance, evidence in data/
+#   tools/m4a2-verify.sh --strict        # also fail if this is not a claim boot
+#   tools/m4a2-verify.sh --out /tmp/v    # explicit evidence directory
+#   tools/m4a2-verify.sh --help
+#
+# It never writes NVRAM, never loads/unloads kexts, never reboots and never
+# changes system state: everything below is ioreg/sysctl/nvram/kmutil/log/
+# system_profiler/pgrep/read-only-file reading.  Evidence (raw ioreg dumps,
+# sysctl values, log excerpts, summary.txt) is written to the --out directory.
+#
+# Exit status: 0 = every hard check passed (or this boot is not a claim boot
+# and --strict was not given), 1 = at least one hard check failed, 2 = usage.
+#
+# Acceptance contract: docs/18-M4A-BOOT-CHAIN.md §2 (M4a-2 rows),
+# docs/19-M4A-CLAIM.md §4.3/§5/§11, docs/20-M4A2-BOOTGUARD.md §5.
+
+set -u
+
+PATH="/usr/bin:/bin:/usr/sbin:/sbin:${PATH:-}"
+NVRAM=/usr/sbin/nvram
+IOREG=/usr/sbin/ioreg
+SYSCTL=/usr/sbin/sysctl
+SYSTEM_PROFILER=/usr/sbin/system_profiler
+DATE=/bin/date
+
+SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
+PROJECT_DIR=$(dirname "$SCRIPT_DIR")
+STAMP=$($DATE +%Y%m%d-%H%M%S)
+OUT="$PROJECT_DIR/data/m4a2-verify-$STAMP"
+STRICT=0
+
+usage() {
+    cat <<'EOF'
+Usage: m4a2-verify.sh [--strict] [--out DIR] [--help]
+
+  --strict     treat "this boot is not a claim boot" as a failure
+  --out DIR    evidence directory (default data/m4a2-verify-<stamp>)
+  --help       this text
+
+Read-only: no NVRAM writes, no kext load/unload, no reboot.
+EOF
+}
+
+while [ $# -gt 0 ]; do
+    case "$1" in
+        --strict) STRICT=1 ;;
+        --out)    shift; [ $# -gt 0 ] && OUT=$1 ;;
+        -h|--help) usage; exit 0 ;;
+        *) echo "m4a2-verify: unknown argument: $1" >&2; exit 2 ;;
+    esac
+    shift
+done
+
+mkdir -p "$OUT" || { echo "m4a2-verify: cannot create $OUT" >&2; exit 2; }
+SUMMARY="$OUT/summary.txt"
+PASS=0 FAIL=0 WARN=0 SKIP=0
+NOT_CLAIM_BOOT=0
+
+say() { echo "$@" | tee -a "$SUMMARY"; }
+pass() { PASS=$((PASS + 1)); say "PASS  $*"; }
+fail() { FAIL=$((FAIL + 1)); say "FAIL  $*"; }
+warn() { WARN=$((WARN + 1)); say "WARN  $*"; }
+skip() { SKIP=$((SKIP + 1)); say "SKIP  $*"; }
+
+# grep for ioreg property dump; returns 0 if regex found
+dump() { # file command...
+    _f=$1
+    shift
+    "$@" >"$OUT/$_f" 2>&1
+    cat "$OUT/$_f"
+}
+
+has() { grep -Eq "$1" "$2" 2>/dev/null; }
+dump_has() { grep -Eq "$1" "$2" 2>/dev/null && return 0 || return 1; }
+
+say "==== M4a-2 claim-boot acceptance $(date '+%F %T %Z') ===="
+say "out: $OUT"
+say ""
+
+# ---------------------------------------------------------------------------
+# 0. boot identity
+# ---------------------------------------------------------------------------
+BOOT_UUID=$(/usr/sbin/sysctl -n kern.bootsessionuuid 2>/dev/null || echo unknown)
+CONSOLE_USER=$(stat -f '%Su' /dev/console 2>/dev/null || echo unknown)
+say "-- context --"
+say "boot_uuid : $BOOT_UUID"
+say "console   : $CONSOLE_USER"
+say "boottime  : $($SYSCTL -n kern.boottime 2>/dev/null | tr -s ' ')"
+say "kernel    : $(uname -a)"
+{ echo "boot_uuid=$BOOT_UUID"; echo "console_user=$CONSOLE_USER"; } >"$OUT/context.txt"
+
+# ---------------------------------------------------------------------------
+# 1. NVRAM gates -- what was this boot asked to do?
+# ---------------------------------------------------------------------------
+say ""
+say "-- NVRAM gates --"
+$NVRAM -p 2>/dev/null | grep -E '^(xegfx|xeintelfb)' >"$OUT/nvram-gates.txt" 2>&1
+cat "$OUT/nvram-gates.txt" | while IFS= read -r line; do say "  $line"; done
+
+nv_num() { # name
+    _raw=$($NVRAM "$1" 2>/dev/null | awk -F'\t' '{print $2}')
+    [ -z "$_raw" ] && { echo ""; return; }
+    _hex=$(printf '%s' "$_raw" | tr -d '%')
+    _val=0
+    _shift=0
+    while [ -n "$_hex" ]; do
+        _b=${_hex:0:2}
+        _hex=${_hex:2}
+        case "$_b" in [0-9A-Fa-f][0-9A-Fa-f]) ;; *) echo ""; return ;; esac
+        _val=$(( _val + 0x$_b * (1 << _shift) ))
+        _shift=$(( _shift + 8 ))
+        [ "$_shift" -ge 32 ] && break
+    done
+    echo "$_val"
+}
+
+G_PHASE=$(nv_num xegfx-disp-phase)
+G_TRIAL=$(nv_num xegfx-disp-trial)
+G_FAIL=$(nv_num xegfx-disp-fail)
+G_STARTS=$(nv_num xegfx-disp-starts)
+G_BOOTARM=$(nv_num xegfx-disp-bootarm)
+G_EXPOSE=$(nv_num xegfx-disp-expose)
+say "  parsed: phase=${G_PHASE:-absent} trial=${G_TRIAL:-absent} fail=${G_FAIL:-absent} starts=${G_STARTS:-absent} bootarm=${G_BOOTARM:-absent} expose=${G_EXPOSE:-absent}"
+
+if [ "${G_PHASE:-0}" = "2" ] && [ "${G_TRIAL:-0}" = "1" ]; then
+    say "claim boot: YES (phase=2 trial=1)"
+else
+    NOT_CLAIM_BOOT=1
+    say "claim boot: NO (phase=${G_PHASE:-absent} trial=${G_TRIAL:-absent})"
+    if [ "${G_BOOTARM:-0}" != "0" ]; then
+        warn "M4a-1 bootarm flag is still set; M4a-2 trials should clear it first"
+    fi
+fi
+
+# ---------------------------------------------------------------------------
+# 2. kexts
+# ---------------------------------------------------------------------------
+say ""
+say "-- kexts --"
+/usr/bin/kmutil showloaded --list-only 2>/dev/null | grep -E 'XeGfx|xegfx' >"$OUT/showloaded.txt" 2>&1
+if [ -s "$OUT/showloaded.txt" ]; then
+    while IFS= read -r line; do say "  $line"; done <"$OUT/showloaded.txt"
+else
+    warn "kmutil showloaded returned no XeGfx entries"
+fi
+for k in XeGfx XeGfxDisplay XeGfxAccel XeGfxAGDC XeGfxIntelFB; do
+    if grep -q "org.watchthelight.$k (\\|$k (" "$OUT/showloaded.txt" 2>/dev/null; then
+        pass "kext loaded: $k"
+    else
+        # XeGfxDisplay/XeGfxIntelFB may be claimed-but-not-loaded on a success
+        # boot (claim owns the category); report rather than hard-fail.
+        warn "kext not in showloaded: $k"
+    fi
+done
+
+# ---------------------------------------------------------------------------
+# 3. IOFramebuffer ownership (the point of M4a-2)
+# ---------------------------------------------------------------------------
+say ""
+say "-- IOFramebuffer ownership --"
+dump framebuffers.txt $IOREG -l -w0 -r -c IOFramebuffer
+FB_CLASSES=$(grep -E '^ *\| *"IOClass"|class ' "$OUT/framebuffers.txt" 2>/dev/null | sort -u)
+{
+    echo "# IOFramebuffer nodes:"
+    grep -c 'class ' "$OUT/framebuffers.txt" 2>/dev/null
+    grep -oE 'class [A-Za-z0-9_]+' "$OUT/framebuffers.txt" 2>/dev/null | sort | uniq -c
+} >"$OUT/framebuffer-classes.txt" 2>&1
+cat "$OUT/framebuffer-classes.txt" | while IFS= read -r line; do say "  $line"; done
+
+if [ "$NOT_CLAIM_BOOT" = 1 ]; then
+    # Outside a claim boot exactly one of these is the legitimate owner:
+    # XeGfxIntelFramebuffer (M3d/M4a inert or armed) or the Apple
+    # IONDRVFramebuffer placeholder (fresh install, no trial armed).
+    if grep -q 'class XeGfxIntelFramebuffer' "$OUT/framebuffers.txt" 2>/dev/null; then
+        pass "XeGfxIntelFramebuffer owns the display (expected outside a claim boot)"
+    elif grep -q 'class IONDRVFramebuffer' "$OUT/framebuffers.txt" 2>/dev/null; then
+        pass "Apple IONDRVFramebuffer placeholder owns the display (no trial armed)"
+    elif grep -q 'class XeGfxFramebuffer' "$OUT/framebuffers.txt" 2>/dev/null; then
+        warn "XeGfxFramebuffer is live although gates say no claim boot"
+    else
+        warn "no recognised IOFramebuffer node found"
+    fi
+else
+    if grep -q 'class XeGfxFramebuffer' "$OUT/framebuffers.txt" 2>/dev/null; then
+        pass "XeGfxFramebuffer is a live IOFramebuffer node"
+    else
+        fail "XeGfxFramebuffer is not an IOFramebuffer node on a claim boot"
+    fi
+    if grep -q 'class XeGfxIntelFramebuffer' "$OUT/framebuffers.txt" 2>/dev/null; then
+        fail "XeGfxIntelFramebuffer is still the IOFramebuffer on a claim boot (claim lost the category)"
+    else
+        pass "XeGfxIntelFramebuffer is not published (claim kept the category)"
+    fi
+    if grep -q 'class IONDRVFramebuffer' "$OUT/framebuffers.txt" 2>/dev/null; then
+        fail "Apple IONDRVFramebuffer still active on a claim boot (claim did not take the category)"
+    else
+        pass "Apple IONDRVFramebuffer gone from the IOFramebuffer category"
+    fi
+fi
+
+# ---------------------------------------------------------------------------
+# 4. claim node attributes (docs/19-M4A-CLAIM.md §4.3)
+# ---------------------------------------------------------------------------
+say ""
+say "-- claim node (XeGfxFBClaim) --"
+dump claim.txt $IOREG -l -w0 -r -c XeGfxFBClaim
+if [ -s "$OUT/claim.txt" ]; then
+    for attr in xegfx-fb-claim-state xegfx-fb-claim-t xegfx-fb-claim-poll \
+                xegfx-fb-claim-reason xegfx-fb-claim-core xegfx-fb-claim-nub \
+                xegfx-fb-claim-fb xegfx-fb-claim-registered xegfx-fb-claim-opened \
+                xegfx-fb-claim-open-count xegfx-fb-claim-chain xegfx-fb-claim-arm \
+                xegfx-fb-claim-bootarm; do
+        v=$(sed -n "s/.*\"$attr\" = //p" "$OUT/claim.txt" | head -1 | tr -d '"')
+        [ -n "$v" ] && say "  $attr = $v"
+    done
+    C_STATE=$(sed -n 's/.*"xegfx-fb-claim-state" = //p' "$OUT/claim.txt" | head -1 | tr -d '"')
+    C_OPENED=$(sed -n 's/.*"xegfx-fb-claim-opened" = //p' "$OUT/claim.txt" | head -1 | tr -d '"')
+    if [ "${C_STATE:-}" = "ready" ]; then
+        pass "claim state = ready"
+    else
+        fail "claim state = ${C_STATE:-absent} (want ready)"
+    fi
+    case "${C_OPENED:-}" in
+        Yes|YES|true|1) pass "claim reports framebuffer really opened (opened=$C_OPENED)" ;;
+        *) fail "claim opened = ${C_OPENED:-absent} (open() did not happen)" ;;
+    esac
+else
+    if [ "$NOT_CLAIM_BOOT" = 1 ]; then
+        skip "no XeGfxFBClaim node (not a claim boot)"
+    else
+        fail "no XeGfxFBClaim node on a claim boot"
+    fi
+fi
+
+# ---------------------------------------------------------------------------
+# 5. core / nub / timing-source evidence
+# ---------------------------------------------------------------------------
+say ""
+say "-- core (IOResources) --"
+$IOREG -l -w0 -r -c IOResources 2>/dev/null \
+    | grep -E '"(XeGfxArm|XeGfxArmed|XeGfxBootArm|XeGfxBootState|XeGfxBootTrigger|XeGfxCoreReady|XeGfxBootAbort|XeGfxBootStage)"' \
+    >"$OUT/coresources.txt" 2>&1
+cat "$OUT/coresources.txt" | while IFS= read -r line; do say "  $(echo "$line" | tr -s ' ')"; done
+if grep -q '"XeGfxCoreReady" = Yes' "$OUT/coresources.txt" 2>/dev/null; then
+    pass "XeGfxCoreReady published"
+else
+    if [ "$NOT_CLAIM_BOOT" = 1 ]; then skip "XeGfxCoreReady not expected outside a claim boot"
+    else fail "XeGfxCoreReady not published"; fi
+fi
+
+$SYSCTL debug 2>/dev/null | grep -E 'xegfx_boot|debug\.xegfx_stage|debug\.xegfx_agdc|debug\.xegfx_timing' \
+    >"$OUT/sysctl-boot.txt" 2>&1
+if [ -s "$OUT/sysctl-boot.txt" ]; then
+    cat "$OUT/sysctl-boot.txt" | while IFS= read -r line; do say "  $line"; done
+    if grep -q 'debug.xegfx_boot: armed 0 phase ready stage 7 result 0' "$OUT/sysctl-boot.txt" 2>/dev/null; then
+        pass "debug.xegfx_boot: stages 1..7 passed, result 0"
+    elif grep -q 'debug.xegfx_boot' "$OUT/sysctl-boot.txt" 2>/dev/null; then
+        warn "debug.xegfx_boot present but not 'stage 7 result 0' (see sysctl-boot.txt)"
+    else
+        skip "debug.xegfx_boot sysctl not installed (older core build?)"
+    fi
+else
+    warn "no debug.xegfx_* sysctls (older core build?)"
+fi
+
+say ""
+say "-- nub (XeGfxDisplayNub) --"
+dump nub.txt $IOREG -l -w0 -r -c XeGfxDisplayNub
+if [ -s "$OUT/nub.txt" ]; then
+    grep -E '"(XeGfxTimingSource|xegfx-kms-kapi|xegfx-kms-abi|vbt-data|measured-panel-timing|fb-index|XeGfxBootArm)"' \
+        "$OUT/nub.txt" >"$OUT/nub-attrs.txt" 2>&1
+    cat "$OUT/nub-attrs.txt" | while IFS= read -r line; do say "  $(echo "$line" | tr -s ' ' | cut -c1-160)"; done
+    TS=$(sed -n 's/.*"XeGfxTimingSource" = //p' "$OUT/nub.txt" | head -1 | tr -d '"')
+    case "${TS:-}" in
+        measured|edid-dtd|vbt-dtd)
+            pass "nub timing source = $TS (docs/20-M4A-TIMING-FALLBACK.md)" ;;
+        none|"")
+            warn "nub timing source = ${TS:-absent} -- adapter mode table may be empty" ;;
+        *) warn "nub timing source = $TS (unknown value)" ;;
+    esac
+else
+    if [ "$NOT_CLAIM_BOOT" = 1 ]; then skip "no XeGfxDisplayNub node (not a claim boot)"
+    else fail "no XeGfxDisplayNub node on a claim boot"; fi
+fi
+
+# ---------------------------------------------------------------------------
+# 6. accel + pipeline counters
+# ---------------------------------------------------------------------------
+say ""
+say "-- accel (XeGfxAccel / NMXAccel) --"
+$SYSCTL debug 2>/dev/null | grep -E 'xegfxaccel_(boot|scanout|pipe|heads|iop)' >"$OUT/sysctl-accel.txt" 2>&1
+if [ -s "$OUT/sysctl-accel.txt" ]; then
+    cat "$OUT/sysctl-accel.txt" | while IFS= read -r line; do say "  $line"; done
+    PASS_CNT=$(grep -oE 'head[0-9]+ .*' "$OUT/sysctl-accel.txt" 2>/dev/null | grep -c 'head' || true)
+    say "  (pipeline counters above: heads_published/registered/piped should show head 4 piped)"
+else
+    warn "no debug.xegfxaccel_* sysctls"
+fi
+$IOREG -l -w0 -r -c NMXAccel 2>/dev/null | grep -E '"XeGfxAccelBoot(Ready|Steps|Failure)"|"XeGfxAccelAgdcRequest"' \
+    >"$OUT/accel-attrs.txt" 2>&1
+if [ -s "$OUT/accel-attrs.txt" ]; then
+    cat "$OUT/accel-attrs.txt" | while IFS= read -r line; do say "  $(echo "$line" | tr -s ' ')"; done
+    grep -q 'XeGfxAccelBootReady" = Yes' "$OUT/accel-attrs.txt" 2>/dev/null \
+        && pass "accel boot-armed ready" || warn "accel boot-armed not ready"
+else
+    warn "no NMXAccel node"
+fi
+
+# ---------------------------------------------------------------------------
+# 7. display / Metal (what the user actually sees)
+# ---------------------------------------------------------------------------
+say ""
+say "-- display + Metal --"
+$SYSTEM_PROFILER SPDisplaysDataType >"$OUT/displays.txt" 2>"$OUT/displays.err"
+grep -E 'Resolution|UI Looks like|Retina|Metal|Display Type|Main Display|Mirror' "$OUT/displays.txt" \
+    | sed 's/^ *//' | while IFS= read -r line; do say "  $line"; done
+if grep -q 'Metal.*Supported' "$OUT/displays.txt" 2>/dev/null; then
+    pass "system_profiler reports Metal support"
+elif [ "$NOT_CLAIM_BOOT" = 1 ]; then
+    warn "system_profiler reports no Metal support (informational outside a claim boot)"
+else
+    fail "system_profiler reports no Metal support (CGDisplay may be software-backed)"
+fi
+
+$IOREG -l -w0 -r -c IOFramebuffer 2>/dev/null | grep -E '"(IOFBMemorySize|IOFBCurrentPixelClock|IOFBCurrentPixelClockFormat|IOFBModes|IOFBDetailedTimings|IOFBUIScale|IOFBTransform)"' \
+    >"$OUT/fb-attrs.txt" 2>&1
+if [ -s "$OUT/fb-attrs.txt" ]; then
+    cat "$OUT/fb-attrs.txt" | while IFS= read -r line; do say "  $(echo "$line" | tr -s ' ' | cut -c1-160)"; done
+fi
+
+# ---------------------------------------------------------------------------
+# 8. WindowServer / loginwindow / console
+# ---------------------------------------------------------------------------
+say ""
+say "-- userspace --"
+pgrep -lx WindowServer >"$OUT/ws.txt" 2>&1
+pgrep -lx loginwindow >>"$OUT/ws.txt" 2>&1
+cat "$OUT/ws.txt" | while IFS= read -r line; do say "  $line"; done
+if pgrep -x WindowServer >/dev/null 2>&1; then
+    pass "WindowServer is running on the claim framebuffer"
+else
+    if [ "$NOT_CLAIM_BOOT" = 1 ]; then skip "WindowServer not checked outside a claim boot"
+    else fail "WindowServer is not running"; fi
+fi
+if [ "$CONSOLE_USER" = "root" ] || [ "$CONSOLE_USER" = "unknown" ]; then
+    warn "console user = $CONSOLE_USER (login window not up yet or no user logged in)"
+else
+    pass "console user = $CONSOLE_USER"
+fi
+
+# ---------------------------------------------------------------------------
+# 9. logs + bootguard artifacts
+# ---------------------------------------------------------------------------
+say ""
+say "-- kernel log + bootguard artifacts --"
+/usr/bin/log show --last 30m --style compact --predicate 'process == "kernel"' 2>/dev/null \
+    | grep -E 'XEGFX_DISPLAY|XeGfx|NMXAccel' >"$OUT/kernel.log" 2>&1
+say "  kernel log lines: $(wc -l <"$OUT/kernel.log" | tr -d ' ')"
+grep -E 'claim-start|claim-final' "$OUT/kernel.log" 2>/dev/null | tail -6 \
+    | while IFS= read -r line; do say "  $line"; done
+if grep -q 'claim-final: .*state=ready' "$OUT/kernel.log" 2>/dev/null; then
+    pass "kernel log has claim-final state=ready"
+elif [ "$NOT_CLAIM_BOOT" = 1 ]; then
+    skip "no claim-final in kernel log (not a claim boot)"
+else
+    fail "kernel log has no claim-final state=ready"
+fi
+if grep -q 'XEGFX_DISPLAY' "$OUT/kernel.log" 2>/dev/null; then
+    pass "kernel log has XEGFX_DISPLAY lines (adapter logging alive)"
+else
+    warn "no XEGFX_DISPLAY lines in the last 30m"
+fi
+
+if [ -d /Library/XeGfxTrial ]; then
+    ls -t /Library/XeGfxTrial/m4a2-ok-* 2>/dev/null | head -1 >"$OUT/latest-ok.txt"
+    ls -t /Library/XeGfxTrial/m4a2-fail-* 2>/dev/null | head -1 >"$OUT/latest-fail.txt"
+    ls -t /Library/XeGfxTrial/m4a2-reverted-* 2>/dev/null | head -1 >>"$OUT/latest-ok.txt"
+    for f in $(cat "$OUT/latest-ok.txt" "$OUT/latest-fail.txt" 2>/dev/null); do
+        [ -e "$f" ] || continue
+        say "  artifact: $f"
+        if [ -f "$f" ] && [ -r "$f" ]; then
+            sed 's/^/    /' "$f" >>"$OUT/artifacts.txt" 2>/dev/null
+        fi
+    done
+    if [ -f "$OUT/artifacts.txt" ]; then
+        grep -E '^    (result|reason|stage_|ws_|claim_|gates)' "$OUT/artifacts.txt" 2>/dev/null \
+            | while IFS= read -r line; do say "$line"; done
+    fi
+    OSTAGE=$(ls -t /Library/XeGfxTrial/boot-stage.log 2>/dev/null | head -1)
+    if [ -n "${OSTAGE:-}" ] && [ -f "$OSTAGE" ]; then
+        tail -12 "$OSTAGE" >"$OUT/boot-stage-tail.txt" 2>&1
+        say "  boot-stage.log tail:"
+        sed 's/^/    /' "$OUT/boot-stage-tail.txt" | while IFS= read -r line; do say "$line"; done
+        grep -q "m4a2-bootguard: OK" "$OUT/boot-stage-tail.txt" 2>/dev/null \
+            && pass "bootguard recorded OK in boot-stage.log" \
+            || warn "no bootguard OK line in boot-stage.log tail"
+    fi
+else
+    warn "/Library/XeGfxTrial missing -- bootguard was never installed?"
+fi
+
+# ---------------------------------------------------------------------------
+# 10. verdict
+# ---------------------------------------------------------------------------
+say ""
+say "-- verdict --"
+say "pass=$PASS fail=$FAIL warn=$WARN skip=$SKIP claim_boot=$([ "$NOT_CLAIM_BOOT" = 1 ] && echo no || echo yes)"
+echo "pass=$PASS fail=$FAIL warn=$WARN skip=$SKIP not_claim_boot=$NOT_CLAIM_BOOT" >"$OUT/verdict.txt"
+if [ "$FAIL" -gt 0 ]; then
+    say "RESULT=FAIL ($FAIL hard check(s) failed; evidence in $OUT)"
+    exit 1
+fi
+if [ "$NOT_CLAIM_BOOT" = 1 ]; then
+    if [ "$STRICT" = 1 ]; then
+        say "RESULT=FAIL (not a claim boot and --strict was given; evidence in $OUT)"
+        exit 1
+    fi
+    say "RESULT=NOT-A-CLAIM-BOOT (gates disarmed; nothing to accept; evidence in $OUT)"
+    exit 0
+fi
+say "RESULT=PASS (claim takeover boot accepted; evidence in $OUT)"
+exit 0
--- /dev/null
+++ b/tools/preflight-m3d.sh
@@ -0,0 +1,58 @@
+#!/bin/bash
+# M3d-a 安装前预检（只读）：五件套产物存在/骰子/版本/关键符号/签名，并列出安装命令。
+# 用法：./tools/preflight-m3d.sh
+set -u
+B=${XEGFX_BUILD_ROOT:?set XEGFX_BUILD_ROOT to the external component build root}
+N=${XEGFX_NVGFX_ROOT:?set XEGFX_NVGFX_ROOT to the NvGfx source tree}
+ND=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
+FAIL=0
+
+check() { # check <name> <bundle> <ident> <binname> <want_version> <strings...>
+  local name="$1" bundle="$2" ident="$3" bin="$4" wantver="$5"; shift 5
+  echo "== $name =="
+  if [ ! -d "$bundle" ]; then echo "  MISSING: $bundle"; FAIL=1; return; fi
+  local exe="$bundle/Contents/MacOS/$bin"
+  if [ ! -f "$exe" ]; then echo "  MISSING EXECUTABLE: $exe"; FAIL=1; return; fi
+  local gotid gotver
+  gotid=$(/usr/libexec/PlistBuddy -c "Print :CFBundleIdentifier" "$bundle/Contents/Info.plist" 2>/dev/null)
+  gotver=$(/usr/libexec/PlistBuddy -c "Print :CFBundleVersion" "$bundle/Contents/Info.plist" 2>/dev/null)
+  echo "  path:    $bundle"
+  echo "  ident:   $gotid (want $ident)"
+  echo "  version: $gotver"
+  echo "  sha256:  $(shasum -a 256 "$exe" | awk '{print $1}')"
+  echo "  size:    $(stat -f %z "$exe") B"
+  [ "$gotid" = "$ident" ] || { echo "  !! identifier mismatch"; FAIL=1; }
+  if [ -n "$wantver" ] && [ "$gotver" != "$wantver" ]; then echo "  !! version mismatch (want $wantver)"; FAIL=1; fi
+  if ! nm -gU "$exe" 2>/dev/null | grep -q "_kmod_info"; then
+    if ! nm "$exe" 2>/dev/null | grep -q "_kmod_info"; then echo "  !! _kmod_info missing"; FAIL=1; fi
+  fi
+  if ! codesign --verify --strict "$bundle" >/dev/null 2>&1; then echo "  !! codesign verify failed (re-signed at install)"; fi
+  local s
+  for s in "$@"; do
+    if strings -a "$exe" | grep -qF "$s"; then echo "  strings ok:    $s"; else echo "  !! strings MISSING: $s"; FAIL=1; fi
+  done
+  echo
+}
+
+check core        "$N/gpu/xegfx/out/XeGfx.kext"                        org.watchthelight.XeGfx        XeGfx        "" \
+      "XEGFX_KAPI" "xegfx-kms-kapi" "XeGfxDisplayNub"
+check adapter     "$ND/nvrmfb-adapter/kexts/XeGfxDisplay/out/XeGfxDisplay.kext" org.watchthelight.XeGfxDisplay XeGfxDisplay "" \
+      "XEGFX_DISPLAY" "XeGfxFramebuffer" "XeGfxFBClaim" "XeGfxFbModeReady" "0.5-s3"
+check accel       "$B/XeGfxAccel/26/XeGfxAccel.kext"                   org.watchthelight.XeGfxAccel  XeGfxAccel   "" \
+      "XeGfxFramebuffer" "XeGfxFbRegistered" "parked as the alternative head 4"
+check agdc        "$B/XeGfxAGDC/XeGfxAGDC.kext"                        org.watchthelight.XeGfxAGDC    XeGfxAGDC    "" \
+      "XeGfxFramebuffer" "AGDC: target framebuffer"
+check intelfb     "$B/XeGfxIntelFB/XeGfxIntelFB.kext"                  org.watchthelight.XeGfxIntelFB XeGfxIntelFB "0.5" \
+      "XeGfxL0Ready" "boot guard"
+
+echo "== 安装命令（wrapper 会修正并校验 accel 的嵌套 Metal personality；保留已安装 IntelFB）=="
+cat <<EOF
+bash "$ND/tools/m3d-install.sh" --dry-run \\
+  --core    "$N/gpu/xegfx/out/XeGfx.kext" \\
