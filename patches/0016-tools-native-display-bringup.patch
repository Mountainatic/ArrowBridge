+ND = pathlib.Path(__file__).resolve().parent.parent
+SRC_CORE = N / "gpu/xegfx/out/XeGfx.kext"
+SRC_DISP = ND / "nvrmfb-adapter/kexts/XeGfxDisplay/out/XeGfxDisplay.kext"
+DEST_CORE = pathlib.Path("/Library/Extensions/XeGfx.kext")
+DEST_DISP = pathlib.Path("/Library/Extensions/XeGfxDisplay.kext")
+DEST_ACCEL = pathlib.Path("/Library/Extensions/XeGfxAccel.kext")
+DEST_AGDC = pathlib.Path("/Library/Extensions/XeGfxAGDC.kext")
+DEST_INTELFB = pathlib.Path("/Library/Extensions/XeGfxIntelFB.kext")
+KC = pathlib.Path("/Library/KernelCollections/AuxiliaryKernelExtensions.kc")
+TRIALS = pathlib.Path("/Library/XeGfxTrial")
+
+COMPONENTS = {
+    "core":    dict(ident="org.watchthelight.XeGfx",        dest=DEST_CORE,  macos="XeGfx",        default=SRC_CORE),
+    "adapter": dict(ident="org.watchthelight.XeGfxDisplay", dest=DEST_DISP,  macos="XeGfxDisplay", default=SRC_DISP),
+    "accel":   dict(ident="org.watchthelight.XeGfxAccel",   dest=DEST_ACCEL, macos="XeGfxAccel",   default=None),
+    "agdc":    dict(ident="org.watchthelight.XeGfxAGDC",    dest=DEST_AGDC,  macos="XeGfxAGDC",    default=None),
+    "intelfb": dict(ident="org.watchthelight.XeGfxIntelFB", dest=DEST_INTELFB, macos="XeGfxIntelFB", default=None),
