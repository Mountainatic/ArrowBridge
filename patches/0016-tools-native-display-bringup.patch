+
+echo "=== 1. core + env (disp_level=2)"
+if ! /usr/bin/kmutil showloaded | grep -q "org.watchthelight.XeGfx ("; then
+	echo "loading core"; /usr/bin/kmutil load -b org.watchthelight.XeGfx || { echo "CORE LOAD FAILED"; exit 1; }
+	sleep 1
+fi
+/usr/sbin/sysctl -w "debug.xegfx_env=compat.linuxkpi.i915_disable_display=1 compat.linuxkpi.i915_xegfx_no_display=1 compat.linuxkpi.i915_xegfx_disp_level=2 compat.linuxkpi.i915_enable_guc=3" || true
+/usr/sbin/sysctl -w debug.xegfx_wdog=60 || true
+/usr/sbin/sysctl -w debug.xegfx_stage=2 || { echo "STAGE2 WRITE FAILED"; exit 1; }
+i=0; while [ "$(/usr/sbin/sysctl -n debug.xegfx_stage 2>/dev/null)" != "2" ] && [ $i -lt 120 ]; do sleep 0.5; i=$((i+1)); done
+echo "stage=$(/usr/sbin/sysctl -n debug.xegfx_stage 2>/dev/null)"
+dump_telemetry "after-stage2"
+
+echo "=== 1.1 M1b VBT dump"
