+  *) echo "STOP: binary sha $BIN_SHA does not start with expected $EXPECT_SHA_PREFIX"; exit 1 ;;
+esac
+
+echo "== installing via install_core_044.py"
+python3 "$INSTALLER"
+
+echo "== moving the old M0 probe helper out of the way; installing the M1a bring-up"
+mkdir -p /Library/XeGfxTrial
+mv -f /Library/XeGfxTrial/m0-probe.sh /Library/XeGfxTrial/m0-probe.sh.done 2>/dev/null || true
+cp -f "$BRINGUP" /Library/XeGfxTrial/m1a-bringup.sh
+chmod 755 /Library/XeGfxTrial/m1a-bringup.sh
+chown root:wheel /Library/XeGfxTrial/m1a-bringup.sh
+
+LATEST=$(ls -dt /Library/XeGfxTrial/core-* | head -1)
+echo "== install done; backup: $LATEST"
+echo "== next: reboot; after login run (osascript, admin): bash /Library/XeGfxTrial/m1a-bringup.sh"
