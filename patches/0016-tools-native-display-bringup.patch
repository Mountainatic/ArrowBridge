@@ -0,0 +1,186 @@
+#!/usr/bin/env python3
+"""Install the M2c core + XeGfxDisplay adapter kexts and rebuild the AuxKC.
+
+Both kexts go into /Library/Extensions in one transaction: backup (KC + both old
+kext bundles), stage, ad-hoc sign, swap, rebuild the AuxKC with the canonical
+`kmutil create` line, validate the new entry set, replace the KC, and append
+`-xedisp=1` to boot-args (the adapter's probe master gate).  Any failure rolls
+the KC, both bundles and boot-args back to the pre-install state.
+
+Run as root (the wrapper runs it through osascript administrator privileges).
+"""
+import datetime, json, os, pathlib, plistlib, re, shutil, subprocess, sys
+
+N = pathlib.Path(os.environ["XEGFX_NVGFX_ROOT"]).expanduser().resolve()
+SRC_CORE = N / "gpu/xegfx/out/XeGfx.kext"
+SRC_DISP = (pathlib.Path(os.environ["XEGFX_DISPLAY_KEXT"]).expanduser().resolve() if os.environ.get("XEGFX_DISPLAY_KEXT") else pathlib.Path(__file__).resolve().parent.parent / "nvrmfb-adapter/kexts/XeGfxDisplay/out/XeGfxDisplay.kext")
+DEST_CORE = pathlib.Path("/Library/Extensions/XeGfx.kext")
+DEST_DISP = pathlib.Path("/Library/Extensions/XeGfxDisplay.kext")
+KC = pathlib.Path("/Library/KernelCollections/AuxiliaryKernelExtensions.kc")
+TRIALS = pathlib.Path("/Library/XeGfxTrial")
+IDENT_CORE = "org.watchthelight.XeGfx"
+IDENT_DISP = "org.watchthelight.XeGfxDisplay"
+BOOTARG_ENABLE = "xedisp"
+BOOTARG_WANT = "-xedisp=1"
+
+def run(args, log=None):
+    out = subprocess.run(args, check=True, capture_output=True, text=True)
+    if log is not None:
+        log.write("$ " + " ".join(args) + "\n" + (out.stdout or "") + (out.stderr or "") + "\n")
+        log.flush()
+    return out.stdout
+
+def sha(p):
+    return subprocess.run(["/usr/bin/shasum", "-a", "256", str(p)], check=True, capture_output=True, text=True).stdout.split()[0]
+
+def entries(path):
+    r = subprocess.run(["/usr/bin/kmutil", "inspect", "-a", "x86_64", "-A", str(path)], check=True, capture_output=True, text=True)
+    d = {}
+    for line in r.stdout.splitlines():
+        m = re.match(r"^([A-Za-z][A-Za-z0-9_.-]+)\t([^\t]+)\t", line)
+        if m:
+            d[m.group(1)] = m.group(2)
+    return d
+
+def nvram_get(name):
+    r = subprocess.run(["/usr/sbin/nvram", name], capture_output=True, text=True)
+    if r.returncode != 0 or not r.stdout.strip():
+        return ""
+    line = r.stdout.rstrip("\n")
+    return line.split("\t", 1)[1] if "\t" in line else ""
+
+def nvram_set(name, value):
+    subprocess.run(["/usr/sbin/nvram", name + "=" + value], check=True, capture_output=True, text=True)
+
+def plist(p):
+    return plistlib.loads((p / "Contents/Info.plist").read_bytes())
+
+def main():
+    if os.geteuid() != 0:
+        raise SystemExit("administrator authorization is required")
+    for p in (SRC_CORE, SRC_DISP):
+        if not p.is_dir():
+            raise RuntimeError("build artifact missing: " + str(p))
+    if not KC.is_file():
+        raise RuntimeError("AuxKC missing")
+    src_core_info = plist(SRC_CORE); dst_core_info = plist(DEST_CORE)
+    src_disp_info = plist(SRC_DISP)
+    if src_core_info.get("CFBundleIdentifier") != IDENT_CORE or dst_core_info.get("CFBundleIdentifier") != IDENT_CORE:
+        raise RuntimeError("unexpected core bundle identifier")
+    if src_disp_info.get("CFBundleIdentifier") != IDENT_DISP:
+        raise RuntimeError("unexpected adapter bundle identifier")
+    gate = src_core_info.get("IOKitPersonalities", {}).get("XeGfxResident", {}).get("IOResourceMatch")
+    if gate != "XeGfxArm":
+        raise RuntimeError("core startup personality is not gated (%r)" % gate)
+
+    old_entries = entries(KC)
+    TRIALS.mkdir(mode=0o755, exist_ok=True)
+    stamp = datetime.datetime.now().strftime("m2c-%Y%m%d-%H%M%S")
+    backup = TRIALS / stamp
+    backup.mkdir(mode=0o755)
+    shutil.copy2(KC, backup / KC.name)
+    shutil.copytree(DEST_CORE, backup / "XeGfx.kext.before")
+    disp_was_present = DEST_DISP.exists()
+    if disp_was_present:
+        shutil.copytree(DEST_DISP, backup / "XeGfxDisplay.kext.before")
+    else:
+        (backup / "XeGfxDisplay.kext.absent").write_text("no adapter kext was installed before M2c\n")
+    old_bootargs = nvram_get("boot-args")
+    (backup / "boot-args-before.txt").write_text(old_bootargs + "\n")
+    candidate = backup / "AuxiliaryKernelExtensions.m2c.kc"
+    log = (backup / "install.log").open("w")
+    state = {"state": "preparing", "backup": str(backup),
+             "sourceCore": str(SRC_CORE), "sourceCoreSHA256": sha(SRC_CORE / "Contents/MacOS/XeGfx"),
+             "sourceAdapter": str(SRC_DISP), "sourceAdapterSHA256": sha(SRC_DISP / "Contents/MacOS/XeGfxDisplay"),
+             "oldKCSHA256": sha(KC), "oldBootArgs": old_bootargs,
+             "newCoreVersion": src_core_info.get("CFBundleVersion"),
+             "newAdapterVersion": src_disp_info.get("CFBundleVersion")}
+    (backup / "status.json").write_text(json.dumps(state, indent=2) + "\n")
+
+    stages = {}
+    swapped = False
+    bootargs_changed = False
+    try:
+        # stage both bundles
+        for dest, src in ((DEST_CORE, SRC_CORE), (DEST_DISP, SRC_DISP)):
+            stage = dest.with_name(dest.name + ".m2c-new")
+            if stage.exists():
+                shutil.rmtree(stage)
+            run(["/usr/bin/ditto", str(src), str(stage)], log)
+            run(["/usr/sbin/chown", "-R", "root:wheel", str(stage)], log)
+            run(["/bin/chmod", "-R", "755", str(stage)], log)
+            run(["/usr/bin/codesign", "-f", "-s", "-", "--timestamp=none", str(stage)], log)
+            run(["/usr/bin/codesign", "--verify", "--strict", str(stage)], log)
+            stages[dest] = stage
+        # swap into place
+        if DEST_CORE.exists():
+            os.rename(DEST_CORE, backup / "XeGfx.kext.original")
+        os.rename(stages[DEST_CORE], DEST_CORE)
+        if DEST_DISP.exists():
+            os.rename(DEST_DISP, backup / "XeGfxDisplay.kext.original")
+        os.rename(stages[DEST_DISP], DEST_DISP)
+        swapped = True
+        # rebuild AuxKC with the canonical command line (same one the core installer uses)
+        args = ["/usr/bin/kmutil", "create", "-n", "aux", "--volume-root", "/", "--allow-missing-kdk",
+                "-B", "/System/Library/KernelCollections/BootKernelExtensions.kc",
+                "-S", "/System/Library/KernelCollections/SystemKernelExtensions.kc",
+                "--repository", "/Library/Extensions",
+                "--repository", "/Library/Apple/System/Library/Extensions",
+                "-A", str(candidate), "-z"]
+        if pathlib.Path("/System/Library/Kernels/kernel").exists():
+            args += ["--kernel", "/System/Library/Kernels/kernel"]
+        run(args, log)
+        new_entries = entries(candidate)
