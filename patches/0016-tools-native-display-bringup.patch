+#!/bin/bash
+# M4a-1 重启后一键验收（无需 root）。用法: bash tools/m4a1-verify.sh
+set -u
+P=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
+OUT=/Library/XeGfxTrial/m4a1-verify-$(date +%Y%m%d-%H%M%S)
+mkdir -p "$OUT" 2>/dev/null || OUT=/tmp/m4a1-verify-$(date +%Y%m%d-%H%M%S)
+mkdir -p "$OUT" 2>/dev/null || true
+LOG="$OUT/verify.log"
+exec > "$LOG" 2>&1
+echo "=== M4a-1 post-boot verification $(date '+%F %T') ==="
+echo "boot=$(/usr/sbin/sysctl -n kern.bootsessionuuid)  uptime=$(uptime)"
+echo; echo "-- NVRAM gates --"; /usr/sbin/nvram -p | grep -E "xegfx-disp"
+echo; echo "-- loaded third-party kexts --"; /usr/bin/kmutil showloaded 2>/dev/null | grep -E "watchthelight|nullmoth" | head -12
+echo; echo "-- bootarm daemon runs --"; for d in $(/bin/ls -dt /Library/XeGfxTrial/m4a1-* 2>/dev/null | head -3); do echo "[$d] RESULT=$(/bin/cat "$d/RESULT" 2>/dev/null)"; /usr/bin/tail -25 "$d/bootarm.log" 2>/dev/null; done
+echo; echo "-- core --"; /usr/sbin/sysctl debug.xegfx_boot debug.xegfx_stage debug.xegfx_running debug.xegfx_progress 2>&1
+echo; echo "-- timing --"; /usr/sbin/sysctl debug.xegfx_timing 2>&1; /usr/sbin/ioreg -l -w0 -c XeGfxDisplayNub 2>/dev/null | grep -oE '"(measured-panel-timing|XeGfxTimingSource)"[^,}]*' | head -4
+echo; echo "-- accel telemetry --"; for k in igpu accelfb iop headless heads_published heads_registered heads_piped iop_xe_flip iop_xe_defer iop_xe_defer_armed iop_xe_defer_signals pipe_init pipe_perform surface_gpu_on; do /usr/bin/printf "%-28s %s\n" "$k" "$(/usr/sbin/sysctl -n debug.xegfxaccel_$k 2>/dev/null)"; done
+echo; echo "-- WS / session --"; /usr/bin/pgrep -x WindowServer; /usr/bin/who | head -3
+echo; echo "-- displays/Metal --"; /usr/sbin/system_profiler SPDisplaysDataType 2>/dev/null | grep -iE "Chipset|Metal|Resolution|VRAM|Display Type" | head -10
+echo; echo "-- plugin allow --"; /bin/cat /Library/GPUBundles/xemtl-allow.txt 2>/dev/null
+echo; echo "-- suspicious log lines (30m) --"; /usr/bin/log show --last 30m --style compact 2>/dev/null | grep -E "XEGFX_DISPLAY|NMXAccel|xegfx|XeGfx" | grep -iE "fail|error|timeout|crash|declin|abort" | tail -30
+echo; echo "RESULT_DIR=$OUT"
+exec 2>&1
+cp "$LOG" /tmp/m4a1-verify-latest.log 2>/dev/null || true
+cat "$LOG"
