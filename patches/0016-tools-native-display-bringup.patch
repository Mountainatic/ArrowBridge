+#!/bin/bash
+# m0-probe.sh — 重启后（未加载 core 的干净桌面）运行：加载探针 core → 触发 OpRegion/VBT 只读探测 → 采集结果。
+# 用法（root）：sudo bash /Library/XeGfxTrial/m0-probe.sh [--no-load]
+# 只读：不写任何 MMIO 寄存器，不接管显示；可以安全地让桌面继续跑在 firmware raster 上。
+set -u
+
+STAMP=$(date '+%Y%m%d-%H%M%S')
+OUT="/Library/XeGfxTrial/m0-probe-$STAMP"
+mkdir -p "$OUT"
+exec > >(tee -a "$OUT/probe.log") 2>&1
+echo "=== M0 OpRegion/VBT probe $STAMP"
+echo "boot: $(sysctl -n kern.bootsessionuuid)  WS: $(pgrep -x WindowServer || echo none)"
+date
+
+CORE=org.watchthelight.XeGfx
+if [ "${1:-}" != "--no-load" ]; then
+  if ! /usr/bin/kmutil showloaded | grep -q "$CORE ("; then
+    echo "-- loading $CORE"
+    /usr/bin/kmutil load -b "$CORE" || { echo "RESULT=core-load-failed"; exit 1; }
+    sleep 1
+  fi
+fi
+
+echo "-- sysctls before probe"
+for k in env stage running progress wdog agdc panel_timing_source; do
+  printf '  debug.xegfx_%s = %s\n' "$k" "$(/usr/sbin/sysctl -n "debug.xegfx_$k" 2>/dev/null)"
+done
+
+echo "-- trigger: sysctl -w debug.xegfx_display=1"
+/usr/sbin/sysctl -w debug.xegfx_display=1 >/dev/null 2>&1
+sleep 2
+# report string is gDisp[1536]; persist raw first so we have something even if the rest fails
+/usr/sbin/sysctl -n debug.xegfx_display > "$OUT/opregion-vbt-dump.txt" 2>/dev/null
+echo "   dump bytes: $(stat -f %z "$OUT/opregion-vbt-dump.txt" 2>/dev/null || echo 0)"
+
+echo "-- printing dump"
+cat "$OUT/opregion-vbt-dump.txt" 2>/dev/null | tr -d '\000' | head -40
+echo
+
+echo "-- driver stack"
+/usr/bin/kmutil showloaded | grep -iE "watchthelight|NVRM|nmx|XeGfx" || true
+/sbin/ifconfig >/dev/null 2>&1 || true
+
+echo "-- ioreg properties carrying the probe result"
+/usr/sbin/ioreg -l -w0 2>/dev/null | grep -o 'XeGfxDisplayProbe[^}]*' | head -8
+
+echo "-- kernel log (last 5m, XeGfx/opregion/VBT)"
+/usr/bin/log show --last 5m --style compact 2>/dev/null \
+  | grep -iE "XeGfx|opregion|vbt|IntelGraphicsMem" | tail -60 > "$OUT/kernel-log.txt"
+cat "$OUT/kernel-log.txt" 2>/dev/null | tail -40
+
+echo
+echo "RESULT=saved:$OUT"
