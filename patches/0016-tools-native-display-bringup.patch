+
+def sha(path):
+    return subprocess.run(["/usr/bin/shasum", "-a", "256", str(path)],
+                          capture_output=True, text=True).stdout.split()[0]
+
+
+def entries(path):
+    out = run(["/usr/bin/kmutil", "inspect", "-a", "x86_64", "-A", str(path)])
+    d = {}
+    for line in out.splitlines():
+        m = re.match(r"^([A-Za-z][A-Za-z0-9_.-]+)\t([^\t]+)\t", line)
+        if m:
+            d[m.group(1)] = m.group(2)
+    return d
+
+
+def plist(bundle):
+    return plistlib.loads((bundle / "Contents/Info.plist").read_bytes())
+
+
+def nvram_get(name):
+    r = subprocess.run(["/usr/sbin/nvram", name], capture_output=True, text=True)
+    if r.returncode != 0 or not r.stdout.strip():
+        return ""
+    line = r.stdout.rstrip("\n")
+    return line.split("\t", 1)[1] if "\t" in line else ""
