+static IOService *nvAccelResident(void)
+{
+    if (!gXeFlipSvc) {
+        OSDictionary *m = IOService::serviceMatching("XeGfxResident");
+        if (m) { gXeFlipSvc = IOService::waitForMatchingService(m, 1000ULL * 1000 * 1000); m->release(); }
