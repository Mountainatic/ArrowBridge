+        if (!nvAccelXeFlipWaitIdle(&idleUs)) OSAddAtomic64(1, &gCntXeDeferIdleForced);
+        gXeDeferIdleLastUs = idleUs; if (idleUs > gXeDeferIdleMaxUs) gXeDeferIdleMaxUs = idleUs;
