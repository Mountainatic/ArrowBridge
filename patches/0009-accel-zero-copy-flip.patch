+static IOSurface *gXeFlipFront, *gXeFlipPrev;
+static SInt64 gCntXeFlip, gCntXeFlipMiss, gCntXeFlipFail;
+#define NV_PLANE_SURF_A 0x7019cu
+#define NV_XE_FLIP_MAX_PAGES 4224
