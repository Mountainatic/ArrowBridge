+        gXeFlipQ[gXeFlipQHead % NV_XE_FLIP_QUEUE].s = nullptr;
+        gXeFlipQHead++;
+        const SInt64 gen = gXeFlipGen;
+        IOLockUnlock(gXeFlipLock);
