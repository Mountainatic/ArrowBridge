# 0019 tools: guard scripts accept the new class, report the right IOP counters, optional persistent arm
#
# Base:  tools/ from 0016 (m4a2 bootguard set)
# Files: tools/m3db-health.py, tools/xegfx-ws-preflight.py, tools/m4a2-verify.sh, tools/m3db-preflight.sh,
#        tools/m3db-control.py
# Apply: patch -p1 < patches/0019-guard-tools-class-name-and-keep-armed.patch
#
# - health/ws-preflight/verify compared the adapter class by exact name and would have failed the claim after
#   0018; they accept XeGfxIntelKMSFramebuffer, and health fails a class without "Intel" (CoreDisplay would turn
#   IOPresentment off).
# - health reports pipe_perform / iop_xe_flips / iop_ok.  iop_ok only counts the copy path; a direct-flip desktop
#   shows iop_ok=0 although every frame goes through IOPresentment.
# - m3db-control.py arm --keep-armed writes M4A2_DISARM_ON_SUCCESS=0, so a successful claim boot no longer
#   returns the next boot to IntelFB; a failed boot still falls back.
# - m3db-preflight.sh: node count for the new class; PIN_* lines are this machine's installed builds.
#
--- a/tools/m3db-health.py
+++ b/tools/m3db-health.py
@@ -18,13 +18,20 @@
         yield from walk(node.get('IORegistryEntryChildren', []))
 
 
+# XeGfxFramebuffer is the pre-rename adapter class; XeGfxIntelKMSFramebuffer is the one IOKit instantiates now.
+ADAPTER_FB = ('XeGfxFramebuffer', 'XeGfxIntelKMSFramebuffer')
+
+
 def check(nodes, ws):
     nodes = list(nodes)
     live = lambda n: isinstance(n.get('IOServiceState'), int) and n['IOServiceState'] & 2 and not n['IOServiceState'] & 1
-    fbs = [n for n in nodes if n.get('IOObjectClass') in ('XeGfxFramebuffer', 'XeGfxIntelFramebuffer') and live(n)]
-    if len(fbs) != 1 or fbs[0].get('IOObjectClass') != 'XeGfxFramebuffer':
+    fbs = [n for n in nodes if n.get('IOObjectClass') in ADAPTER_FB + ('XeGfxIntelFramebuffer',) and live(n)]
+    if len(fbs) != 1 or fbs[0].get('IOObjectClass') not in ADAPTER_FB:
         raise ValueError('claim requires one registered adapter FB and no registered IntelFB')
     fb = fbs[0]
+    # CoreDisplay (GetGPUVendorForFramebufferService) turns IOPresentment off unless the class name contains "Intel".
+    if 'intel' not in fb['IOObjectClass'].lower():
+        raise ValueError('adapter FB class %s has no "Intel": CoreDisplay disables IOPresentment' % fb['IOObjectClass'])
     for key in ('XeGfxFbRegistered', 'XeGfxFbOpened', 'XeGfxFbReady', 'XeGfxM3dReady', 'XeGfxScanoutReady'):
         if fb.get(key) is not True: raise ValueError(key+' is not true')
     if not any(n.get('IOObjectClass') == 'IOFramebufferUserClient'
@@ -56,6 +63,10 @@
         copies = int(run(['/usr/sbin/sysctl', '-n', 'debug.xegfxaccel_scanout_copies']).strip())
         if copies < 1: raise ValueError('copy-only output has completed no scanout copies')
         result['scanoutCopies'] = copies
+    # Report only: WindowServer submits display-pipe transactions only on the IOPresentment path (all 0 on the legacy
+    # path). pipe_perform counts transactions; iop_xe_flips the direct flips, iop_ok the copy path.
+    for key in ('pipe_perform', 'iop_xe_flips', 'iop_ok'):
+        result[key] = int(run(['/usr/sbin/sysctl', '-n', 'debug.xegfxaccel_' + key]).strip())
     print(json.dumps(dict(state='claim-health-pass', **result)))
 
 
