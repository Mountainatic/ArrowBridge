+++ b/kexts/XeGfxIntelFB/xe/panel-timing.h
@@ -0,0 +1,31 @@
+#ifndef XEGFX_PANEL_TIMING_H
+#define XEGFX_PANEL_TIMING_H
+#include <stdint.h>
+#include "../nvrm-agdc-k5.h"
+
+struct XeGfxPanelMode {
+    uint64_t clock;
+    uint32_t width, hblank, hoffset, hpulse;
+    uint32_t height, vblank, voffset, vpulse;
+    uint32_t hpositive, vpositive;
+};
+
+static inline bool xegfxPanelTiming(const XeGfxPanelMode &m, uint32_t *out)
+{
+    if (!out || !m.clock || m.clock > UINT32_MAX || !m.width || !m.height) return false;
+    const uint64_t ht = (uint64_t)m.width + m.hblank, vt = (uint64_t)m.height + m.vblank;
+    const uint64_t hs = (uint64_t)m.width + m.hoffset, he = hs + m.hpulse;
+    const uint64_t vs = (uint64_t)m.height + m.voffset, ve = vs + m.vpulse;
+    if (ht > 65536 || vt > 65536 || !m.hpulse || !m.vpulse || he > ht || ve > vt) return false;
+    const uint64_t mhz = m.clock * 1000 / (ht * vt);
+    if (mhz < 1000 || mhz > 1000000) return false;
+    const uint32_t t[NVK5_TIMING_WORDS] = {
+        NVK5_TIMING_TAG, (uint32_t)m.clock, m.width, (uint32_t)hs, (uint32_t)he, (uint32_t)ht,
+        m.height, (uint32_t)vs, (uint32_t)ve, (uint32_t)vt, (uint32_t)mhz,
+        m.hpositive ? 1u : 0u, m.vpositive ? 1u : 0u
+    };
+    if (nvk5_timing_bad(t, sizeof t)) return false;
+    for (unsigned i = 0; i < NVK5_TIMING_WORDS; i++) out[i] = t[i];
+    return true;
+}
+#endif
