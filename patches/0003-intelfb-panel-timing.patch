+#ifndef XEGFX_FIRMWARE_TIMING_H
+#define XEGFX_FIRMWARE_TIMING_H
+#include "panel-timing.h"
+struct XeGfxFirmwareTiming {
+    uint32_t conf, plane, size, ht, hs, vt, vs, ddi, frames;
+    uint64_t elapsed;
+};
+// ICL+ format occupies bits 27:23. XRGB8888 is 8 in that field (4 << 24).
+// Definitions: pinned i915/display/skl_universal_plane_regs.h and i915_reg.h.
+static inline bool xeFirmwareMode(const XeGfxFirmwareTiming &s, XeGfxPanelMode &m)
+{
+    if ((s.conf & 0xc0000000) != 0xc0000000 || !(s.plane & 0x80000000) ||
+        ((s.plane >> 23) & 31) != 8 || (s.plane & (7u << 10)) ||
+        (s.plane & (1u << 20)) || s.frames < 10 || s.frames > 500 ||
+        s.elapsed < 400000000 || s.elapsed > 2000000000) return false;
+    const uint32_t w=(s.ht&65535)+1, h=(s.vt&65535)+1;
+    const uint32_t ht=(s.ht>>16)+1, vt=(s.vt>>16)+1;
+    const uint32_t hs=(s.hs&65535)+1, he=(s.hs>>16)+1;
+    const uint32_t vs=(s.vs&65535)+1, ve=(s.vs>>16)+1;
+    if (w!=(s.size&65535)+1 || h!=(s.size>>16)+1 || ht<=w || vt<=h ||
+        hs<w || he<=hs || he>ht || vs<h || ve<=vs || ve>vt) return false;
+    const uint64_t mhz=(uint64_t)s.frames*1000000000000ull/s.elapsed;
+    m={ (uint64_t)ht*vt*mhz/1000, w,ht-w,hs-w,he-hs,h,vt-h,vs-h,ve-vs,
+        s.ddi&(1u<<16),s.ddi&(1u<<17) };
+    uint32_t t[NVK5_TIMING_WORDS];return xegfxPanelTiming(m,t);
+}
+// Use a cached EDID's exact *nominal* clock only when every timing field and
+// polarity agrees with this boot's registers and its frame counter agrees too.
+// This is not a PLL readout or permission to program display registers.
+static inline bool xeFirmwareEDIDTiming(const XeGfxFirmwareTiming &s,
+                                        const uint8_t *edid, unsigned bytes, uint32_t *out)
+{
+    XeGfxPanelMode live={};
+    if (!out || !edid || !xeFirmwareMode(s,live) || bytes<128 || bytes>512 || bytes%128 ||
+        bytes!=128u*(1u+edid[126]) || edid[0] || edid[7] || edid[18]!=1) return false;
+    for (unsigned i=1;i<7;i++) if(edid[i]!=255) return false;
+    for (unsigned block=0;block<bytes;block+=128) {
+        unsigned sum=0;for(unsigned i=0;i<128;i++) sum+=edid[block+i];
+        if(sum&255) return false;
+    }
+    bool found=false;uint32_t selected[NVK5_TIMING_WORDS]={};
+    for(unsigned off=54;off+18<=126;off+=18) {
+        const uint8_t *d=edid+off;
+        if(!(d[0]|d[1]) || (d[17]&0x80) || (d[17]&0x18)!=0x18) continue;
+        XeGfxPanelMode m={ (uint64_t)(d[0]|(d[1]<<8))*10000,
+            (uint32_t)(d[2]|((d[4]&0xf0)<<4)), (uint32_t)(d[3]|((d[4]&15)<<8)),
+            (uint32_t)(d[8]|((d[11]&0xc0)<<2)), (uint32_t)(d[9]|((d[11]&0x30)<<4)),
+            (uint32_t)(d[5]|((d[7]&0xf0)<<4)), (uint32_t)(d[6]|((d[7]&15)<<8)),
+            (uint32_t)((d[10]>>4)|((d[11]&12)<<2)), (uint32_t)((d[10]&15)|((d[11]&3)<<4)),
+            (uint32_t)(d[17]&2), (uint32_t)(d[17]&4) };
+        if(m.width!=live.width || m.height!=live.height || m.hblank!=live.hblank || m.vblank!=live.vblank ||
+            m.hoffset!=live.hoffset || m.hpulse!=live.hpulse || m.voffset!=live.voffset || m.vpulse!=live.vpulse ||
+            !!m.hpositive!=!!live.hpositive || !!m.vpositive!=!!live.vpositive) continue;
+        uint32_t t[NVK5_TIMING_WORDS];if(!xegfxPanelTiming(m,t)) continue;
+        const uint64_t nominal=t[NVK5_T_REFRESH_MHZ];
+        const uint64_t measured=(uint64_t)s.frames*1000000000000ull/s.elapsed;
+        const uint64_t difference=nominal>measured?nominal-measured:measured-nominal;
+        if(difference*100>nominal*5) continue;
+        if(found) for(unsigned i=0;i<NVK5_TIMING_WORDS;i++) if(selected[i]!=t[i]) return false;
+        for(unsigned i=0;i<NVK5_TIMING_WORDS;i++) selected[i]=t[i];
+        found=true;
+    }
+    if(found) for(unsigned i=0;i<NVK5_TIMING_WORDS;i++) out[i]=selected[i];
+    return found;
+}
+#endif
