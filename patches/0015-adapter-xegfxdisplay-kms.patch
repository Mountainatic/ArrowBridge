+/*
+ * xegfx_kms_kapi.h -- XeGfx KMS KAPI v1 (read-only) and adapter-local types.
+ *
+ * Two clearly separated parts:
+ *
+ *   Part A  Wire ABI.  The function table is published by the core kext as
+ *           the 8-byte OSData property "xegfx-kms-kapi".  These definitions
+ *           must match gpu/xkpi/src/i915/xg_display_hook.c exactly.
+ *
+ *   Part B  Adapter-local mode/connector containers.  These are NOT part of
+ *           the v1 wire ABI.  They are kept (verbatim from the original
+ *           draft) so the M3a read-only mode-table code in XeGfxDisplay.cpp
+ *           continues to compile unchanged.
+ *
+ * Everything here is C and C++ compatible; the table is plain-old-data with
+ * fixed-width fields and no compiler-dependent packing.
+ */
+#ifndef _XEGFX_KMS_KAPI_H_
+#define _XEGFX_KMS_KAPI_H_
+
+#include <stdint.h>
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* ====================================================================== */
+/* Part A: KAPI v1 wire ABI                                               */
+/* ====================================================================== */
+
+#define XEGFX_KMS_KAPI_MAGIC        0x58474B4DU  /* 'XGKM' */
+#define XEGFX_KMS_KAPI_VERSION      1U
+#define XEGFX_KMS_KAPI_SIZE         136U
+
+/* Table flags.  v1 is read-only: no setMode/flip/vblank implementation. */
+#define XEGFX_KMS_KAPI_FLAG_READ_ONLY    (1U << 0)
+
+/* IOReturn values, repeated here so the kext does not need IOKit headers. */
+#define XEGFX_OK                    0U
+#define XEGFX_ERR_UNSUPPORTED       0xE00002C7U  /* kIOReturnUnsupported   */
+#define XEGFX_ERR_INVALID           0xE00002C2U  /* kIOReturnBadArgument   */
+#define XEGFX_ERR_NO_MEMORY         0xE00002BDU  /* kIOReturnNoMemory      */
+#define XEGFX_ERR_BUSY              0xE00002D5U  /* kIOReturnBusy          */
+#define XEGFX_ERR_NOT_READY         0xE00002D8U  /* kIOReturnNotReady      */
+#define XEGFX_ERR_NOT_FOUND         0xE00002F0U  /* kIOReturnNotFound      */
+
+/* Connector type (KAPI view, not VBT device_type). */
+enum {
+    XEGFX_CONN_EDP = 0,
+    XEGFX_CONN_DP  = 1,
+    XEGFX_CONN_HDMI = 2,
+    XEGFX_CONN_DSI = 3,
+    XEGFX_CONN_UNKNOWN = 4,
+};
+
+/* Flags word of struct XeGfxKmsConnectorInfo. */
+enum {
+    XEGFX_CONN_FLAG_INTERNAL   = 1U << 0,  /* eDP / internal panel        */
+    XEGFX_CONN_FLAG_DP         = 1U << 1,  /* DisplayPort signalling      */
+    XEGFX_CONN_FLAG_HDMI       = 1U << 2,  /* HDMI/TMDS signalling        */
+    XEGFX_CONN_FLAG_AUX        = 1U << 3,  /* aux_channel byte is non-zero */
+    XEGFX_CONN_FLAG_LSPCON     = 1U << 4,  /* LSPCON present              */
+    XEGFX_CONN_FLAG_EFP_ROUTED = 1U << 5,  /* efp_routed bit set          */
+};
+
+/* ---- getTiming output -------------------------------------------------- */
+
+/*
+ * Exactly the 13 u32 words captured by M2c in "measured-panel-timing".
+ * This is the NVK5 timing tuple: word 0 is the tag, word 10 is the refresh
+ * rate in milli-Hz (pixelClockHz * 1000 / (htotal * vtotal)), words 11/12
+ * are hsync/vsync polarity flags.  The core validates all of this before it
+ * publishes a timing; an adapter must still check `tag` because the same
+ * buffer is used for "no timing".
+ */
+#define XEGFX_KMS_TIMING_WORDS      13U
+#define XEGFX_KMS_TIMING_BYTES      52U
+
+struct XeGfxKmsPanelTiming {
+    uint32_t tag;              /* 0x4b350001 when valid                   */
+    uint32_t pixelClockHz;     /* NVK5 wire clock, Hz; not DRM kHz        */
+    uint32_t hVisible;
+    uint32_t hSyncStart;
+    uint32_t hSyncEnd;
+    uint32_t hTotal;
+    uint32_t vVisible;
+    uint32_t vSyncStart;
+    uint32_t vSyncEnd;
+    uint32_t vTotal;
+    uint32_t refreshMilliHz;   /* word 10: milli-Hz                       */
+    uint32_t hSyncPositive;    /* 0/1                                     */
+    uint32_t vSyncPositive;    /* 0/1                                     */
+};
+
+/* ---- getConnectorInfo output ------------------------------------------- */
+
+/*
+ * 46 u32 words.  `size` must be set to sizeof(struct XeGfxKmsConnectorInfo)
+ * (184) by the caller; the core rejects any other size, which is the ABI
+ * version check for this struct.
+ *
+ * Raw VBT semantics are preserved on purpose (v1 is discovery only):
+ *   - `handle`, `deviceType`, `extendedType`, `port`, `auxChannel`,
+ *     `ddcPin`, `i2cPin`, `targetAddr` come straight from the 40-byte
+ *     child_device_config record.
+ *   - `dpMaxLaneCount` is the raw 2-bit VBT value (0..3); physical lanes =
+ *     value + 1 (VBT >= 244).  The core does not translate it.
+ *   - `dpMaxLinkRate` is the raw 3-bit VBT value (0..7); M3c maps it to a
+ *     bit rate.
+ *   - `auxChannel` is the raw VBT byte (0x40/0x10/0x20/...), not an i915
+ *     AUX_CH_* enum; mapping is platform specific and is M3c's job.
+ *   - `panelWidthMm`/`panelHeightMm` are 0 until EDID parsing exists.
+ */
+#define XEGFX_KMS_CONNECTOR_WORDS   46U
+#define XEGFX_KMS_CONNECTOR_BYTES   184U
+
+struct XeGfxKmsConnectorInfo {
+    uint32_t size;             /* caller: sizeof(struct ...) == 184        */
+    uint32_t index;            /* 0-based connector index                 */
+    uint32_t childIndex;       /* VBT child device index (same as index)  */
+    uint32_t handle;           /* VBT child handle (u16 widened)          */
+    uint32_t deviceType;       /* VBT device_type                         */
+    uint32_t extendedType;     /* VBT extended_type                       */
+    uint32_t type;             /* XEGFX_CONN_*                            */
+    uint32_t port;             /* VBT dvo_port                            */
+    uint32_t auxChannel;       /* raw VBT aux_channel byte                */
+    uint32_t ddcPin;
+    uint32_t i2cPin;
+    uint32_t targetAddr;
+
+    uint32_t dpSupport;        /* 0/1                                     */
+    uint32_t hdmiSupport;      /* 0/1                                     */
+    uint32_t tmdsSupport;      /* 0/1                                     */
+    uint32_t dpMaxLaneCount;   /* raw 2-bit VBT value                     */
+    uint32_t dpMaxLinkRate;    /* raw 3-bit VBT value                     */
+
+    uint32_t efpRouted;        /* 0/1                                     */
+    uint32_t laneReversal;     /* 0/1                                     */
+    uint32_t lspcon;           /* 0/1                                     */
+    uint32_t iboost;           /* 0/1                                     */
+    uint32_t hpdInvert;        /* 0/1                                     */
+    uint32_t useVbtVswing;     /* 0/1                                     */
+
+    uint32_t dpGpioIndex;
+    uint32_t dpGpioPinNum;
+    uint32_t dpUsbTypeC;       /* 0/1                                     */
+    uint32_t tbt;              /* 0/1                                     */
+    uint32_t dpPortTraceLength;
+    uint32_t efpIndex;
+
+    uint32_t pipeCap;          /* bits 0..1                               */
+    uint32_t hpdStatus;        /* bits 0..1                               */
+    uint32_t integratedEncoder;/* 0/1                                     */
+    uint32_t dvoWiring;
+    uint32_t dvoFunction;
+
+    uint32_t panelWidthMm;     /* 0 until EDID (M3c)                      */
+    uint32_t panelHeightMm;    /* 0 until EDID (M3c)                      */
+    uint32_t flags;            /* XEGFX_CONN_FLAG_*                       */
+    uint32_t reserved[9];      /* must be 0; future expansion             */
+};
+
+/* ---- the function table ------------------------------------------------ */
+
+/*
+ * v1 slots.  NULL means "not implemented in this version":
+ *   getEdid             NULL (M3c)
+ *   setMode             NULL (M3/M3c)
+ *   flip                NULL (M3c/M4, likely via callPlatformFunction)
+ *   vblank              NULL (M3c)
+ *
+ * Calling context: all functions are called from the adapter kext, i.e. an
+ * IOKit kernel thread / process context.  They must not sleep, must not
+ * take the i915 display power well, and must be safe to call with a
+ * userspace-originated request.  v1 functions only copy static data.
+ */
+typedef void (*XeGfxKmsVblankProc)(void *arg, uint64_t count, uint32_t deltaUs);
+
+struct XeGfxKmsKapi {
+    /* Header.  Check magic, version and size before touching any slot. */
+    uint32_t magic;            /* XEGFX_KMS_KAPI_MAGIC                    */
+    uint32_t version;          /* XEGFX_KMS_KAPI_VERSION                  */
+    uint32_t size;             /* sizeof(struct XeGfxKmsKapi) == 136      */
+    uint32_t flags;            /* XEGFX_KMS_KAPI_FLAG_*                   */
+
+    /* M1/M3b read-only discovery. */
+    uint32_t (*getTiming)(void *ctx, uint32_t fbIndex,
+                          struct XeGfxKmsPanelTiming *out);
+    uint32_t (*getConnectorInfo)(void *ctx, uint32_t index,
+                                 struct XeGfxKmsConnectorInfo *out);
+
+    /* M3c and later.  NULL in v1. */
+    uint32_t (*getEdid)(void *ctx, uint32_t index, void *buf,
+                        uint32_t bufSize, uint32_t *outSize);
+    uint32_t (*setMode)(void *ctx, uint32_t fbIndex, uint32_t modeId);
+    uint32_t (*flip)(void *ctx, uint32_t fbIndex, uint64_t surfaceId,
+                     uint64_t cookie);
+    uint32_t (*vblank)(void *ctx, uint32_t fbIndex,
+                       XeGfxKmsVblankProc proc, void *arg);
+
+    uint64_t reserved[8];      /* must be 0                               */
+    void    *ctx;              /* opaque; NULL in v1                      */
+};
+
+#if defined(__cplusplus)
+static_assert(sizeof(struct XeGfxKmsPanelTiming) == XEGFX_KMS_TIMING_BYTES,
+              "XeGfxKmsPanelTiming must be 52 bytes");
+static_assert(offsetof(struct XeGfxKmsPanelTiming, refreshMilliHz) == 40,
+              "refreshMilliHz must be word 10");
+static_assert(sizeof(struct XeGfxKmsConnectorInfo) ==
+              XEGFX_KMS_CONNECTOR_BYTES,
+              "XeGfxKmsConnectorInfo must be 184 bytes");
+static_assert(offsetof(struct XeGfxKmsConnectorInfo, flags) == 144,
+              "flags must be word 36");
+static_assert(sizeof(struct XeGfxKmsKapi) == XEGFX_KMS_KAPI_SIZE,
+              "XeGfxKmsKapi must be 136 bytes");
+static_assert(offsetof(struct XeGfxKmsKapi, ctx) == 128,
+              "ctx must be at offset 128");
+#elif defined(__STDC_VERSION__) && __STDC_VERSION__ >= 201112L
+_Static_assert(sizeof(struct XeGfxKmsPanelTiming) == XEGFX_KMS_TIMING_BYTES,
+               "XeGfxKmsPanelTiming must be 52 bytes");
+_Static_assert(offsetof(struct XeGfxKmsPanelTiming, refreshMilliHz) == 40,
+               "refreshMilliHz must be word 10");
+_Static_assert(sizeof(struct XeGfxKmsConnectorInfo) ==
+               XEGFX_KMS_CONNECTOR_BYTES,
+               "XeGfxKmsConnectorInfo must be 184 bytes");
+_Static_assert(offsetof(struct XeGfxKmsConnectorInfo, flags) == 144,
+               "flags must be word 36");
+_Static_assert(sizeof(struct XeGfxKmsKapi) == XEGFX_KMS_KAPI_SIZE,
+               "XeGfxKmsKapi must be 136 bytes");
+_Static_assert(offsetof(struct XeGfxKmsKapi, ctx) == 128,
+               "ctx must be at offset 128");
+#endif
+
+/* ====================================================================== */
+/* Part B: adapter-local containers (NOT wire ABI; M3a compatibility)     */
+/* ====================================================================== */
+
+/*
+ * The original draft used these for its mode table.  M3a's
+ * buildMeasuredModeTable()/timingToIo() compile against them, so v1 keeps
+ * them verbatim.  New code should use struct XeGfxKmsPanelTiming for the
+ * KAPI result and convert into struct XeGfxKmsTiming locally.
+ */
+
+#define XEGFX_KMS_MAX_MODES       64
+#define XEGFX_KMS_MAX_CONNECTORS  8
+#define XEGFX_KMS_MAX_EDID        512
+#define XEGFX_KMS_MAX_SCANOUT     4
+
+/* Capability bits for struct XeGfxKmsConnector.caps. */
+enum {
+    XEGFX_CONN_CAP_INTERNAL   = 1U << 0,
+    XEGFX_CONN_CAP_DSC        = 1U << 1,
+    XEGFX_CONN_CAP_HDR        = 1U << 2,
+    XEGFX_CONN_CAP_BACKLIGHT  = 1U << 3,
+    XEGFX_CONN_CAP_SCALER     = 1U << 4,
+};
+
+/* Adapter-local detailed timing (drm_display_mode without the DRM headers). */
+struct XeGfxKmsTiming {
+    uint32_t clockKHz;         /* drm_display_mode.clock is kHz already     */
+
+    uint16_t hdisplay;
+    uint16_t hsyncStart;
+    uint16_t hsyncEnd;
+    uint16_t htotal;
+    uint16_t hskew;
+
+    uint16_t vdisplay;
+    uint16_t vsyncStart;
+    uint16_t vsyncEnd;
+    uint16_t vtotal;
+
+    uint16_t vscan;            /* 1 unless interlaced                       */
+
+    uint32_t flags;            /* XEGFX_TF_* below                          */
+
+    uint8_t  bpc;              /* 6, 8, 10, 12                              */
+    uint8_t  pixelEncoding;    /* 0=RGB 1=YCbCr444 2=YCbCr422 3=YCbCr420    */
+    uint8_t  colorimetry;      /* 0=sRGB/ITU-R BT.709 1=BT.2020             */
+    uint8_t  dynamicRange;     /* 0=SDR 1=HDR                               */
+
+    uint8_t  dsc;              /* 1 = this mode needs DSC                    */
+    uint8_t  reserved[7];
+};
+
+enum {
+    XEGFX_TF_HSYNC_POS   = 1U << 0,
+    XEGFX_TF_VSYNC_POS   = 1U << 1,
+    XEGFX_TF_INTERLACED  = 1U << 2,
+    XEGFX_TF_DOUBLESCAN  = 1U << 3,
+    XEGFX_TF_DBLCLK      = 1U << 4,
+    XEGFX_TF_PREFERRED   = 1U << 5,
+    XEGFX_TF_HIDPI_2X    = 1U << 6,
+};
+
+struct XeGfxKmsMode {
+    uint32_t  modeId;          /* IODisplayModeID, stable per connector    */
+    struct XeGfxKmsTiming t;
+
+    uint32_t  nominalWidth;    /* point size; raster normally, half for 2x */
+    uint32_t  nominalHeight;
+
+    uint32_t  refreshMHz;      /* milli-Hz: 240000 for 240 Hz               */
+
+    uint32_t  flags;           /* XEGFX_MODE_* below                        */
+    uint32_t  reserved;
+};
+
+enum {
+    XEGFX_MODE_VALID    = 1U << 0,
+    XEGFX_MODE_CURRENT  = 1U << 1,
+    XEGFX_MODE_SCALED   = 1U << 2,
+};
+
+struct XeGfxKmsConnector {
+    uint32_t        handle;
+    uint32_t        type;          /* XEGFX_CONN_*                         */
+    uint32_t        index;
+    uint32_t        headMask;
+    uint32_t        caps;          /* XEGFX_CONN_CAP_*                     */
+
+    uint16_t        edidSize;
+    uint8_t         edid[XEGFX_KMS_MAX_EDID];
+
+    uint16_t        panelWidthMm;
+    uint16_t        panelHeightMm;
+
+    uint32_t        numModes;
+    struct XeGfxKmsMode modes[XEGFX_KMS_MAX_MODES];
+
+    uint32_t        currentMode;
+    uint32_t        preferredMode;
+
+    uint16_t        scalerMaxDownscale2x;
+    uint16_t        reserved0;
+};
+
+struct XeGfxKmsScanoutInfo {
+    uint64_t phys;
+    void    *kva;
+    uint64_t length;
+    uint32_t pitch;
+    uint32_t width;
+    uint32_t height;
+    uint32_t bpp;
+    uint32_t surfaceId;
+    uint32_t reserved;
+};
+
+struct XeGfxKmsCaps {
+    uint32_t numHeads;
+    uint32_t numConnectors;
+    uint32_t pitchAlignment;
+    uint32_t maxWidthInPixels;
+    uint32_t maxHeightInPixels;
+    uint32_t maxCursorSizeInPixels;
+    uint32_t cursorCompositionModes;
+    uint32_t contiguousPhysicalMappings;
+    uint32_t vramBaseLow;
+    uint32_t vramSize;
+};
+
+/* ====================================================================== */
+/* Part C: M3d scanout extension (v1 table, reserved[0..2] typed)          */
+/* ====================================================================== */
+
+/*
+ * docs/16-M3D-SCANOUT-KAPI.md: the core extends the *unchanged* v1 table by
+ * typing reserved[0..2] as three function pointers and setting FLAG_SCANOUT.
+ * Magic/version/size stay 1/136 so an older reader is unaffected; an older
+ * core (no SCANOUT flag) leaves the slots zero and the adapter must reject
+ * the extension.  Order of checks: readable table pointer -> magic ->
+ * version -> size -> FLAG_SCANOUT -> three non-NULL slots.  Nothing else.
+ *
+ * Thread context: alloc/free may take a mutex and touch the GGTT, so they are
+ * only legal from a kernel thread (adapter start/enableController/open), never
+ * from an interrupt or a vblank callback.  They write no display register:
+ * the scanout is mapped into the GGTT but the display plane is untouched.
+ */
+#define XEGFX_KMS_KAPI_FLAG_SCANOUT       (1U << 1)
+
+#define XEGFX_KMS_SCANOUT_MAX            2U
+#define XEGFX_KMS_SCANOUT_MAX_WIDTH      5120U
+#define XEGFX_KMS_SCANOUT_MAX_HEIGHT     2880U
+#define XEGFX_KMS_SCANOUT_MAX_BYTES      (64ULL << 20)
+#define XEGFX_KMS_SCANOUT_FLAG_ZERO      (1U << 0)  /* zero-fill buffer */
+#define XEGFX_KMS_SCANOUT_BYTES          48U
+
+/* Slot names: reserved[0]=alloc, reserved[1]=get, reserved[2]=free. */
+typedef uint32_t (*XeGfxKmsAllocScanoutFn)(void *ctx, uint32_t width,
+                                           uint32_t height,
+                                           uint32_t bytesPerPixel,
+                                           uint32_t flags,
+                                           struct XeGfxKmsScanoutInfo *out);
+typedef uint32_t (*XeGfxKmsGetScanoutInfoFn)(void *ctx, uint32_t handle,
+                                             struct XeGfxKmsScanoutInfo *out);
+typedef uint32_t (*XeGfxKmsFreeScanoutFn)(void *ctx, uint32_t handle);
+
+#if defined(__cplusplus)
+static_assert(sizeof(struct XeGfxKmsScanoutInfo) == XEGFX_KMS_SCANOUT_BYTES,
+              "XeGfxKmsScanoutInfo must be 48 bytes");
+static_assert(offsetof(struct XeGfxKmsScanoutInfo, phys) == 0,
+              "scanout.phys must be at offset 0");
+static_assert(offsetof(struct XeGfxKmsScanoutInfo, kva) == 8,
+              "scanout.kva must be at offset 8");
+static_assert(offsetof(struct XeGfxKmsScanoutInfo, length) == 16,
+              "scanout.length must be at offset 16");
+static_assert(offsetof(struct XeGfxKmsScanoutInfo, pitch) == 24,
+              "scanout.pitch must be at offset 24");
+static_assert(offsetof(struct XeGfxKmsScanoutInfo, width) == 28,
+              "scanout.width must be at offset 28");
+static_assert(offsetof(struct XeGfxKmsScanoutInfo, height) == 32,
+              "scanout.height must be at offset 32");
+static_assert(offsetof(struct XeGfxKmsScanoutInfo, bpp) == 36,
+              "scanout.bpp must be at offset 36");
+static_assert(offsetof(struct XeGfxKmsScanoutInfo, surfaceId) == 40,
+              "scanout.surfaceId must be at offset 40");
+static_assert(offsetof(struct XeGfxKmsScanoutInfo, reserved) == 44,
+              "scanout.reserved must be at offset 44");
+#endif
+
+/* True when the table advertises the complete M3d extension.  The caller must
+ * have validated that the table pointer itself is in kernel memory first. */
+static inline int xegfxKmsHasScanout(const struct XeGfxKmsKapi *k)
+{
+    if (k == NULL) return 0;
+    if (k->magic != XEGFX_KMS_KAPI_MAGIC) return 0;
+    if (k->version != XEGFX_KMS_KAPI_VERSION) return 0;
+    if (k->size != XEGFX_KMS_KAPI_SIZE) return 0;
+    if ((k->flags & XEGFX_KMS_KAPI_FLAG_SCANOUT) == 0) return 0;
+    if (k->reserved[0] == 0 || k->reserved[1] == 0 || k->reserved[2] == 0)
+        return 0;
+    return 1;
+}
+
+/* Unknown flag bits mean a newer core; the adapter must not guess. */
+static inline int xegfxKmsFlagsKnown(uint32_t flags)
+{
+    return (flags & ~(XEGFX_KMS_KAPI_FLAG_READ_ONLY |
+                      XEGFX_KMS_KAPI_FLAG_SCANOUT)) == 0;
+}
+
+static inline XeGfxKmsAllocScanoutFn
+xegfxKmsAllocScanout(const struct XeGfxKmsKapi *k)
+{
+    if (!xegfxKmsHasScanout(k)) return NULL;
+    return (XeGfxKmsAllocScanoutFn)(uintptr_t)k->reserved[0];
+}
+
+static inline XeGfxKmsGetScanoutInfoFn
+xegfxKmsGetScanoutInfoFn(const struct XeGfxKmsKapi *k)
+{
+    if (!xegfxKmsHasScanout(k)) return NULL;
+    return (XeGfxKmsGetScanoutInfoFn)(uintptr_t)k->reserved[1];
+}
+
+static inline XeGfxKmsFreeScanoutFn
+xegfxKmsFreeScanout(const struct XeGfxKmsKapi *k)
+{
+    if (!xegfxKmsHasScanout(k)) return NULL;
+    return (XeGfxKmsFreeScanoutFn)(uintptr_t)k->reserved[2];
+}
+
+#ifdef __cplusplus
+} /* extern "C" */
+#endif
+
+#endif /* _XEGFX_KMS_KAPI_H_ */
