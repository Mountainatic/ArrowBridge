+#ifndef XEGFX_FIRMWARE_TIMING_H
+#define XEGFX_FIRMWARE_TIMING_H
+#include "panel-timing.h"
+struct XeGfxFirmwareTiming {
+    uint32_t conf, plane, size, ht, hs, vt, vs, ddi, frames;
+    uint64_t elapsed;
+};
+// ICL+ format occupies bits 27:23. XRGB8888 is 8 in that field (4 << 24).
+// Definitions: pinned i915/display/skl_universal_plane_regs.h and i915_reg.h.
+static inline bool xeFirmwareMode(const XeGfxFirmwareTiming &s, XeGfxPanelMode &m)
+{
+    if ((s.conf & 0xc0000000) != 0xc0000000 || !(s.plane & 0x80000000) ||
+        ((s.plane >> 23) & 31) != 8 || (s.plane & (7u << 10)) ||
+        (s.plane & (1u << 20)) || s.frames < 10 || s.frames > 500 ||
+        s.elapsed < 400000000 || s.elapsed > 2000000000) return false;
+    const uint32_t w=(s.ht&65535)+1, h=(s.vt&65535)+1;
+    const uint32_t ht=(s.ht>>16)+1, vt=(s.vt>>16)+1;
+    const uint32_t hs=(s.hs&65535)+1, he=(s.hs>>16)+1;
+    const uint32_t vs=(s.vs&65535)+1, ve=(s.vs>>16)+1;
+    if (w!=(s.size&65535)+1 || h!=(s.size>>16)+1 || ht<=w || vt<=h ||
+        hs<w || he<=hs || he>ht || vs<h || ve<=vs || ve>vt) return false;
+    const uint64_t mhz=(uint64_t)s.frames*1000000000000ull/s.elapsed;
+    m={ (uint64_t)ht*vt*mhz/1000, w,ht-w,hs-w,he-hs,h,vt-h,vs-h,ve-vs,
+        s.ddi&(1u<<16),s.ddi&(1u<<17) };
