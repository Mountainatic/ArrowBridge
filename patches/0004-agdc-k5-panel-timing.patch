+static int gXeTimingProbeState = 0;
+static char gXeTimingProbe[512] = "not probed";
+// A single BAR0 read-only snapshot. Never map BAR2 or read stolen framebuffer memory.
+// Register offsets and sync polarity follow the pinned i915_reg.h, display 14.
+static bool xeProbePanelTiming(IOService *service)
+{
+    IOPCIDevice *pci = service ? OSDynamicCast(IOPCIDevice, service->getProvider()) : nullptr;
+    if (!pci || pci->configRead16(0) != 0x8086 || pci->configRead16(2) != 0x7d67 ||
+        !(pci->configRead16(4) & 2)) return false;
+    IOMemoryDescriptor *bar = pci->getDeviceMemoryWithRegister(kIOPCIConfigBaseAddress0);
+    IOMemoryMap *map = bar ? bar->map(kIOMapInhibitCache) : nullptr;
+    if (!map) return false;
+    bool ok = false;
+    if (map->getLength() >= 0x71000) {
+        volatile uint32_t *r = (volatile uint32_t *)map->getVirtualAddress();
+        const uint32_t conf = r[0x70008/4], plane = r[0x70180/4], size = r[0x70190/4];
+        const uint32_t ht = r[0x60000/4], hs = r[0x60008/4], vt = r[0x6000c/4], vs = r[0x60014/4];
+        const uint32_t ddi = r[0x60400/4], surf = r[0x7019c/4];
+        uint64_t before, after, elapsed;
+        clock_get_uptime(&before); const uint32_t a = r[0x70040/4];
+        IOSleep(500);
+        const uint32_t b = r[0x70040/4]; clock_get_uptime(&after);
+        absolutetime_to_nanoseconds(after - before, &elapsed);
+        const uint32_t frames = b-a;
+        snprintf(gXeTimingProbe, sizeof gXeTimingProbe,
+                 "pipe=A conf=%#x plane=%#x size=%#x surf=%#x ht=%#x hs=%#x vt=%#x vs=%#x ddi=%#x frames=%u ns=%llu",
+                 conf, plane, size, surf, ht, hs, vt, vs, ddi, frames, elapsed);
+        const XeGfxFirmwareTiming snapshot = {conf, plane, size, ht, hs, vt, vs, ddi, frames, elapsed};
+        XeGfxPanelMode measuredMode = {}; uint32_t measured[NVK5_TIMING_WORDS];
+        ok = xeFirmwareMode(snapshot, measuredMode) && xegfxPanelTiming(measuredMode, measured);
+        if (ok) {
+            gXeFirmwareTiming = snapshot;
+            service->setProperty("XeGfxMeasuredPanelTiming", measured, sizeof measured);
+            uint32_t exact[NVK5_TIMING_WORDS];
+            if (xeFirmwareEDIDTiming(snapshot, gXePanelEDID, gXePanelEDIDBytes, exact))
+                service->setProperty("XeGfxMatchedEDIDPanelTiming", exact, sizeof exact);
+            else service->removeProperty("XeGfxMatchedEDIDPanelTiming");
+        }
+        if (conf != r[0x70008/4] || plane != r[0x70180/4] || size != r[0x70190/4] ||
+            surf != r[0x7019c/4] || ht != r[0x60000/4] || vt != r[0x6000c/4]) ok = false;
+        if (!ok) { service->removeProperty("XeGfxMeasuredPanelTiming"); service->removeProperty("XeGfxMatchedEDIDPanelTiming"); }
+    }
+    map->release(); return ok;
+}
+static bool xeReadPanelTiming(IOService *service)
+{
+    // The firmware framebuffer reports IOFB0Hz and no detailed timing on this
+    // machine. Read the active registers once; a cached EDID is permitted only
+    // by the exact geometry/polarity and live frame-counter checks in the helper.
+    if (!xeProbePanelTiming(service)) return false;
+    if (!xeFirmwareEDIDTiming(gXeFirmwareTiming, gXePanelEDID, gXePanelEDIDBytes, gXePanelTiming)) return false;
+    strlcpy(gXePanelTimingSource, "cached-panel-EDID matched to live registers/counter", sizeof gXePanelTimingSource);
+    return true;
+}
