+/* Opt-in bounded Vulkan first-failure journal. No retry or resource retirement. */
+#pragma once
+#include <fcntl.h>
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stdlib.h>
+#include <time.h>
+#include <unistd.h>
+
+typedef struct {
+    uint64_t id;
+    VkCommandBuffer cb;
+    VkFence fence;
+    uint32_t witness;
+    int submit_called;
+    char who[768];
+} nvmtl_loss_context;
+static pthread_once_t nvmtl_loss_once = PTHREAD_ONCE_INIT;
+static pthread_mutex_t nvmtl_loss_lock = PTHREAD_MUTEX_INITIALIZER;
+static _Atomic uint64_t nvmtl_loss_ids;
+static _Atomic int nvmtl_loss_fd = -1;
+static unsigned nvmtl_loss_lines, nvmtl_loss_reserved;
+static void nvmtl_loss_open(void) {
+    /* Usually opt-in through NVMTL_FIRST_LOSS_TRACE=1. The journal can also be
+     * enabled by root creating /private/tmp/xemtl-first-loss-enable, because a
+     * launchd-started WindowServer cannot be given an environment from outside
+     * the job definition. NVMTL_FIRST_LOSS_TRACE=0 still forces it off. */
+    const char *on=getenv("XEMTL_FIRST_LOSS_TRACE");
+    int sentinel = on == NULL && access("/private/tmp/xemtl-first-loss-enable", F_OK) == 0;
+    if (on && strcmp(on,"0") == 0) return;
+    if ((!on || strcmp(on,"1")) && !sentinel) return;
+    char path[1024];const char *dir=getenv("XEMTL_FIRST_LOSS_DIR");
+    int n=snprintf(path,sizeof path,"%s/xemtl-first-loss-%d.jsonl",dir?dir:"/private/tmp",getpid());
+    if(n<0 || (size_t)n>=sizeof path)return;
+    nvmtl_loss_fd=open(path,O_WRONLY|O_CREAT|O_EXCL|O_APPEND|O_NOFOLLOW|O_CLOEXEC,0600);
+}
+static void nvmtl_loss_bootstrap_env(void) {
+    /* The sentinel that enables this journal also arms the libdrm XEGFX_IOCTL
+     * trace in this process before libvulkan_intel opens libdrm. A
+     * launchd-started WindowServer cannot be given an environment from outside
+     * the job definition, so the plugin sets it from here. */
+    static _Atomic int done;
+    if (atomic_exchange(&done, 1)) return;
+    if (getenv("XEMTL_DRM_TRACE")) return;
+    if (access("/private/tmp/xemtl-first-loss-enable", F_OK) == 0)
+        setenv("XEMTL_DRM_TRACE", "1", 1);
+}
+static void nvmtl_loss_quote(const char *s,char *out,size_t cap) {
+    size_t j=0; if(!s)s="";
+    for(size_t i=0;s[i]&&j+2<cap;i++) {
+        unsigned char c=(unsigned char)s[i];
+        if(c=='"'||c=='\\')out[j++]='\\';
+        out[j++]=c>=32?c:'?';
+    }
+    out[j]=0;
+}
+static uint64_t nvmtl_loss_now(void) {
+    struct timespec t;clock_gettime(CLOCK_MONOTONIC_RAW,&t);
+    return (uint64_t)t.tv_sec*1000000000ull+t.tv_nsec;
+}
+static void nvmtl_loss_event(const char *event,const nvmtl_loss_context *ctx,int called,int result,
+                            int before,int after,uint64_t elapsed,uintptr_t object0,uintptr_t object1,uint64_t amount,int reserved) {
+    pthread_once(&nvmtl_loss_once,nvmtl_loss_open);
+    if(nvmtl_loss_fd<0)return;
+    pthread_mutex_lock(&nvmtl_loss_lock);
+    if(nvmtl_loss_fd<0){pthread_mutex_unlock(&nvmtl_loss_lock);return;}
+    if((!reserved&&nvmtl_loss_lines>=2048)||(reserved==1&&nvmtl_loss_reserved>=32)) {
+        pthread_mutex_unlock(&nvmtl_loss_lock);return;
+    }
+    if(reserved)nvmtl_loss_reserved++;else nvmtl_loss_lines++;
+    char who[1550],ev[160],actual[32],line[3200];uint64_t tid=0;
+    nvmtl_loss_quote(ctx?ctx->who:"",who,sizeof who);nvmtl_loss_quote(event,ev,sizeof ev);
+    if(called)snprintf(actual,sizeof actual,"%d",result);else strcpy(actual,"null");
+    pthread_threadid_np(NULL,&tid);struct timespec wall;clock_gettime(CLOCK_REALTIME,&wall);
+    int n=snprintf(line,sizeof line,
+      "{\"event\":\"%s\",\"pid\":%d,\"tid\":%llu,\"instance\":\"%p\",\"unixNs\":%llu,\"monotonicNs\":%llu,"
+      "\"submitID\":%llu,\"who\":\"%s\",\"commandBuffer\":\"%p\",\"fence\":\"%p\",\"queue\":\"%p\",\"witness\":%u,"
+      "\"actualCall\":%s,\"actualResult\":%s,\"reportedResult\":%d,\"stateBefore\":%d,\"stateAfter\":%d,\"elapsedNs\":%llu,"
+      "\"object0\":\"0x%llx\",\"object1\":\"0x%llx\",\"amount\":%llu,\"noSurfaceHostRequested\":%s}\n",
+      ev,getpid(),(unsigned long long)tid,(void*)&g_state,
+      (unsigned long long)((uint64_t)wall.tv_sec*1000000000ull+wall.tv_nsec),(unsigned long long)nvmtl_loss_now(),
+      (unsigned long long)(ctx?ctx->id:0),who,(void*)(ctx?ctx->cb:NULL),(void*)(ctx?ctx->fence:NULL),(void*)g_queue,ctx?ctx->witness:0,
+      called?"true":"false",actual,result,before,after,(unsigned long long)elapsed,
+      (unsigned long long)object0,(unsigned long long)object1,(unsigned long long)amount,
+      getenv("XEMTL_NO_SURFACE_HOST")&&getenv("XEMTL_NO_SURFACE_HOST")[0]=='1'?"true":"false");
+    if(n>0&&(size_t)n<sizeof line) {
+        if(write(nvmtl_loss_fd,line,(size_t)n)!=n){close(nvmtl_loss_fd);nvmtl_loss_fd=-1;}
+        else if(reserved)fsync(nvmtl_loss_fd);
+    }
+    pthread_mutex_unlock(&nvmtl_loss_lock);
+}
+static void nvmtl_loss_context_init(nvmtl_loss_context *c,VkCommandBuffer cb,const char *who) {
+    memset(c,0,sizeof *c);c->id=atomic_fetch_add(&nvmtl_loss_ids,1)+1;c->cb=cb;
+    snprintf(c->who,sizeof c->who,"%s",who?who:"unspecified");
+}
+static _Atomic unsigned nvmtl_loss_report_requests;
+static VkResult nvmtl_loss_queue_submit(nvmtl_loss_context *c,const VkSubmitInfo *si,VkFence fence,int guard_state) {
+    c->fence=fence;int before=atomic_load(&g_state),called=!guard_state||before==1;c->submit_called=called;
+    nvmtl_loss_event("queue_submit_begin",c,0,0,before,before,0,
+        si->commandBufferCount>1?(uintptr_t)si->pCommandBuffers[0]:0,
+        si->commandBufferCount>2?(uintptr_t)si->pCommandBuffers[1]:0,si->commandBufferCount,0);
+    uint64_t t=nvmtl_loss_now();
+    VkResult result=called?pvkQueueSubmit(g_queue,1,si,fence):VK_ERROR_DEVICE_LOST;
+    nvmtl_loss_event("queue_submit_end",c,called,result,before,atomic_load(&g_state),nvmtl_loss_now()-t,0,0,0,result!=VK_SUCCESS);
+    /* Mesa queues retain the failure text until a device-status check reports
+     * it. Query once, without waiting or resubmitting, before our caller stops
+     * using the failed backend. Preserve the original queue result. */
+    if (called && result == VK_ERROR_DEVICE_LOST && nvmtl_loss_fd >= 0 &&
+        atomic_fetch_add(&nvmtl_loss_report_requests, 1) == 0) {
+        uint64_t query_start = nvmtl_loss_now();
+        VkResult status = pvkWaitForFences(g_dev, 1, &fence, VK_TRUE, 0);
+        nvmtl_loss_event("post_loss_status_query", c, 1, status,
+            atomic_load(&g_state), atomic_load(&g_state),
+            nvmtl_loss_now()-query_start, 0, 0, 0, 1);
+    }
+    return result;
+}
+static VkResult nvmtl_loss_wait(nvmtl_loss_context *c,uint64_t timeout) {
+    int before=atomic_load(&g_state);
+    nvmtl_loss_event("fence_wait_begin",c,0,0,before,before,0,0,0,timeout,0);
+    uint64_t t=nvmtl_loss_now();
+    VkResult r=pvkWaitForFences(g_dev,1,&c->fence,VK_TRUE,timeout);
+    nvmtl_loss_event("fence_wait_end",c,1,r,before,atomic_load(&g_state),nvmtl_loss_now()-t,0,0,timeout,r!=VK_SUCCESS&&r!=VK_TIMEOUT);
+    return r;
+}
+static void nvmtl_loss_mark_down(const char *why,const nvmtl_loss_context *c,int called,int result,uint64_t elapsed) {
+    int before=atomic_exchange(&g_state,-1);
+    if(before==1)nvlog("vk: FIRST_BACKEND_DOWN pid %d instance %p reason %s submit %llu cb %p actual_call %d result %d",
+        getpid(),(void*)&g_state,why,(unsigned long long)(c?c->id:0),(void*)(c?c->cb:NULL),called,result);
+    nvmtl_loss_event(before==1?why:"backend_down_already_observed",c,called,result,before,-1,elapsed,0,0,0,before==1?2:1);
+}
+
+/* Driver callback text is evidence, not an API return or a backend transition.
+ * Reserve the first error even after ordinary trace capacity is exhausted. */
+static _Atomic unsigned nvmtl_loss_driver_errors;
+static void nvmtl_loss_driver_message(const char *message, int error) {
+    nvmtl_loss_context c = {0};
+    snprintf(c.who, sizeof c.who, "%s", message ? message : "(no message)");
+    int state = atomic_load(&g_state);
+    int reserve = error ? (atomic_fetch_add(&nvmtl_loss_driver_errors, 1) == 0 ? 2 : 1) : 0;
+    nvmtl_loss_event(error ? "vulkan_driver_error" : "vulkan_driver_warning",
+        &c, 0, 0, state, state, 0, 0, 0, 0, reserve);
+}
