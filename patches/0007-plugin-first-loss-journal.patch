+#include <mach/mach_time.h>
+/* opt3: per-phase timing for the census. NVMTL_PROF(k) times the enclosing scope until it returns;
+ * nvmtl_prof_text() prints milliseconds per composite plus thousands of calls per composite and resets. */
+#define NVMTL_PROF_N 9
+static unsigned long long g_prof_us[NVMTL_PROF_N], g_prof_n[NVMTL_PROF_N];
+static const char *g_prof_names[NVMTL_PROF_N] = { "setmd", "setc", "surfin", "bindpipe", "texnew", "drawenc", "salloc", "sbuild", "supdate" };
+static double g_prof_scale;
+typedef struct { int k; uint64_t t0; } nvmtl_prof_state;
+static void nvmtl_prof_done(nvmtl_prof_state *s) {
+    if (!s) return;
+    uint64_t t1 = mach_absolute_time();
+    if (!g_prof_scale) { mach_timebase_info_data_t tb; mach_timebase_info(&tb); g_prof_scale = (double)tb.numer / (double)tb.denom; }
+    unsigned long long us = (unsigned long long)((double)(t1 - s->t0) * g_prof_scale / 1000.0);
+    __atomic_fetch_add(&g_prof_us[s->k], us, __ATOMIC_RELAXED);
+    __atomic_fetch_add(&g_prof_n[s->k], 1, __ATOMIC_RELAXED);
+}
+#define NVMTL_PROF(k) nvmtl_prof_state _nvp_ __attribute__((cleanup(nvmtl_prof_done))) = { (int)(k), mach_absolute_time() }
+static void nvmtl_prof_add(int k, uint64_t t0) { nvmtl_prof_state _s = { k, t0 }; nvmtl_prof_done(&_s); }
+static void nvmtl_prof_text(char *out, size_t n, unsigned long long frames) {
+    int off = 0;
+    if (!frames) frames = 1;
+    for (int k = 0; k < NVMTL_PROF_N; k++) {
+        unsigned long long us = __atomic_exchange_n(&g_prof_us[k], 0, __ATOMIC_RELAXED);
+        unsigned long long cnt = __atomic_exchange_n(&g_prof_n[k], 0, __ATOMIC_RELAXED);
+        if (us || cnt) off += snprintf(out + off, (size_t)(n - off), "; %s %.2fms/%.1fk", g_prof_names[k], (double)us / 1000.0 / (double)frames, (double)cnt / 1000.0 / (double)frames);
+    }
+}
