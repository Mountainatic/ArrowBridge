+// TEMP frame-rate instrumentation: per-composite commit/wait timing plus a runtime
+// no-wait A/B toggle.  Behaviour is unchanged unless XEMTL_WS_NO_WAIT=1 or the
+// sentinel /private/tmp/xemtl-ws-nowait exists.
+static _Atomic uint64_t nvmtl_cw_count, nvmtl_cw_commit_us, nvmtl_cw_wait_us, nvmtl_cw_wait_max_us;
+static _Atomic uint64_t nvmtl_cw_sched, nvmtl_cw_last, nvmtl_cw_surfin, nvmtl_cw_upload;
+static int nvmtl_ws_no_wait(void) {
+    static int on = -1; static uint64_t checked;
+    const uint64_t now = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+    if (on >= 0 && now - checked < 1000000000ull) return on;
+    int v = 0;
+    const char *e = getenv("XEMTL_WS_NO_WAIT");
+    if (e && e[0] == '1') v = 1;
+    else { FILE *f = fopen("/private/tmp/xemtl-ws-nowait", "r"); if (f) { v = 1; fclose(f); } }
+    if (v != on && on >= 0) nvlog("cw: no-wait %s", v ? "ON (scheduled branch)" : "off (waitUntilCompleted)");
+    on = v; checked = now; return v;
+}
+// <wtl> cw census extras: draws/host transfers from the Vulkan layer and the encoder-78 set counters
+void nvmtl_vk_frame_counts(uint64_t out[4]);
+static void nvmtl_census_extra(char *out, size_t n);
+static void nvmtl_cw_note(uint64_t commit_us, uint64_t wait_us, int scheduled) {
+    atomic_fetch_add(&nvmtl_cw_count, 1);
+    atomic_fetch_add(&nvmtl_cw_commit_us, commit_us);
+    atomic_fetch_add(&nvmtl_cw_wait_us, wait_us);
+    uint64_t mx = atomic_load(&nvmtl_cw_wait_max_us);
+    while (wait_us > mx && !atomic_compare_exchange_weak(&nvmtl_cw_wait_max_us, &mx, wait_us)) {}
+    if (scheduled) atomic_fetch_add(&nvmtl_cw_sched, 1);
+    const uint64_t n = atomic_load(&nvmtl_cw_count);
+    const uint64_t now = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+    uint64_t last = atomic_load(&nvmtl_cw_last);
+    if (n >= 60 && now - last > 2000000000ull && atomic_compare_exchange_strong(&nvmtl_cw_last, &last, now)) {
+        const double commit_avg = (double)atomic_load(&nvmtl_cw_commit_us) / 1000.0 / (double)n;
+        const double wait_avg = (double)atomic_load(&nvmtl_cw_wait_us) / 1000.0 / (double)n;
+        char extra[256]; nvmtl_census_extra(extra, sizeof extra);
+        char prof[256]; nvmtl_prof_text(prof, sizeof prof, (unsigned long long)n);
+        char xdiff[512]; nvmtl_xd_text(xdiff, sizeof xdiff, (unsigned long long)n);
+        char msg[1500];
+        snprintf(msg, sizeof msg, "cw census: %llu composites; commit+submit %.2f ms avg; wait %.2f ms avg (max %.2f ms); "
+              "scheduled %llu; surface-in %llu; uploads %llu; %s%s%s",
+              (unsigned long long)n, commit_avg, wait_avg,
+              (double)atomic_load(&nvmtl_cw_wait_max_us) / 1000.0,
+              (unsigned long long)atomic_load(&nvmtl_cw_sched),
+              (unsigned long long)atomic_load(&nvmtl_cw_surfin),
+              (unsigned long long)atomic_load(&nvmtl_cw_upload), extra, prof, xdiff);
+        nvlog("%s", msg);
+        {
+            // <wtl> opt5: the unified-log rate limiter (NVLOG_VERBATIM) was eating the census
+            // after 64 prints, so mirror every census line to a plain file the measurement
+            // scripts can read without going through logd.
+            const char *cp = getenv("XEMTL_CENSUS_FILE");
+            const char *path = (cp && *cp) ? cp : "/private/tmp/xemtl-census.log";
+            FILE *cf = fopen(path, "a");
+            if (cf) {
+                fprintf(cf, "%llu %s\n",
+                        (unsigned long long)(clock_gettime_nsec_np(CLOCK_REALTIME) / 1000000ull), msg);
+                fclose(cf);
+            }
+        }
+        atomic_store(&nvmtl_cw_count, 0); atomic_store(&nvmtl_cw_commit_us, 0);
+        atomic_store(&nvmtl_cw_wait_us, 0); atomic_store(&nvmtl_cw_sched, 0);
+        atomic_store(&nvmtl_cw_surfin, 0); atomic_store(&nvmtl_cw_upload, 0);
+    }
+}
