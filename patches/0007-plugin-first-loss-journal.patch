+// <wtl> opt4 XDIFF census: the NVIDIA/NVK vs Intel/ANV comparison deltas. Counters and accumulated time only,
+// published once per cw census (every ~60 composites) - no per-call logging, so benchmarks stay quiet.
+void nvmtl_vk_frame_counts(uint64_t out[4]);
+void nvmtl_vk_counts(uint64_t *bm, uint64_t *bg, uint64_t *im, uint64_t *ig, size_t *bytes);
+enum { XD_DRAW_US, XD_PIPE_REQ, XD_PIPE_HIT, XD_SAMP_REQ, XD_SAMP_HIT, XD_SURF_REQ, XD_SURF_HIT,
+       XD_SURF_IMPORT, XD_SURF_US, XD_SUBMIT, XD_SUBMIT_US, XD_N };
+static unsigned long long g_xd[XD_N];
+static unsigned long long g_xd_last[XD_N];
+static void nvmtl_xd_add(int k, unsigned long long n) {
+    if (k >= 0 && k < XD_N) __atomic_fetch_add(&g_xd[k], n, __ATOMIC_RELAXED);
+}
+static double nvmtl_xd_scale(void) {
+    static double s; if (!s) { mach_timebase_info_data_t tb; mach_timebase_info(&tb); s = (double)tb.numer / (double)tb.denom / 1000.0; }
+    return s;
+}
+static void nvmtl_xd_time(int k, uint64_t t0) {
+    nvmtl_xd_add(k, (unsigned long long)((double)(mach_absolute_time() - t0) * nvmtl_xd_scale()));
+}
+typedef struct { int k; uint64_t t0; } nvmtl_xd_state;
+static void nvmtl_xd_finish(nvmtl_xd_state *s) { if (s) nvmtl_xd_time(s->k, s->t0); }
+/* XDIFF scope timer: runs at every return of the enclosing function (clang cleanup attribute). */
+#define NVMTL_XD(k) nvmtl_xd_state _xds_ __attribute__((cleanup(nvmtl_xd_finish))) = { (int)(k), mach_absolute_time() }
+static void nvmtl_xd_text(char *out, size_t n, unsigned long long frames) {
+    unsigned long long d[XD_N];
+    for (int k = 0; k < XD_N; k++) {
+        const unsigned long long now = __atomic_load_n(&g_xd[k], __ATOMIC_RELAXED);
+        d[k] = now - g_xd_last[k]; g_xd_last[k] = now;
+    }
+    uint64_t fc[4] = {0,0,0,0}; nvmtl_vk_frame_counts(fc);
+    uint64_t bm=0,bg=0,im=0,ig=0; size_t bytes=0; nvmtl_vk_counts(&bm,&bg,&im,&ig,&bytes);
+    static uint64_t l_im, l_ig;
+    const uint64_t dim = im - l_im, dig = ig - l_ig; l_im = im; l_ig = ig;
+    static uint64_t l_draws; const uint64_t ddraw = fc[0] - l_draws; l_draws = fc[0];
+    const double f = frames ? (double)frames : 1.0;
+    const unsigned long long draw_us = d[XD_DRAW_US];
+    snprintf(out, n,
+        "; XDIFF frames %llu draws %llu pipe %llu/%llu samp %llu/%llu surf %llu/%llu/%llu img +%llu/-%llu submit %llu"
+        "; ms/frame draw %.2f surf %.2f submit %.2f; us/draw %.2f",
+        frames, ddraw, d[XD_PIPE_REQ], d[XD_PIPE_HIT], d[XD_SAMP_REQ], d[XD_SAMP_HIT],
+        d[XD_SURF_REQ], d[XD_SURF_HIT], d[XD_SURF_IMPORT], dim, dig, d[XD_SUBMIT],
+        (double)draw_us / f / 1000.0, (double)d[XD_SURF_US] / f / 1000.0, (double)d[XD_SUBMIT_US] / f / 1000.0,
+        ddraw ? (double)draw_us / (double)ddraw : 0.0);
+}
