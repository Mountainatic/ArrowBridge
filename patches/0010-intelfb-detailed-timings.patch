# 0010 XeGfxIntelFB: publish IOFBDetailedTimings and offer the 1280x800 HiDPI desktop mode
#
# Base:  NvGfx xe 5a19a73f36249efb99c44c3f9cb34603ef0c0eb8 (XeGfx 0.0.44)
# Requires: patches/0003-intelfb-panel-timing.patch
# Files: kexts/XeGfxIntelFB/intelfb.cpp (modified)
# Apply: patch -p1 < patches/0010-intelfb-detailed-timings.patch
#
# CoreDisplay rebuilds the CGDisplayMode refresh rate from the detailed timings a framebuffer publishes, and
# derives HiDPI scaled desktops from modes whose nominal size is a fraction of their detailed timing raster.
# The driver now publishes an OSArray of IODetailedTimingInformationV2 (IOFBDetailedTimings) built from the
# measured panel timing, and advertises one exact 2:1 desktop (1280x800 nominal on the 2560x1600 raster)
# whose backing is the same full frame the accelerator presents, so it needs no pipe scaler.  Modes are
# appended through the regular IOFramebuffer mode-list calls; selecting the scaled mode is a bookkeeping
# change only (-xeintelfbhidpi=0 / -xeintelfbdt=0 turn the two features off).
#
--- a/kexts/XeGfxIntelFB/intelfb.cpp
+++ b/kexts/XeGfxIntelFB/intelfb.cpp
@@ -6,6 +6,7 @@
 #include <IOKit/IODeviceTreeSupport.h>
